+static inline void transform_pos(const float in_pos[3], uint32_t mtx_id, float out_eye[3]) {
+    if (mtx_id >= 64) mtx_id = 0;
+    const float* m = s_pos_matrices[mtx_id];
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+    float32x4_t col0 = vld1q_f32(&m[0]);
+    float32x4_t col1 = vld1q_f32(&m[4]);
+    float32x4_t col2 = vld1q_f32(&m[8]);
+    float32x4_t col3 = vld1q_f32(&m[12]);
+
+    float32x4_t res = vmlaq_n_f32(col3, col0, in_pos[0]);
+    res = vmlaq_n_f32(res, col1, in_pos[1]);
+    res = vmlaq_n_f32(res, col2, in_pos[2]);
+
+    vst1_f32(out_eye, vget_low_f32(res));
+    out_eye[2] = vgetq_lane_f32(res, 2);
+#else
+    out_eye[0] = in_pos[0] * m[0] + in_pos[1] * m[4] + in_pos[2] * m[8]  + m[12];
+    out_eye[1] = in_pos[0] * m[1] + in_pos[1] * m[5] + in_pos[2] * m[9]  + m[13];
+    out_eye[2] = in_pos[0] * m[2] + in_pos[1] * m[6] + in_pos[2] * m[10] + m[14];
+#endif
+}
