+typedef struct ARQJob {
+    ARQRequest* request;
+    uintptr_t   owner;
+    u32         type;
+    u32         priority;
+    uintptr_t   source;
+    uintptr_t   dest;
+    u32         length;
+    ARQCallback callback;
+} ARQJob;
+
+#define MAX_ARQ_QUEUE 256
+static ARQJob s_arq_queue[MAX_ARQ_QUEUE];
+static int s_arq_head = 0;
+static int s_arq_tail = 0;
+static pthread_mutex_t s_arq_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  s_arq_cond  = PTHREAD_COND_INITIALIZER;
+static pthread_t       s_arq_thread;
+static volatile int    s_arq_running = 0;
+
+static void* arq_worker_thread(void* arg) {
+    (void)arg;
+    Port_PinThreadToCore(3);
+    while (s_arq_running) {
+        pthread_mutex_lock(&s_arq_mutex);
+        while (s_arq_head == s_arq_tail && s_arq_running) {
+            pthread_cond_wait(&s_arq_cond, &s_arq_mutex);
+        }
+        if (!s_arq_running) {
+            pthread_mutex_unlock(&s_arq_mutex);
+            break;
+        }
+        ARQJob job = s_arq_queue[s_arq_head];
+        s_arq_head = (s_arq_head + 1) % MAX_ARQ_QUEUE;
+        pthread_mutex_unlock(&s_arq_mutex);
+
+        if (job.length > 0) {
+            void* src = NULL;
+            void* dst = NULL;
+            if (job.type == 0) {
+                /* MRAM to ARAM */
+                src = (void*)job.source;
+                uint32_t aram_offset = (uint32_t)(job.dest & 0x00FFFFFF);
+                if (aram_offset + job.length <= sizeof(s_aram_buffer)) {
+                    dst = (void*)(s_aram_buffer + aram_offset);
+                }
+            } else {
+                /* ARAM to MRAM */
+                uint32_t aram_offset = (uint32_t)(job.source & 0x00FFFFFF);
+                if (aram_offset + job.length <= sizeof(s_aram_buffer)) {
+                    src = (void*)(s_aram_buffer + aram_offset);
+                }
+                dst = (void*)job.dest;
+            }
+            if (src && dst) {
+                memcpy(dst, src, job.length);
+            }
+        }
+
+        if (job.callback) {
+            job.callback(job.request);
+        }
+    }
+    return NULL;
+}
+
+void ARQInit(void) {
+    if (s_arq_running) return;
+    s_arq_running = 1;
+    pthread_create(&s_arq_thread, NULL, arq_worker_thread, NULL);
+}
+
+void ARQPostRequest(ARQRequest* request, uintptr_t owner, u32 type, u32 priority,
+                    uintptr_t source, uintptr_t dest, u32 length, ARQCallback callback) {
+    if (request) {
+        request->next = NULL;
+        request->owner = owner;
+        request->type = type;
+        request->priority = priority;
+        request->source = source;
+        request->dest = dest;
+        request->length = length;
+        request->callback = callback;
+    }
+
+    if (!s_arq_running) {
+        ARQInit();
+    }
+
+    pthread_mutex_lock(&s_arq_mutex);
+    int next_tail = (s_arq_tail + 1) % MAX_ARQ_QUEUE;
+    if (next_tail != s_arq_head) {
+        ARQJob* job = &s_arq_queue[s_arq_tail];
+        job->request = request;
+        job->owner = owner;
+        job->type = type;
+        job->priority = priority;
+        job->source = source;
+        job->dest = dest;
+        job->length = length;
+        job->callback = callback;
+        s_arq_tail = next_tail;
+        pthread_cond_signal(&s_arq_cond);
+        pthread_mutex_unlock(&s_arq_mutex);
+    } else {
+        pthread_mutex_unlock(&s_arq_mutex);
+        /* ARQ queue full: execute transfer and callback synchronously to prevent deadlock */
+        if (length > 0) {
+            void* src = NULL;
+            void* dst = NULL;
+            if (type == 0) {
+                src = (void*)source;
+                uint32_t aram_offset = (uint32_t)(dest & 0x00FFFFFF);
+                if (aram_offset + length <= sizeof(s_aram_buffer)) {
+                    dst = (void*)(s_aram_buffer + aram_offset);
+                }
+            } else {
+                uint32_t aram_offset = (uint32_t)(source & 0x00FFFFFF);
+                if (aram_offset + length <= sizeof(s_aram_buffer)) {
+                    src = (void*)(s_aram_buffer + aram_offset);
+                }
+                dst = (void*)dest;
+            }
+            if (src && dst) {
+                memcpy(dst, src, length);
+            }
+        }
+        if (callback) {
+            callback(request);
+        }
+    }
+}
