+void GXProject(float x, float y, float z, const float mtx[3][4], const float* pm, const float* vp, float* px, float* py, float* pz) {
+    float peye_x, peye_y, peye_z;
+    float xc, yc, zc, wc;
+
+    if (!pm || !vp) {
+        if (px) *px = x;
+        if (py) *py = y;
+        if (pz) *pz = z;
+        return;
+    }
+
+    peye_x = mtx[0][3] + (mtx[0][2] * z + (mtx[0][0] * x + mtx[0][1] * y));
+    peye_y = mtx[1][3] + (mtx[1][2] * z + (mtx[1][0] * x + mtx[1][1] * y));
+    peye_z = mtx[2][3] + (mtx[2][2] * z + (mtx[2][0] * x + mtx[2][1] * y));
+
+    if (pm[0] == 0.0f) {
+        /* Perspective projection */
+        xc = (peye_x * pm[1]) + (peye_z * pm[2]);
+        yc = (peye_y * pm[3]) + (peye_z * pm[4]);
+        zc = pm[6] + (peye_z * pm[5]);
+        wc = (peye_z != 0.0f) ? (1.0f / -peye_z) : 1.0f;
+    } else {
+        /* Orthographic projection */
+        xc = pm[2] + (peye_x * pm[1]);
+        yc = pm[4] + (peye_y * pm[3]);
+        zc = pm[6] + (peye_z * pm[5]);
+        wc = 1.0f;
+    }
+
+    if (px) *px = (vp[2] / 2.0f) + (vp[0] + (wc * (xc * vp[2] / 2.0f)));
+    if (py) *py = (vp[3] / 2.0f) + (vp[1] + (wc * (-yc * vp[3] / 2.0f)));
+    if (pz) *pz = vp[5] + (wc * (zc * (vp[5] - vp[4])));
+}
