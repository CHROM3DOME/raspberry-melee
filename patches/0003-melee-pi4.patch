+static inline int light_id_to_index(GXLightID light) {
+    if (light == GX_LIGHT_NULL) return -1;
+    switch (light) {
+        case GX_LIGHT0: return 0;
+        case GX_LIGHT1: return 1;
+        case GX_LIGHT2: return 2;
+        case GX_LIGHT3: return 3;
+        case GX_LIGHT4: return 4;
+        case GX_LIGHT5: return 5;
+        case GX_LIGHT6: return 6;
+        case GX_LIGHT7: return 7;
+        default: {
+            for (int i = 0; i < 8; i++) {
+                if ((int)light & (1 << i)) return i;
+            }
+            if ((int)light >= 0 && (int)light < 8) return (int)light;
+            return -1;
+        }
+    }
+}
