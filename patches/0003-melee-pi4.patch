+#ifndef PORT_RENDER_THREAD_H
+#define PORT_RENDER_THREAD_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <SDL2/SDL.h>
+#include <GLES2/gl2.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MAX_FRAME_PACKETS       16384
+#define FRAME_VERTEX_POOL_SIZE  (4 * 1024 * 1024) /* 4 MB immediate vertex pool */
+
+enum PacketType {
+    PKT_DRAW_IMM = 1,
+    PKT_DRAW_VBO,
+    PKT_TEX_UPLOAD,
+    PKT_SWAP,
+    PKT_SET_STATE,
+    PKT_TEX_RESET,
+    PKT_COPY_EFB
+};
+
+#define MAX_TEV_STAGES 4
+
+typedef struct {
+    float    mvp[16];          /* Pre-transposed column-major MVP matrix */
+    uint32_t mvp_id;           /* Monotonic matrix change identifier */
+    uint32_t state_id;         /* Monotonic state change identifier */
+    uint32_t tev_gen;          /* Monotonic TEV state change identifier */
+    GLuint   texture_id;
+    GLuint   texture1_id;
+    GLuint   tex_maps[8];                 /* GX_TEXMAP0..7 */
+    uint8_t  blend_enable;
+    uint8_t  blend_mode;                  /* GX_BM_NONE, GX_BM_BLEND, GX_BM_SUBTRACT */
+    uint8_t  blend_src;
+    uint8_t  blend_dst;
+    uint8_t  depth_test;
+    uint8_t  depth_func;
+    uint8_t  cull_face;
+    uint8_t  color_update;
+    uint8_t  alpha_update;
+    uint8_t  depth_update;
+    uint8_t  alpha_comp;
+    uint8_t  alpha_ref;
+    uint8_t  alpha_op;
+    uint8_t  alpha_comp1;
+    uint8_t  alpha_ref1;
+    uint8_t  num_tex_gens;
+    /* TEV state */
+    uint8_t  num_tev_stages;
+    uint8_t  tev_active;
+    uint8_t  tev_regs[4][4];              /* 0: PREV, 1: C0, 2: C1, 3: C2 (RGBA) */
+    uint8_t  kcolors[4][4];               /* KCOLOR0..3 (RGBA) */
+    uint8_t  tev_c_in[MAX_TEV_STAGES][4]; /* a, b, c, d (GXTevColorArg) */
+    uint8_t  tev_a_in[MAX_TEV_STAGES][4]; /* a, b, c, d (GXTevAlphaArg) */
+    uint8_t  tev_c_op[MAX_TEV_STAGES];    /* GXTevOp */
+    uint8_t  tev_a_op[MAX_TEV_STAGES];    /* GXTevOp */
+    uint8_t  tev_c_bias[MAX_TEV_STAGES];  /* GXTevBias */
+    uint8_t  tev_a_bias[MAX_TEV_STAGES];  /* GXTevBias */
+    uint8_t  tev_c_scale[MAX_TEV_STAGES]; /* GXTevScale */
+    uint8_t  tev_a_scale[MAX_TEV_STAGES]; /* GXTevScale */
+    uint8_t  tev_c_clamp[MAX_TEV_STAGES]; /* GXBool */
+    uint8_t  tev_a_clamp[MAX_TEV_STAGES]; /* GXBool */
+    uint8_t  tev_c_out[MAX_TEV_STAGES];   /* GXTevRegID */
+    uint8_t  tev_a_out[MAX_TEV_STAGES];   /* GXTevRegID */
+    uint8_t  tev_kcsel[MAX_TEV_STAGES];   /* GXTevKColorSel */
+    uint8_t  tev_kasel[MAX_TEV_STAGES];   /* GXTevKAlphaSel */
+    uint8_t  tev_tex_map[MAX_TEV_STAGES]; /* GXTexMapID (0..7, or 0xFF) */
+    uint8_t  tev_ras_swap[MAX_TEV_STAGES];
+    uint8_t  tev_tex_swap[MAX_TEV_STAGES];
+    int16_t  scissor_box[4];   /* x, y, w, h in display pixels (320x240) */
+    int16_t  viewport_box[4];  /* x, y, w, h in display pixels (320x240) */
+} RenderDrawState;
+
+typedef struct {
+    GLuint program;        /* Alpha-test / fallback program */
+    GLuint program_fast;   /* Fast opaque program (no discard, early-Z active) */
+    GLint  u_mvp;
+    GLint  u_modelview;
+    GLint  u_tex;
+    GLint  u_tex_en;
+    GLint  u_tex1;
+    GLint  u_tex1_en;
+    GLint  u_alpha_ref;
+    GLint  u_alpha_comp;
+    GLint  u_alpha_op;
+    GLint  u_alpha_comp1;
+    GLint  u_alpha_ref1;
+    GLint  u_light_en;
+    GLint  u_tev_mod;
+    GLint  u_tev_mod2;
+    GLint  u_tev_lerp_mode;
+    /* Fast program uniform locations */
+    GLint  u_fast_mvp;
+    GLint  u_fast_tex;
+    GLint  u_fast_tex_en;
+    GLint  u_fast_tex1;
+    GLint  u_fast_tex1_en;
+    GLint  u_fast_tev_mod;
+    GLint  u_fast_tev_mod2;
+    GLint  u_fast_tev_lerp_mode;
+} RenderShaderHandles;
+
+void    Port_GetTevKonstColor(uint8_t kcsel, const RenderDrawState* state, uint8_t* kr, uint8_t* kg, uint8_t* kb);
+uint8_t Port_GetTevKonstAlpha(uint8_t kasel, const RenderDrawState* state);
+
+typedef struct {
+    uint16_t cache_id;
+    uint16_t w;
+    uint16_t h;
+    uint8_t  wrap_s;
+    uint8_t  wrap_t;
+    uint32_t* rgba;
+} TexUploadData;
+
+typedef struct {
+    uint16_t cache_id;
+    uint16_t gl_x;
+    uint16_t gl_y;
+    uint16_t gl_w;
+    uint16_t gl_h;
+    uint8_t  clear;
+} CopyEfbData;
+
+typedef struct {
+    uint16_t type;          /* enum PacketType */
+    uint16_t count;         /* Vertex count */
+    uint32_t gl_primitive;  /* GL_TRIANGLES, GL_TRIANGLE_STRIP, etc. */
+    uint32_t vbo;           /* VBO handle */
+    uint32_t vtx_offset;    /* Byte offset into vertex pool */
+    union {
+        TexUploadData tex_upload;
+        CopyEfbData   copy_efb;
+    };
+    float    tev_mod[4];    /* Precomputed TEV modifier: (kcol.rgb * c0.rgb, 1.0) */
+    float    tev_mod2[4];   /* Precomputed secondary TEV modifier for dual-color lerp */
+    uint8_t  tev_lerp_mode; /* 1 = dual-color lerp: mix(tev_mod, tev_mod2, tex.r), 0 = normal */
+    RenderDrawState state;
+} RenderPacket;
+
+typedef struct {
+    RenderPacket packets[MAX_FRAME_PACKETS];
+    int          packet_count;
+    uint8_t      vertex_pool[FRAME_VERTEX_POOL_SIZE];
+    int          vertex_bytes;
+    volatile int ready;
+    float        c1_render_ms;
+    float        c1_swap_ms;
+} FrameCmdBuffer;
+
+/* Core Pipeline Functions */
+bool Port_RenderThread_Init(SDL_Window* window, SDL_GLContext gl_context, int width, int height, const RenderShaderHandles* shaders);
+bool Port_RenderThread_IsEnabled(void);
+void* Port_RenderThread_GetVertexWritePtr(int max_verts, uint32_t* out_offset);
+bool Port_RenderThread_CommitDirectDraw(int vtx_count, uint32_t gl_prim, const RenderDrawState* state);
+bool Port_RenderThread_PushDrawImm(const void* vtx_data, int vtx_bytes, int vtx_count,
+                                   uint32_t gl_prim, const RenderDrawState* state);
+void Port_RenderThread_PushTexUpload(uint16_t cache_id, uint32_t* rgba, uint16_t w, uint16_t h, uint8_t wrap_s, uint8_t wrap_t);
+void Port_RenderThread_PushTexReset(void);
+void Port_RenderThread_PushCopyEFB(uint16_t cache_id, uint16_t gl_x, uint16_t gl_y, uint16_t gl_w, uint16_t gl_h, uint8_t clear);
+void Port_RenderThread_SwapBuffers(int frame_num);
+void Port_RenderThread_GetMetrics(float* out_c1_render_ms, float* out_c1_swap_ms, float* out_c0_wait_ms);
+void Port_RenderThread_Shutdown(void);
+void Port_PinThreadToCore(int core_id);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PORT_RENDER_THREAD_H */
diff --git a/include/port/port_shaders.h b/include/port/port_shaders.h
new file mode 100755
index 0000000..cd7a299
--- /dev/null
+++ b/include/port/port_shaders.h
@@ -0,0 +1,207 @@
+#ifndef PORT_SHADERS_H
+#define PORT_SHADERS_H
+
+/* VideoCore IV Optimized Vertex Shader (2 lights, zero transcendent math) */
+static const char* k_default_vert_src =
+    "attribute vec3 a_position;\n"
+    "attribute vec4 a_color;\n"
+    "attribute vec2 a_texcoord;\n"
+    "\n"
+    "uniform mat4 u_mvp;\n"
+    "\n"
+    "varying vec4 v_color;\n"
+    "varying vec2 v_texcoord;\n"
+    "\n"
+    "void main() {\n"
+    "    gl_Position = u_mvp * vec4(a_position, 1.0);\n"
+    "    v_texcoord = a_texcoord;\n"
+    "    v_color = a_color;\n"
+    "}\n";
+
+/* VideoCore IV Fast Opaque Fragment Shader (NO discard, full Early-Z active) */
+static const char* k_fast_frag_src =
+    "precision mediump float;\n"
+    "\n"
+    "varying vec4 v_color;\n"
+    "varying vec2 v_texcoord;\n"
+    "\n"
+    "uniform sampler2D u_texture;\n"
+    "uniform int       u_texture_enabled;\n"
+    "uniform sampler2D u_texture1;\n"
+    "uniform int       u_texture1_enabled;\n"
+    "uniform vec4      u_tev_mod;\n"
+    "uniform vec4      u_tev_mod2;\n"
+    "uniform int       u_tev_lerp_mode;\n"
+    "\n"
+    "void main() {\n"
+    "    vec4 color = v_color;\n"
+    "    if (u_texture1_enabled == 0 && u_texture_enabled != 0 && u_tev_lerp_mode == 0) {\n"
+    "        vec4 tex = texture2D(u_texture, v_texcoord);\n"
+    "        color.rgb *= (tex.rgb * u_tev_mod.rgb);\n"
+    "        color.a *= (u_tev_mod2.a + tex.a * u_tev_mod.a * (1.0 - u_tev_mod2.a));\n"
+    "    } else if (u_texture_enabled != 0 && u_texture1_enabled != 0) {\n"
+    "        vec4 tex0 = texture2D(u_texture, v_texcoord);\n"
+    "        vec4 tex1 = texture2D(u_texture1, v_texcoord);\n"
+    "        if (u_tev_lerp_mode == 4) {\n"
+    "            color.rgb *= (tex0.rgb * tex1.rgb * u_tev_mod.rgb);\n"
+    "            color.a *= (tex0.a * tex1.a);\n"
+    "        } else {\n"
+    "            color.rgb = (color.rgb * tex0.rgb * u_tev_mod.rgb) + (color.rgb * tex1.rgb * u_tev_mod2.rgb);\n"
+    "            color.a *= min(tex0.a, tex1.a);\n"
+    "        }\n"
+    "    } else if (u_texture_enabled != 0) {\n"
+    "        vec4 tex = texture2D(u_texture, v_texcoord);\n"
+    "        if (u_tev_lerp_mode == 1) {\n"
+    "            float f = clamp(0.5 + (tex.r - 0.6) * 2.2, 0.0, 1.0);\n"
+    "            color.rgb *= mix(u_tev_mod.rgb, u_tev_mod2.rgb, f);\n"
+    "            color.a *= tex.a;\n"
+    "        } else if (u_tev_lerp_mode == 2) {\n"
+    "            color.rgb = mix(color.rgb, tex.rgb, u_tev_mod.rgb);\n"
+    "            color.a *= tex.a;\n"
+    "        } else if (u_tev_lerp_mode == 3) {\n"
+    "            color.rgb = color.rgb * (1.0 - tex.rgb) + tex.rgb * tex.rgb;\n"
+    "            color.a *= tex.a;\n"
+    "        } else {\n"
+    "            color.rgb *= (tex.rgb * u_tev_mod.rgb);\n"
+    "            color.a *= (u_tev_mod2.a + tex.a * (1.0 - u_tev_mod2.a));\n"
+    "        }\n"
+    "    } else if (u_texture1_enabled != 0) {\n"
+    "        vec4 tex1 = texture2D(u_texture1, v_texcoord);\n"
+    "        if (u_tev_lerp_mode == 1) {\n"
+    "            float f = clamp(0.5 + (tex1.r - 0.6) * 2.2, 0.0, 1.0);\n"
+    "            color.rgb *= mix(u_tev_mod.rgb, u_tev_mod2.rgb, f);\n"
+    "            color.a *= tex1.a;\n"
+    "        } else if (u_tev_lerp_mode == 2) {\n"
+    "            color.rgb = mix(color.rgb, tex1.rgb, u_tev_mod.rgb);\n"
+    "            color.a *= tex1.a;\n"
+    "        } else if (u_tev_lerp_mode == 3) {\n"
+    "            color.rgb = color.rgb * (1.0 - tex1.rgb) + tex1.rgb * tex1.rgb;\n"
+    "            color.a *= tex1.a;\n"
+    "        } else {\n"
+    "            color.rgb *= (tex1.rgb * u_tev_mod.rgb);\n"
+    "            color.a *= (u_tev_mod2.a + tex1.a * (1.0 - u_tev_mod2.a));\n"
+    "        }\n"
+    "    } else {\n"
+    "        color.rgb *= u_tev_mod.rgb;\n"
+    "    }\n"
+    "    gl_FragColor = color;\n"
+    "}\n";
+
+/* VideoCore IV Alpha-Test Fragment Shader (Alpha comparison with discard) */
+static const char* k_default_frag_src =
+    "precision mediump float;\n"
+    "\n"
+    "varying vec4 v_color;\n"
+    "varying vec2 v_texcoord;\n"
+    "\n"
+    "uniform sampler2D u_texture;\n"
+    "uniform int       u_texture_enabled;\n"
+    "uniform sampler2D u_texture1;\n"
+    "uniform int       u_texture1_enabled;\n"
+    "uniform vec4      u_tev_mod;\n"
+    "uniform vec4      u_tev_mod2;\n"
+    "uniform int       u_tev_lerp_mode;\n"
+    "uniform float     u_alpha_ref;\n"
+    "uniform int       u_alpha_comp;\n"
+    "uniform float     u_alpha_ref1;\n"
+    "uniform int       u_alpha_comp1;\n"
+    "uniform int       u_alpha_op;\n"
+    "\n"
+    "void main() {\n"
+    "    vec4 color = v_color;\n"
+    "    if (u_texture1_enabled == 0 && u_texture_enabled != 0 && u_tev_lerp_mode == 0) {\n"
+    "        vec4 tex = texture2D(u_texture, v_texcoord);\n"
+    "        color.rgb *= (tex.rgb * u_tev_mod.rgb);\n"
+    "        color.a *= (u_tev_mod2.a + tex.a * u_tev_mod.a * (1.0 - u_tev_mod2.a));\n"
+    "    } else if (u_texture_enabled != 0 && u_texture1_enabled != 0) {\n"
+    "        vec4 tex0 = texture2D(u_texture, v_texcoord);\n"
+    "        vec4 tex1 = texture2D(u_texture1, v_texcoord);\n"
+    "        if (u_tev_lerp_mode == 4) {\n"
+    "            color.rgb *= (tex0.rgb * tex1.rgb * u_tev_mod.rgb);\n"
+    "            color.a *= (tex0.a * tex1.a);\n"
+    "        } else {\n"
+    "            color.rgb = (color.rgb * tex0.rgb * u_tev_mod.rgb) + (color.rgb * tex1.rgb * u_tev_mod2.rgb);\n"
+    "            color.a *= min(tex0.a, tex1.a);\n"
+    "        }\n"
+    "    } else if (u_texture_enabled != 0) {\n"
+    "        vec4 tex = texture2D(u_texture, v_texcoord);\n"
+    "        if (u_tev_lerp_mode == 1) {\n"
+    "            float f = clamp(0.5 + (tex.r - 0.6) * 2.2, 0.0, 1.0);\n"
+    "            color.rgb *= mix(u_tev_mod.rgb, u_tev_mod2.rgb, f);\n"
+    "            color.a *= tex.a;\n"
+    "        } else if (u_tev_lerp_mode == 2) {\n"
+    "            color.rgb = mix(color.rgb, tex.rgb, u_tev_mod.rgb);\n"
+    "            color.a *= tex.a;\n"
+    "        } else if (u_tev_lerp_mode == 3) {\n"
+    "            color.rgb = color.rgb * (1.0 - tex.rgb) + tex.rgb * tex.rgb;\n"
+    "            color.a *= tex.a;\n"
+    "        } else {\n"
+    "            color.rgb *= (tex.rgb * u_tev_mod.rgb);\n"
+    "            color.a *= (u_tev_mod2.a + tex.a * (1.0 - u_tev_mod2.a));\n"
+    "        }\n"
+    "    } else if (u_texture1_enabled != 0) {\n"
+    "        vec4 tex1 = texture2D(u_texture1, v_texcoord);\n"
+    "        if (u_tev_lerp_mode == 1) {\n"
+    "            float f = clamp(0.5 + (tex1.r - 0.6) * 2.2, 0.0, 1.0);\n"
+    "            color.rgb *= mix(u_tev_mod.rgb, u_tev_mod2.rgb, f);\n"
+    "            color.a *= tex1.a;\n"
+    "        } else if (u_tev_lerp_mode == 2) {\n"
+    "            color.rgb = mix(color.rgb, tex1.rgb, u_tev_mod.rgb);\n"
+    "            color.a *= tex1.a;\n"
+    "        } else if (u_tev_lerp_mode == 3) {\n"
+    "            color.rgb = color.rgb * (1.0 - tex1.rgb) + tex1.rgb * tex1.rgb;\n"
+    "            color.a *= tex1.a;\n"
+    "        } else {\n"
+    "            color.rgb *= (tex1.rgb * u_tev_mod.rgb);\n"
+    "            color.a *= (u_tev_mod2.a + tex1.a * (1.0 - u_tev_mod2.a));\n"
+    "        }\n"
+    "    } else {\n"
+    "        color.rgb *= u_tev_mod.rgb;\n"
+    "    }\n"
+    "    // Dual Alpha Compare: GX_NEVER=0, GX_LESS=1, GX_EQUAL=2, GX_LEQUAL=3, GX_GREATER=4, GX_NEQUAL=5, GX_GEQUAL=6, GX_ALWAYS=7\n"
+    "    bool p0 = true;\n"
+    "    if (u_alpha_comp == 0) {\n"
+    "        p0 = false;\n"
+    "    } else if (u_alpha_comp == 1) {\n"
+    "        p0 = (color.a < u_alpha_ref);\n"
+    "    } else if (u_alpha_comp == 2) {\n"
+    "        p0 = (abs(color.a - u_alpha_ref) <= 0.01);\n"
+    "    } else if (u_alpha_comp == 3) {\n"
+    "        p0 = (color.a <= u_alpha_ref);\n"
+    "    } else if (u_alpha_comp == 4) {\n"
+    "        p0 = (color.a > u_alpha_ref);\n"
+    "    } else if (u_alpha_comp == 5) {\n"
+    "        p0 = (abs(color.a - u_alpha_ref) > 0.01);\n"
+    "    } else if (u_alpha_comp == 6) {\n"
+    "        p0 = (color.a >= u_alpha_ref);\n"
+    "    }\n"
+    "\n"
+    "    bool p1 = true;\n"
+    "    if (u_alpha_comp1 == 0) {\n"
+    "        p1 = false;\n"
+    "    } else if (u_alpha_comp1 == 1) {\n"
+    "        p1 = (color.a < u_alpha_ref1);\n"
+    "    } else if (u_alpha_comp1 == 2) {\n"
+    "        p1 = (abs(color.a - u_alpha_ref1) <= 0.01);\n"
+    "    } else if (u_alpha_comp1 == 3) {\n"
+    "        p1 = (color.a <= u_alpha_ref1);\n"
+    "    } else if (u_alpha_comp1 == 4) {\n"
+    "        p1 = (color.a > u_alpha_ref1);\n"
+    "    } else if (u_alpha_comp1 == 5) {\n"
+    "        p1 = (abs(color.a - u_alpha_ref1) > 0.01);\n"
+    "    } else if (u_alpha_comp1 == 6) {\n"
+    "        p1 = (color.a >= u_alpha_ref1);\n"
+    "    }\n"
+    "\n"
+    "    // GX_AOP_AND=0, GX_AOP_OR=1, GX_AOP_XOR=2, GX_AOP_XNOR=3\n"
+    "    bool pass = true;\n"
+    "    if (u_alpha_op == 0) pass = (p0 && p1);\n"
+    "    else if (u_alpha_op == 1) pass = (p0 || p1);\n"
+    "    else if (u_alpha_op == 2) pass = (p0 != p1);\n"
+    "    else if (u_alpha_op == 3) pass = (p0 == p1);\n"
+    "\n"
+    "    if (!pass) discard;\n"
+    "    gl_FragColor = color;\n"
+    "}\n";
+
+#endif /* PORT_SHADERS_H */
