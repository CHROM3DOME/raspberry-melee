+void GXColor4u8(uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
+    if (!port_gx_tev_uses_ras()) {
+        return;
+    }
+    s_current_vtx.col[0] = r;
+    s_current_vtx.col[1] = g;
+    s_current_vtx.col[2] = b;
+    s_current_vtx.col[3] = a;
+    if (s_vert_count > 0) {
+        s_vert_buffer[s_vert_count - 1].col[0] = r;
+        s_vert_buffer[s_vert_count - 1].col[1] = g;
+        s_vert_buffer[s_vert_count - 1].col[2] = b;
+        s_vert_buffer[s_vert_count - 1].col[3] = a;
+    }
+}
+
+static inline void port_gx_transform_texcoord(int coord_id, uint32_t override_mtx, float in_s, float in_t, float* out_s, float* out_t) {
+    uint32_t mid = (override_mtx < 128 && override_mtx != GX_IDENTITY) ? override_mtx :
+                   ((coord_id >= 0 && coord_id < 8) ? s_tex_coord_mtx[coord_id] : GX_IDENTITY);
+    uint32_t pmid = (coord_id >= 0 && coord_id < 8) ? s_tex_coord_postmtx[coord_id] : GX_IDENTITY;
+    bool mid_is_id = port_gx_is_texmtx_identity(mid);
+    bool pmid_is_id = port_gx_is_texmtx_identity(pmid);
+    if (__builtin_expect((mid_is_id && pmid_is_id), 1)) {
+        *out_s = in_s;
+        *out_t = in_t;
+        return;
+    }
+    float s = in_s;
+    float t = in_t;
+    if (!mid_is_id && mid < 128) {
+        float s_next = s_tex_matrices[mid][0][0] * s + s_tex_matrices[mid][0][1] * t + s_tex_matrices[mid][0][3];
+        float t_next = s_tex_matrices[mid][1][0] * s + s_tex_matrices[mid][1][1] * t + s_tex_matrices[mid][1][3];
+        s = s_next;
+        t = t_next;
+    }
+    if (!pmid_is_id && pmid < 128) {
+        float s_next = s_tex_matrices[pmid][0][0] * s + s_tex_matrices[pmid][0][1] * t + s_tex_matrices[pmid][0][3];
+        float t_next = s_tex_matrices[pmid][1][0] * s + s_tex_matrices[pmid][1][1] * t + s_tex_matrices[pmid][1][3];
+        s = s_next;
+        t = t_next;
+    }
+    *out_s = s;
+    *out_t = t;
+}
+
+static inline void port_gx_generate_texcoord(int coord_id, const float pos[3], const float raw_nrm[3], bool has_nrm, uint32_t vtx_mtx, float* out_s, float* out_t) {
+    if (coord_id < 0 || coord_id >= 8) return;
+    uint8_t src = s_tex_coord_src[coord_id];
+    float in_x = 0.0f, in_y = 0.0f, in_z = 0.0f;
+    if (src == 1) { /* GX_TG_NRM */
+        if (!has_nrm) return;
+        uint32_t mid = vtx_mtx < 64 ? vtx_mtx : 0;
+        if (s_nrm_matrix_valid[mid]) {
+            in_x = s_nrm_matrices[mid][0][0] * raw_nrm[0] + s_nrm_matrices[mid][0][1] * raw_nrm[1] + s_nrm_matrices[mid][0][2] * raw_nrm[2];
+            in_y = s_nrm_matrices[mid][1][0] * raw_nrm[0] + s_nrm_matrices[mid][1][1] * raw_nrm[1] + s_nrm_matrices[mid][1][2] * raw_nrm[2];
+            in_z = s_nrm_matrices[mid][2][0] * raw_nrm[0] + s_nrm_matrices[mid][2][1] * raw_nrm[1] + s_nrm_matrices[mid][2][2] * raw_nrm[2];
+        } else {
+            in_x = raw_nrm[0]; in_y = raw_nrm[1]; in_z = raw_nrm[2];
+        }
+        if (s_tex_coord_norm[coord_id]) {
+            float len_sq = in_x * in_x + in_y * in_y + in_z * in_z;
+            if (len_sq > 0.00001f) {
+                float inv = 1.0f / sqrtf(len_sq);
+                in_x *= inv; in_y *= inv; in_z *= inv;
+            }
+        }
+    } else if (src == 0) { /* GX_TG_POS */
+        in_x = pos[0]; in_y = pos[1]; in_z = pos[2];
+    } else {
+        return;
+    }
+
+    uint32_t mid = s_tex_coord_mtx[coord_id];
+    float s = in_x, t = in_y;
+    if (mid < 128 && mid != GX_IDENTITY) {
+        s = s_tex_matrices[mid][0][0] * in_x + s_tex_matrices[mid][0][1] * in_y + s_tex_matrices[mid][0][2] * in_z + s_tex_matrices[mid][0][3];
+        t = s_tex_matrices[mid][1][0] * in_x + s_tex_matrices[mid][1][1] * in_y + s_tex_matrices[mid][1][2] * in_z + s_tex_matrices[mid][1][3];
+        if (s_tex_coord_func[coord_id] == 1) { /* GX_TG_MTX3x4 */
+            float q = s_tex_matrices[mid][2][0] * in_x + s_tex_matrices[mid][2][1] * in_y + s_tex_matrices[mid][2][2] * in_z + s_tex_matrices[mid][2][3];
+            if (fabsf(q) > 0.00001f) {
+                s /= q;
+                t /= q;
+            }
+        }
+    }
+    uint32_t pmid = s_tex_coord_postmtx[coord_id];
+    if (pmid < 128 && pmid != GX_PTIDENTITY && pmid != GX_IDENTITY) {
+        float s_next = s_tex_matrices[pmid][0][0] * s + s_tex_matrices[pmid][0][1] * t + s_tex_matrices[pmid][0][3];
+        float t_next = s_tex_matrices[pmid][1][0] * s + s_tex_matrices[pmid][1][1] * t + s_tex_matrices[pmid][1][3];
+        s = s_next;
+        t = t_next;
+    }
+    *out_s = s;
+    *out_t = t;
+}
+
+void GXTexCoord2f32(float s, float t) {
+    port_gx_transform_texcoord(s_active_tex_coord, GX_IDENTITY, s, t, &s, &t);
+    s_current_vtx.tex[0] = s;
+    s_current_vtx.tex[1] = t;
+    if (s_vert_count > 0) {
+        s_vert_buffer[s_vert_count - 1].tex[0] = s;
+        s_vert_buffer[s_vert_count - 1].tex[1] = t;
+    }
+}
+
+static void port_gx_resolve_draw_textures(RenderDrawState* state) {
+    uint32_t active_tex0 = 0;
+    uint32_t active_tex1 = 0;
+
+    int max_stages = state->num_tev_stages;
+    if (max_stages < 1) max_stages = 1;
+    if (max_stages > MAX_TEV_STAGES) max_stages = MAX_TEV_STAGES;
+
+    int found = 0;
+    for (int s = 0; s < max_stages; s++) {
+        uint8_t m = state->tev_tex_map[s];
+        if (m != GX_TEXMAP_NULL && m < 8 && state->tex_maps[m]) {
+            if (found == 0) {
+                active_tex0 = state->tex_maps[m];
+                found++;
+            } else if (found == 1) {
+                if (state->tex_maps[m] != active_tex0) {
+                    active_tex1 = state->tex_maps[m];
+                    found++;
+                    break;
+                }
+            }
+        }
+    }
+
+    if (found == 0) {
+        active_tex0 = state->texture_id;
+    }
+
+    state->texture_id = active_tex0;
+    state->texture1_id = active_tex1;
+}
+
+static inline bool port_gx_tex_is_efb(uint32_t tid) {
+    if (tid == 0) return false;
+    if (Port_RenderThread_IsEnabled() || s_is_software_renderer) {
+        if (tid <= (uint32_t)s_num_cached_tex) {
+            return s_tex_cache[tid - 1].is_efb_copy != 0;
+        }
+    } else {
+        for (int i = 0; i < s_num_cached_tex; i++) {
+            if (s_tex_cache[i].gl_id == tid && s_tex_cache[i].is_efb_copy) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+void GXEnd(void) {
+    s_in_begin = false;
+    if (s_vert_count == 0) return;
+
+    if (s_is_software_renderer) {
+        soft_rasterize_batch(s_vert_buffer, s_vert_count, s_current_prim, &s_current_state);
+        s_vert_count = 0;
+        return;
+    }
+
+    /* Convert quads (0,1,2,3), strips, and fans to triangles for batch coalescing */
+    static GXVertex s_unpacked_tri_buffer[16384];
+    GXVertex* final_verts = s_vert_buffer;
+    int final_count = s_vert_count;
+    GLenum gl_prim = GL_TRIANGLES;
+
+    if (s_current_prim == GX_QUADS) {
+        int tri_count = 0;
+        for (int i = 0; i + 3 < s_vert_count && tri_count + 6 <= 16384; i += 4) {
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 0];
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 1];
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 2];
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 0];
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 2];
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 3];
+        }
+        final_verts = s_unpacked_tri_buffer;
+        final_count = tri_count;
+        gl_prim = GL_TRIANGLES;
+    } else if (s_current_prim == GX_TRIANGLES) {
+        gl_prim = GL_TRIANGLES;
+        final_verts = s_vert_buffer;
+        final_count = s_vert_count;
+    } else if (s_current_prim == GX_TRIANGLESTRIP) {
+        int tri_count = 0;
+        for (int i = 0; i + 2 < s_vert_count && tri_count + 3 <= 16384; i++) {
+            if ((i & 1) == 0) {
+                s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 0];
+                s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 1];
+                s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 2];
+            } else {
+                s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 1];
+                s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 0];
+                s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 2];
+            }
+        }
+        final_verts = s_unpacked_tri_buffer;
+        final_count = tri_count;
+        gl_prim = GL_TRIANGLES;
+    } else if (s_current_prim == GX_TRIANGLEFAN) {
+        int tri_count = 0;
+        for (int i = 1; i + 1 < s_vert_count && tri_count + 3 <= 16384; i++) {
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[0];
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i];
+            s_unpacked_tri_buffer[tri_count++] = s_vert_buffer[i + 1];
+        }
+        final_verts = s_unpacked_tri_buffer;
+        final_count = tri_count;
+        gl_prim = GL_TRIANGLES;
+    } else {
+        switch (s_current_prim) {
+            case GX_POINTS:        gl_prim = GL_POINTS; break;
+            case GX_LINES:         gl_prim = GL_LINES; break;
+            case GX_LINESTRIP:     gl_prim = GL_LINE_STRIP; break;
+            default:               gl_prim = GL_TRIANGLES; break;
+        }
+    }
+
+    if (final_count == 0) {
+        s_vert_count = 0;
+        return;
+    }
+
+    static int s_enable_cull = -1;
+    if (s_enable_cull < 0) {
+        const char* e = getenv("MELEE_FRUSTUM_CULL");
+        s_enable_cull = e ? atoi(e) : 0; /* Default to 0 (delegate to VideoCore VI hardware binning unit) */
+        if (s_enable_cull) {
+            fprintf(stderr, "[Melee-GX] Software frustum culling enabled (5%% guard-band Cohen-Sutherland).\n");
+        }
+    }
+
+    /* Only apply frustum culling to 3D perspective projections; exempt 2D orthographic UI/menus */
+    bool is_perspective = (s_proj[11] != 0.0f || s_proj[3] != 0.0f || s_proj[7] != 0.0f || s_proj[15] != 1.0f);
+    if (s_enable_cull && is_perspective && final_count > 0) {
+        uint8_t out_all = 0x3F;
+        for (int i = 0; i < final_count; i++) {
+            float x = final_verts[i].pos[0];
+            float y = final_verts[i].pos[1];
+            float z = final_verts[i].pos[2];
+            float wc = s_proj[3] * x + s_proj[7] * y + s_proj[11] * z + s_proj[15];
+            uint8_t mask = 0;
+            if (wc <= 0.001f) {
+                mask = 0x20;
+            } else {
+                float xc = s_proj[0] * x + s_proj[4] * y + s_proj[8] * z + s_proj[12];
+                float yc = s_proj[1] * x + s_proj[5] * y + s_proj[9] * z + s_proj[13];
+                float zc = s_proj[2] * x + s_proj[6] * y + s_proj[10] * z + s_proj[14];
+                float limit = wc * 1.05f;
+                if (xc >  limit) mask |= 0x01;
+                if (xc < -limit) mask |= 0x02;
+                if (yc >  limit) mask |= 0x04;
+                if (yc < -limit) mask |= 0x08;
+                if (zc >  limit) mask |= 0x10;
+            }
+            out_all &= mask;
+            if (!out_all) break;
+        }
+        if (out_all != 0) {
+            s_vert_count = 0;
+            return;
+        }
+    }
+
+    port_gx_resolve_draw_textures(&s_current_state);
+
+    if (port_gx_tex_is_efb(s_current_state.texture_id) || port_gx_tex_is_efb(s_current_state.texture1_id)) {
+        static int s_efb_draw_log = 0;
+        if (s_efb_draw_log++ < 20) {
+            fprintf(stderr, "[Melee-GX] Inverting V for EFB copy draw #%d (tid=%u,%u, vtx_cnt=%d)\n",
+                    s_efb_draw_log, s_current_state.texture_id, s_current_state.texture1_id, final_count);
+            fflush(stderr);
+        }
+        for (int i = 0; i < final_count; i++) {
+            final_verts[i].tex[1] = 1.0f - final_verts[i].tex[1];
+        }
+    }
+
+    if (Port_RenderThread_IsEnabled()) {
+        s_current_state.mvp_id = s_proj_mvp_id;
+        memcpy(s_current_state.mvp, s_proj, sizeof(s_proj));
+        bool coalesced = Port_RenderThread_PushDrawImm(final_verts, final_count * sizeof(GXVertex),
+                                                       final_count, gl_prim, &s_current_state);
+        if (!coalesced) {
+            s_metric_draw_calls++;
+        }
+        s_metric_verts += final_count;
+        s_metric_tris += (gl_prim == GL_TRIANGLES ? final_count / 3 : (final_count > 2 ? final_count - 2 : 0));
+        s_vert_count = 0;
+        return;
+    } else if (s_gl_context) {
+        glUseProgram(s_program);
+        if (u_mvp_loc >= 0) {
+            glUniformMatrix4fv(u_mvp_loc, 1, GL_FALSE, s_proj);
+        }
+        if (s_current_state.texture_id) {
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, s_current_state.texture_id);
+            if (u_tex_en_loc >= 0) glUniform1i(u_tex_en_loc, 1);
+        } else {
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, 0);
+            if (u_tex_en_loc >= 0) glUniform1i(u_tex_en_loc, 0);
+        }
+
+        if (s_current_state.texture1_id) {
+            glActiveTexture(GL_TEXTURE1);
+            glBindTexture(GL_TEXTURE_2D, s_current_state.texture1_id);
+            if (u_tex1_en_loc >= 0) glUniform1i(u_tex1_en_loc, 1);
+        } else {
+            glActiveTexture(GL_TEXTURE1);
+            glBindTexture(GL_TEXTURE_2D, 0);
+            if (u_tex1_en_loc >= 0) glUniform1i(u_tex1_en_loc, 0);
+        }
+
+        glColorMask(s_current_state.color_update ? GL_TRUE : GL_FALSE,
+                    s_current_state.color_update ? GL_TRUE : GL_FALSE,
+                    s_current_state.color_update ? GL_TRUE : GL_FALSE,
+                    s_current_state.alpha_update ? GL_TRUE : GL_FALSE);
+
+        if (s_current_state.blend_enable) {
+            glEnable(GL_BLEND);
+            if (s_current_state.blend_mode == 3) { /* GX_BM_SUBTRACT */
+                glBlendEquation(GL_FUNC_REVERSE_SUBTRACT);
+                glBlendFunc(GL_ONE, GL_ONE);
+            } else {
+                glBlendEquation(GL_FUNC_ADD);
+                GLenum src = gx_to_gl_blend_factor(s_current_state.blend_src, true);
+                GLenum dst = gx_to_gl_blend_factor(s_current_state.blend_dst, false);
+                glBlendFunc(src, dst);
+            }
+        } else {
+            glDisable(GL_BLEND);
+        }
+
+        if (s_current_state.depth_test) {
+            glEnable(GL_DEPTH_TEST);
+            glDepthFunc(gx_to_gl_compare(s_current_state.depth_func));
+        } else if (s_current_state.depth_update) {
+            /* Emulate unconditional GX depth write */
+            glEnable(GL_DEPTH_TEST);
+            glDepthFunc(GL_ALWAYS);
+        } else {
+            glDisable(GL_DEPTH_TEST);
+        }
+        glDepthMask(s_current_state.depth_update ? GL_TRUE : GL_FALSE);
+
+        if (u_alpha_ref_loc >= 0) {
+            glUniform1f(u_alpha_ref_loc, (float)s_current_state.alpha_ref / 255.0f);
+        }
+        if (u_alpha_comp_loc >= 0) {
+            glUniform1i(u_alpha_comp_loc, (int)s_current_state.alpha_comp);
+        }
+        if (u_alpha_op_loc >= 0) {
+            glUniform1i(u_alpha_op_loc, (int)s_current_state.alpha_op);
+        }
+        if (u_alpha_comp1_loc >= 0) {
+            glUniform1i(u_alpha_comp1_loc, (int)s_current_state.alpha_comp1);
+        }
+        if (u_alpha_ref1_loc >= 0) {
+            glUniform1f(u_alpha_ref1_loc, (float)s_current_state.alpha_ref1 / 255.0f);
+        }
+
+        if (s_current_state.cull_face == 0) { /* GX_CULL_NONE */
+            glDisable(GL_CULL_FACE);
+        } else {
+            glEnable(GL_CULL_FACE);
+            if (s_current_state.cull_face == 2) { /* GX_CULL_BACK */
+                glCullFace(GL_BACK);
+            } else if (s_current_state.cull_face == 1) { /* GX_CULL_FRONT */
+                glCullFace(GL_FRONT);
+            } else if (s_current_state.cull_face == 3) { /* GX_CULL_ALL */
+                glCullFace(GL_FRONT_AND_BACK);
+            }
+        }
+
+        /* VideoCore IV client-side vertex arrays (avoids VCHIQ DMA lockups) */
+        glBindBuffer(GL_ARRAY_BUFFER, 0);
+        GLsizei stride = sizeof(GXVertex);
+        const uint8_t* base = (const uint8_t*)final_verts;
+
+        glEnableVertexAttribArray(0);
+        glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, stride, (const void*)(base + offsetof(GXVertex, pos)));
+
+        glEnableVertexAttribArray(1);
+        glVertexAttribPointer(1, 4, GL_UNSIGNED_BYTE, GL_TRUE, stride, (const void*)(base + offsetof(GXVertex, col)));
+
+        glEnableVertexAttribArray(2);
+        glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, stride, (const void*)(base + offsetof(GXVertex, tex)));
+
+        glDisableVertexAttribArray(3);
+
+        struct timespec t_draw_0, t_draw_1;
+        clock_gettime(CLOCK_MONOTONIC, &t_draw_0);
+
+        glDrawArrays(gl_prim, 0, final_count);
+
+        clock_gettime(CLOCK_MONOTONIC, &t_draw_1);
+        double dt_draw = (t_draw_1.tv_sec - t_draw_0.tv_sec) * 1000.0 + (t_draw_1.tv_nsec - t_draw_0.tv_nsec) / 1e6;
+        s_metric_render_time_ms += dt_draw;
+        s_metric_draw_calls++;
+        s_metric_verts += final_count;
+        s_metric_tris += (gl_prim == GL_TRIANGLES ? final_count / 3 : (final_count > 2 ? final_count - 2 : 0));
+    }
+    s_vert_count = 0;
+}
+
+enum AttrAction {
+    ATTR_ACT_GENERIC = 0,
+    ATTR_ACT_PNMTXIDX,
+    ATTR_ACT_TEXMTXIDX,
+    ATTR_ACT_POS_INDEX16_S16_XYZ,
+    ATTR_ACT_POS_INDEX16_F32_XYZ,
+    ATTR_ACT_POS_INDEX8_S16_XYZ,
+    ATTR_ACT_POS_INDEX8_F32_XYZ,
+    ATTR_ACT_NRM_INDEX16_S16_XYZ,
+    ATTR_ACT_NRM_INDEX16_S8_XYZ,
+    ATTR_ACT_NRM_INDEX8_S16_XYZ,
+    ATTR_ACT_NRM_INDEX8_S8_XYZ,
+    ATTR_ACT_NRM_DIRECT_S16_XYZ,
+    ATTR_ACT_NRM_DIRECT_S8_XYZ,
+    ATTR_ACT_CLR_INDEX16_RGBA8,
+    ATTR_ACT_CLR_DIRECT_RGBA8,
+    ATTR_ACT_CLR_DIRECT_RGBA4,
+    ATTR_ACT_CLR_DIRECT_RGB8,
+    ATTR_ACT_CLR_DIRECT_RGB565,
+    ATTR_ACT_CLR_DIRECT_RGBA6,
+    ATTR_ACT_CLR_INDEX8_RGBA4,
+    ATTR_ACT_CLR_INDEX8_RGB8,
+    ATTR_ACT_CLR_INDEX8_RGBA6,
+    ATTR_ACT_CLR_INDEX8_RGBA8,
+    ATTR_ACT_CLR_INDEX16_RGBA4,
+    ATTR_ACT_CLR_INDEX16_RGB8,
+    ATTR_ACT_CLR_INDEX16_RGBA6,
+    ATTR_ACT_TEX0_INDEX16_S16,
+    ATTR_ACT_TEX0_INDEX16_U16,
+    ATTR_ACT_TEX0_INDEX16_F32,
+    ATTR_ACT_TEX0_INDEX8_S16,
+    ATTR_ACT_TEX0_INDEX8_U16,
+    ATTR_ACT_TEX0_INDEX8_U8,
+    ATTR_ACT_TEX0_INDEX8_S8,
+    ATTR_ACT_TEX0_INDEX16_U8,
+    ATTR_ACT_TEX0_INDEX16_S8
+};
+
+typedef struct {
+    GXAttr attr;
+    GXAttrType type;
+    GXCompCnt comp_cnt;
+    GXCompType comp_type;
+    uint8_t frac;
+    uint8_t direct_size;
+    uint8_t action;
+    const uint8_t* base_ptr;
+    uint32_t stride;
+    float scale;
+} ActiveAttr;
+
+typedef struct {
+    uint32_t gen;
+    ActiveAttr active_attrs[NUM_CANONICAL_ATTRS];
+    int num_active;
+    uint32_t vtx_size;
+    bool has_pnmtxidx;
+    bool has_texmtxidx;
+    bool has_tex_attr;
+    bool has_nrm_attr;
+    bool has_clr_attr;
+    bool is_pos_nrm_tex_s16;
+    bool is_pos_tex_s16;
+    bool is_pnmtx_pos_nrm_tex_s16;
+    bool is_pos_nrm_tex_idx8;
+    bool is_pos_tex_idx8;
+    bool is_pos_clr_tex_idx8;
+    bool is_pos_clr_tex_s16;
+    bool is_pos_idx8_clr_direct_tex_idx8;
+    bool is_pos_idx16_clr_direct_tex_idx16;
+    bool is_pos_nrm_tex_any;
+    bool is_pos_tex_any;
+    bool is_pnmtx_pos_tex;
+    bool is_pnmtx_pos_nrm_tex_any;
+    bool is_pos_clr_direct_notex;
+    bool is_pos_nrm_notex;
+    bool is_pnmtx_pos_clr_notex;
+    bool is_pnmtx_pos_nrm_notex;
+    bool is_pos_only;
+    bool is_pos_f32;
+    bool is_nrm_direct;
+    uint8_t pos_idx_size;
+    uint8_t nrm_idx_size;
+    uint8_t tex_idx_size;
+    uint8_t clr_idx_size;
+    uint8_t tex1_idx_size;
+} CachedVat;
+
+static CachedVat s_vat_cache[8];
+
+static void port_gx_rebuild_cached_vat(CachedVat* cvat, uint8_t vtx_fmt) {
+    cvat->num_active = 0;
+    cvat->vtx_size = 0;
+    cvat->has_pnmtxidx = false;
+    cvat->has_texmtxidx = false;
+    cvat->has_tex_attr = false;
+    cvat->has_nrm_attr = false;
+    cvat->has_clr_attr = false;
+    cvat->is_pos_nrm_tex_s16 = false;
+    cvat->is_pos_tex_s16 = false;
+    cvat->is_pnmtx_pos_nrm_tex_s16 = false;
+    cvat->is_pos_nrm_tex_idx8 = false;
+    cvat->is_pos_tex_idx8 = false;
+    cvat->is_pos_clr_tex_idx8 = false;
+    cvat->is_pos_clr_tex_s16 = false;
+    cvat->is_pos_idx8_clr_direct_tex_idx8 = false;
+    cvat->is_pos_idx16_clr_direct_tex_idx16 = false;
+    cvat->is_pos_nrm_tex_any = false;
+    cvat->is_pos_tex_any = false;
+    cvat->is_pnmtx_pos_tex = false;
+    cvat->is_pnmtx_pos_nrm_tex_any = false;
+    cvat->is_pos_clr_direct_notex = false;
+    cvat->is_pos_nrm_notex = false;
+    cvat->is_pnmtx_pos_clr_notex = false;
+    cvat->is_pnmtx_pos_nrm_notex = false;
+    cvat->is_pos_only = false;
+    cvat->is_pos_f32 = false;
+    cvat->is_nrm_direct = false;
+    cvat->pos_idx_size = 0;
+    cvat->nrm_idx_size = 0;
+    cvat->tex_idx_size = 0;
+    cvat->clr_idx_size = 0;
+    cvat->tex1_idx_size = 0;
+
+    for (size_t a = 0; a < NUM_CANONICAL_ATTRS; a++) {
+        GXAttr attr = s_canonical_attr_order[a];
+        GXAttrType type = s_vtx_desc[attr];
+        if (type == GX_NONE) continue;
+
+        ActiveAttr* aa = &cvat->active_attrs[cvat->num_active++];
+        aa->attr = attr;
+        aa->type = type;
+        aa->base_ptr = (const uint8_t*)s_array_ptrs[attr];
+        aa->stride = s_array_strides[attr];
+
+        aa->action = ATTR_ACT_GENERIC;
+        if (attr == GX_VA_PNMTXIDX) {
+            cvat->has_pnmtxidx = true;
+            cvat->vtx_size += 1;
+            aa->direct_size = 1;
+            aa->comp_cnt = 0;
+            aa->comp_type = 0;
+            aa->frac = 0;
+            aa->scale = 1.0f;
+            aa->action = ATTR_ACT_PNMTXIDX;
+        } else if (attr >= GX_VA_TEX0MTXIDX && attr <= GX_VA_TEX7MTXIDX) {
+            cvat->has_texmtxidx = true;
+            cvat->vtx_size += 1;
+            aa->direct_size = 1;
+            aa->comp_cnt = 0;
+            aa->comp_type = 0;
+            aa->frac = 0;
+            aa->scale = 1.0f;
+            aa->action = ATTR_ACT_TEXMTXIDX;
+        } else if (type == GX_INDEX8) {
+            cvat->vtx_size += 1;
+            VtxFmtAttr fmt = s_vtx_fmt[vtx_fmt][attr];
+            aa->comp_cnt = fmt.comp_cnt;
+            aa->comp_type = fmt.comp_type;
+            aa->frac = fmt.frac;
+            aa->direct_size = 0;
+            if (attr == GX_VA_POS) {
+                aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : 1.0f;
+                if (fmt.comp_type == GX_S16 && fmt.comp_cnt == GX_POS_XYZ) aa->action = ATTR_ACT_POS_INDEX8_S16_XYZ;
+                else if (fmt.comp_type == GX_F32 && fmt.comp_cnt == GX_POS_XYZ) aa->action = ATTR_ACT_POS_INDEX8_F32_XYZ;
+            } else if (attr >= GX_VA_TEX0 && attr <= GX_VA_TEX7) {
+                cvat->has_tex_attr = true;
+                aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : 1.0f;
+                if ((attr - GX_VA_TEX0) == s_active_tex_coord && fmt.comp_cnt == GX_TEX_ST) {
+                    if (fmt.comp_type == GX_S16) aa->action = ATTR_ACT_TEX0_INDEX8_S16;
+                    else if (fmt.comp_type == GX_U16) aa->action = ATTR_ACT_TEX0_INDEX8_U16;
+                    else if (fmt.comp_type == GX_U8) aa->action = ATTR_ACT_TEX0_INDEX8_U8;
+                    else if (fmt.comp_type == GX_S8) aa->action = ATTR_ACT_TEX0_INDEX8_S8;
+                }
+            } else if (attr == GX_VA_NRM || attr == GX_VA_NBT) {
+                cvat->has_nrm_attr = true;
+                if (fmt.comp_type == GX_S16) {
+                    aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : (1.0f / 32768.0f);
+                    aa->action = ATTR_ACT_NRM_INDEX8_S16_XYZ;
+                } else if (fmt.comp_type == GX_S8) {
+                    aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : (1.0f / 64.0f);
+                    aa->action = ATTR_ACT_NRM_INDEX8_S8_XYZ;
+                } else {
+                    aa->scale = 1.0f;
+                }
+            } else if (attr == GX_VA_CLR0 || attr == GX_VA_CLR1) {
+                cvat->has_clr_attr = true;
+                aa->scale = 1.0f;
+                if (fmt.comp_type == GX_RGBA4) aa->action = ATTR_ACT_CLR_INDEX8_RGBA4;
+                else if (fmt.comp_type == GX_RGB8) aa->action = ATTR_ACT_CLR_INDEX8_RGB8;
+                else if (fmt.comp_type == GX_RGBA6) aa->action = ATTR_ACT_CLR_INDEX8_RGBA6;
+                else if (fmt.comp_type == GX_RGBA8) aa->action = ATTR_ACT_CLR_INDEX8_RGBA8;
+            } else {
+                aa->scale = 1.0f;
+            }
+            if (attr >= GX_VA_TEX0 && attr <= GX_VA_TEX7) {
+                cvat->has_tex_attr = true;
+            }
+        } else if (type == GX_INDEX16) {
+            cvat->vtx_size += 2;
+            VtxFmtAttr fmt = s_vtx_fmt[vtx_fmt][attr];
+            aa->comp_cnt = fmt.comp_cnt;
+            aa->comp_type = fmt.comp_type;
+            aa->frac = fmt.frac;
+            aa->direct_size = 0;
+            if (attr == GX_VA_POS) {
+                aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : 1.0f;
+                if (fmt.comp_type == GX_S16 && fmt.comp_cnt == GX_POS_XYZ) aa->action = ATTR_ACT_POS_INDEX16_S16_XYZ;
+                else if (fmt.comp_type == GX_F32 && fmt.comp_cnt == GX_POS_XYZ) aa->action = ATTR_ACT_POS_INDEX16_F32_XYZ;
+            } else if (attr >= GX_VA_TEX0 && attr <= GX_VA_TEX7) {
+                cvat->has_tex_attr = true;
+                aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : 1.0f;
+                if ((attr - GX_VA_TEX0) == s_active_tex_coord && fmt.comp_cnt == GX_TEX_ST) {
+                    if (fmt.comp_type == GX_S16) aa->action = ATTR_ACT_TEX0_INDEX16_S16;
+                    else if (fmt.comp_type == GX_U16) aa->action = ATTR_ACT_TEX0_INDEX16_U16;
+                    else if (fmt.comp_type == GX_U8) aa->action = ATTR_ACT_TEX0_INDEX16_U8;
+                    else if (fmt.comp_type == GX_S8) aa->action = ATTR_ACT_TEX0_INDEX16_S8;
+                    else if (fmt.comp_type == GX_F32) aa->action = ATTR_ACT_TEX0_INDEX16_F32;
+                }
+            } else if (attr == GX_VA_NRM || attr == GX_VA_NBT) {
+                cvat->has_nrm_attr = true;
+                if (fmt.comp_type == GX_S16) {
+                    aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : (1.0f / 32768.0f);
+                    aa->action = ATTR_ACT_NRM_INDEX16_S16_XYZ;
+                } else if (fmt.comp_type == GX_S8) {
+                    aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : (1.0f / 64.0f);
+                    aa->action = ATTR_ACT_NRM_INDEX16_S8_XYZ;
+                } else {
+                    aa->scale = 1.0f;
+                }
+            } else if (attr == GX_VA_CLR0 || attr == GX_VA_CLR1) {
+                cvat->has_clr_attr = true;
+                aa->scale = 1.0f;
+                if (fmt.comp_type == GX_RGBA4) aa->action = ATTR_ACT_CLR_INDEX16_RGBA4;
+                else if (fmt.comp_type == GX_RGB8) aa->action = ATTR_ACT_CLR_INDEX16_RGB8;
+                else if (fmt.comp_type == GX_RGBA6) aa->action = ATTR_ACT_CLR_INDEX16_RGBA6;
+                else if (fmt.comp_type == GX_RGBA8) aa->action = ATTR_ACT_CLR_INDEX16_RGBA8;
+            } else {
+                aa->scale = 1.0f;
+            }
+        } else if (type == GX_DIRECT) {
+            VtxFmtAttr fmt = s_vtx_fmt[vtx_fmt][attr];
+            aa->comp_cnt = fmt.comp_cnt;
+            aa->comp_type = fmt.comp_type;
+            aa->frac = fmt.frac;
+            int dsz = get_direct_size(attr, fmt.comp_cnt, fmt.comp_type);
+            aa->direct_size = (uint8_t)dsz;
+            cvat->vtx_size += dsz;
+            if (attr == GX_VA_POS || attr >= GX_VA_TEX0) {
+                aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : 1.0f;
+            } else if (attr == GX_VA_NRM || attr == GX_VA_NBT) {
+                cvat->has_nrm_attr = true;
+                if (fmt.comp_type == GX_S16) {
+                    aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : (1.0f / 32768.0f);
+                    aa->action = ATTR_ACT_NRM_DIRECT_S16_XYZ;
+                } else if (fmt.comp_type == GX_S8) {
+                    aa->scale = (fmt.frac > 0) ? (1.0f / (float)(1 << fmt.frac)) : (1.0f / 64.0f);
+                    aa->action = ATTR_ACT_NRM_DIRECT_S8_XYZ;
+                } else {
+                    aa->scale = 1.0f;
+                }
+            } else if (attr == GX_VA_CLR0 || attr == GX_VA_CLR1) {
+                cvat->has_clr_attr = true;
+                aa->scale = 1.0f;
+                if (fmt.comp_type == GX_RGBA4) aa->action = ATTR_ACT_CLR_DIRECT_RGBA4;
+                else if (fmt.comp_type == GX_RGB8) aa->action = ATTR_ACT_CLR_DIRECT_RGB8;
+                else if (fmt.comp_type == GX_RGBA6) aa->action = ATTR_ACT_CLR_DIRECT_RGBA6;
+                else if (fmt.comp_type == GX_RGB565) aa->action = ATTR_ACT_CLR_DIRECT_RGB565;
+                else if (fmt.comp_type == GX_RGBA8) aa->action = ATTR_ACT_CLR_DIRECT_RGBA8;
+            } else {
+                aa->scale = 1.0f;
+            }
+            if (attr >= GX_VA_TEX0 && attr <= GX_VA_TEX7) {
+                cvat->has_tex_attr = true;
+            }
+        }
+    }
+
+    if ((cvat->num_active == 4 || cvat->num_active == 5) &&
+        cvat->active_attrs[0].action == ATTR_ACT_PNMTXIDX &&
+        cvat->active_attrs[1].action == ATTR_ACT_POS_INDEX16_S16_XYZ &&
+        (cvat->active_attrs[2].action == ATTR_ACT_NRM_INDEX16_S16_XYZ || cvat->active_attrs[2].action == ATTR_ACT_NRM_INDEX16_S8_XYZ) &&
+        (cvat->active_attrs[3].action == ATTR_ACT_TEX0_INDEX16_S16 || cvat->active_attrs[3].action == ATTR_ACT_TEX0_INDEX16_U16) &&
+        (cvat->num_active == 4 || (cvat->active_attrs[4].attr >= GX_VA_TEX1 && cvat->active_attrs[4].attr <= GX_VA_TEX7)) &&
+        !cvat->has_texmtxidx) {
+        cvat->is_pnmtx_pos_nrm_tex_s16 = true;
+        cvat->tex1_idx_size = (cvat->num_active == 5) ? ((cvat->active_attrs[4].type == GX_INDEX8) ? 1 : 2) : 0;
