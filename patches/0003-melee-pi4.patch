+void GXSetTevOp(GXTevStageID id, GXTevMode mode) {
+    if (id < MAX_TEV_STAGES) {
+        s_current_state.tev_active = 1;
+        s_current_state.tev_c_op[id] = GX_TEV_ADD;
+        s_current_state.tev_a_op[id] = GX_TEV_ADD;
+        s_current_state.tev_c_bias[id] = GX_TB_ZERO;
+        s_current_state.tev_a_bias[id] = GX_TB_ZERO;
+        s_current_state.tev_c_scale[id] = GX_CS_SCALE_1;
+        s_current_state.tev_a_scale[id] = GX_CS_SCALE_1;
+        s_current_state.tev_c_clamp[id] = 1;
+        s_current_state.tev_a_clamp[id] = 1;
+        s_current_state.tev_c_out[id] = GX_TEVPREV;
+        s_current_state.tev_a_out[id] = GX_TEVPREV;
+        if (mode == GX_PASSCLR) {
+            s_current_state.tev_c_in[id][0] = GX_CC_ZERO;
+            s_current_state.tev_c_in[id][1] = GX_CC_ZERO;
+            s_current_state.tev_c_in[id][2] = GX_CC_ZERO;
+            s_current_state.tev_c_in[id][3] = GX_CC_RASC;
+
+            s_current_state.tev_a_in[id][0] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][1] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][2] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][3] = GX_CA_RASA;
+        } else if (mode == GX_REPLACE) {
+            s_current_state.tev_c_in[id][0] = GX_CC_ZERO;
+            s_current_state.tev_c_in[id][1] = GX_CC_ZERO;
+            s_current_state.tev_c_in[id][2] = GX_CC_ZERO;
+            s_current_state.tev_c_in[id][3] = GX_CC_TEXC;
+
+            s_current_state.tev_a_in[id][0] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][1] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][2] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][3] = GX_CA_TEXA;
+        } else if (mode == GX_DECAL) {
+            s_current_state.tev_c_in[id][0] = GX_CC_RASC;
+            s_current_state.tev_c_in[id][1] = GX_CC_TEXC;
+            s_current_state.tev_c_in[id][2] = GX_CC_TEXA;
+            s_current_state.tev_c_in[id][3] = GX_CC_ZERO;
+
+            s_current_state.tev_a_in[id][0] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][1] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][2] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][3] = GX_CA_RASA;
+        } else { /* GX_MODULATE */
+            s_current_state.tev_c_in[id][0] = GX_CC_ZERO;
+            s_current_state.tev_c_in[id][1] = GX_CC_TEXC;
+            s_current_state.tev_c_in[id][2] = GX_CC_RASC;
+            s_current_state.tev_c_in[id][3] = GX_CC_ZERO;
+
+            s_current_state.tev_a_in[id][0] = GX_CA_ZERO;
+            s_current_state.tev_a_in[id][1] = GX_CA_TEXA;
+            s_current_state.tev_a_in[id][2] = GX_CA_RASA;
+            s_current_state.tev_a_in[id][3] = GX_CA_ZERO;
+        }
+    }
+}
