+static inline bool port_gx_tev_uses_ras(void) {
+    if (!s_current_state.tev_active || s_current_state.num_tev_stages == 0) return true;
+    for (int st = 0; st < s_current_state.num_tev_stages; st++) {
+        for (int i = 0; i < 4; i++) {
+            if (s_current_state.tev_c_in[st][i] == GX_CC_RASC || s_current_state.tev_c_in[st][i] == GX_CC_RASA) return true;
+            if (s_current_state.tev_a_in[st][i] == GX_CA_RASA) return true;
+        }
+    }
+    return false;
+}
+
+static inline bool port_gx_state_is_tev_lerp(const RenderDrawState* state) {
+    if (!state || !state->tev_active) return false;
+    for (int s = 0; s < state->num_tev_stages && s < 4; s++) {
+        if ((state->tev_c_in[s][2] == GX_CC_TEXC || state->tev_c_in[s][2] == GX_CC_TEXA) &&
+            state->tev_c_in[s][3] == GX_CC_ZERO) {
+            uint8_t a = state->tev_c_in[s][0];
+            uint8_t b = state->tev_c_in[s][1];
+            if ((a == GX_CC_KONST || a == GX_CC_C2 || a == GX_CC_C0 || a == GX_CC_C1) &&
+                (b == GX_CC_KONST || b == GX_CC_C2 || b == GX_CC_C0 || b == GX_CC_C1)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static inline void port_gx_get_default_vtx_color(uint8_t out_col[4]) {
+    /* If this packet uses dual-color TEV lerp, use pure white so vertex color does not tint or clamp either color */
+    if (port_gx_state_is_tev_lerp(&s_current_state)) {
+        out_col[0] = 255;
+        out_col[1] = 255;
+        out_col[2] = 255;
+        out_col[3] = 255;
+        return;
+    }
+
+    /* Determine RGB source */
+    uint8_t c_src = s_current_state.tev_c_in[0][3];
+    if (c_src == GX_CC_ZERO) {
+        c_src = s_current_state.tev_c_in[0][2];
+    }
+    if (c_src == GX_CC_ZERO) {
+        c_src = s_current_state.tev_c_in[0][1];
+    }
+
+    if (c_src == GX_CC_TEXC) {
+        out_col[0] = 255;
+        out_col[1] = 255;
+        out_col[2] = 255;
+    } else if (c_src == GX_CC_KONST) {
+        uint8_t kc0 = s_current_state.tev_kcsel[0];
+        int ki0 = (kc0 >= 0x0C && kc0 <= 0x0F) ? (kc0 - 0x0C) : 0;
+        uint8_t r = s_current_state.kcolors[ki0][0];
+        uint8_t g = s_current_state.kcolors[ki0][1];
+        uint8_t b = s_current_state.kcolors[ki0][2];
+        int best_lum = (int)r + (int)g + (int)b;
+
+        /* In multi-stage TEV texture blending (e.g. stage 0 = outline K2, stage 1 = interior K1 modulated by TEXC),
+         * select the brighter interior color so objects like the P1 floating hand and unselected menu text
+         * do not get colored by their dark outline/shadow color. */
+        for (int st = 1; st < s_current_state.num_tev_stages && st < 2; st++) {
+            uint8_t kc_st = s_current_state.tev_kcsel[st];
+            int ki = (kc_st >= 0x0C && kc_st <= 0x0F) ? (kc_st - 0x0C) : -1;
+            if (ki >= 0) {
+                uint8_t kr = s_current_state.kcolors[ki][0];
+                uint8_t kg = s_current_state.kcolors[ki][1];
+                uint8_t kb = s_current_state.kcolors[ki][2];
+                int lum = (int)kr + (int)kg + (int)kb;
+                if (lum > best_lum) {
+                    best_lum = lum;
+                    r = kr; g = kg; b = kb;
+                }
+            }
+        }
+        out_col[0] = r;
+        out_col[1] = g;
+        out_col[2] = b;
+    } else if (c_src == GX_CC_C0) {
+        out_col[0] = s_current_state.tev_regs[GX_TEVREG0][0];
+        out_col[1] = s_current_state.tev_regs[GX_TEVREG0][1];
+        out_col[2] = s_current_state.tev_regs[GX_TEVREG0][2];
+    } else if (c_src == GX_CC_C1) {
+        out_col[0] = s_current_state.tev_regs[GX_TEVREG1][0];
+        out_col[1] = s_current_state.tev_regs[GX_TEVREG1][1];
+        out_col[2] = s_current_state.tev_regs[GX_TEVREG1][2];
+    } else if (c_src == GX_CC_C2) {
+        out_col[0] = s_current_state.tev_regs[GX_TEVREG2][0];
+        out_col[1] = s_current_state.tev_regs[GX_TEVREG2][1];
+        out_col[2] = s_current_state.tev_regs[GX_TEVREG2][2];
+    } else if (c_src == GX_CC_CPREV) {
+        out_col[0] = s_current_state.tev_regs[GX_TEVPREV][0];
+        out_col[1] = s_current_state.tev_regs[GX_TEVPREV][1];
+        out_col[2] = s_current_state.tev_regs[GX_TEVPREV][2];
+    } else if (s_current_state.texture_id == 0 && (s_mat_color.r > 0 || s_mat_color.g > 0 || s_mat_color.b > 0)) {
+        out_col[0] = s_mat_color.r;
+        out_col[1] = s_mat_color.g;
+        out_col[2] = s_mat_color.b;
+    } else {
+        out_col[0] = 255;
+        out_col[1] = 255;
+        out_col[2] = 255;
+    }
+
+    /* Determine Alpha source */
+    uint8_t a_src = s_current_state.tev_a_in[0][3];
+    if (a_src == GX_CA_ZERO) {
+        a_src = s_current_state.tev_a_in[0][2];
+    }
+    if (a_src == GX_CA_ZERO) {
+        a_src = s_current_state.tev_a_in[0][1];
+    }
+
+    if (a_src == GX_CA_TEXA) {
+        out_col[3] = 255;
+    } else if (a_src == GX_CA_KONST) {
+        uint8_t ka = s_current_state.tev_kasel[0];
+        int ka_idx = (ka >= 0x1C && ka <= 0x1F) ? (ka - 0x1C) :
+                     (ka >= 0x0C && ka <= 0x0F) ? (ka - 0x0C) : 0;
+        out_col[3] = s_current_state.kcolors[ka_idx][3];
+    } else if (a_src == GX_CA_A0) {
+        out_col[3] = s_current_state.tev_regs[GX_TEVREG0][3];
+    } else if (a_src == GX_CA_A1) {
+        out_col[3] = s_current_state.tev_regs[GX_TEVREG1][3];
+    } else if (a_src == GX_CA_A2) {
+        out_col[3] = s_current_state.tev_regs[GX_TEVREG2][3];
+    } else if (a_src == GX_CA_APREV) {
+        out_col[3] = s_current_state.tev_regs[GX_TEVPREV][3];
+    } else if (s_current_state.texture_id == 0 && s_mat_color.a > 0) {
+        out_col[3] = s_mat_color.a;
+    } else {
+        out_col[3] = 255;
+    }
+}
+
+void GXBegin(GXPrimitive prim, GXVtxFmt vtxfmt, uint16_t nverts) {
