diff --git a/src/port/port_audio.c b/src/port/port_audio.c
new file mode 100755
index 0000000..19f2e94
--- /dev/null
+++ b/src/port/port_audio.c
@@ -0,0 +1,781 @@
+#define _GNU_SOURCE
+#include "port/port_audio.h"
+#include "port/port_os.h"
+#include <dolphin/types.h>
+#include <dolphin/ax.h>
+#include <dolphin/ai.h>
+#include <dolphin/ar.h>
+#include <dolphin/arq.h>
+#include <dolphin/axfx.h>
+#include <SDL2/SDL.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "port/port_render_thread.h"
+#if defined(_OPENMP)
+#include <omp.h>
+#endif
+
+static void (*s_ax_callback)(void) = NULL;
+static SDL_AudioDeviceID s_audio_dev = 0;
+static uint8_t s_aram_buffer[16 * 1024 * 1024]; /* 16 MB ARAM */
+
+#define AX_MAX_VOICES 64
+
+typedef struct {
+    bool     active;
+    uint32_t curr_nibble;
+    uint32_t loop_nibble;
+    uint32_t end_nibble;
+    bool     loop;
+    uint16_t format; /* 0 = ADPCM, 1 = 16-bit PCM */
+
+    int16_t  coef[8][2];
+    int16_t  yn1;
+    int16_t  yn2;
+    uint16_t pred_scale;
+
+    int16_t  loop_yn1;
+    int16_t  loop_yn2;
+    uint16_t loop_pred_scale;
+
+    uint32_t src_frac; /* 16.16 */
+    int16_t  s0;
+    int16_t  s1;
+} PortVoice;
+
+static AXVPB s_voices[AX_MAX_VOICES];
+static bool  s_voice_allocated[AX_MAX_VOICES];
+static PortVoice s_port_voices[AX_MAX_VOICES];
+static pthread_mutex_t s_audio_mutex = PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP;
+
+static inline int16_t voice_decode_next(int v_idx) {
+    PortVoice* v = &s_port_voices[v_idx];
+    AXVPB* pb_voice = &s_voices[v_idx];
+
+    if (!v->active || pb_voice->pb.state == 0) {
+        return 0;
+    }
+
+    if (v->curr_nibble >= v->end_nibble) {
+        if (v->loop) {
+            v->curr_nibble = v->loop_nibble;
+            v->yn1 = v->loop_yn1;
+            v->yn2 = v->loop_yn2;
+            v->pred_scale = v->loop_pred_scale;
+            if (v->end_nibble <= v->loop_nibble) {
+                /* Forward block transition in streaming ring buffer:
+                 * extend end_nibble temporarily so the stream continues decoding
+                 * until HSD_SynthPStreamMasterClockCallback updates endAddress. */
+                v->end_nibble = v->loop_nibble + 0x20000;
+            }
+        } else {
+            v->active = false;
+            pb_voice->pb.state = 0;
+            return 0;
+        }
+    }
+
+    if (v->format == 1) {
+        /* 16-bit signed PCM (big-endian) */
+        uint32_t byte_idx = v->curr_nibble * 2;
+        if (byte_idx + 2 > sizeof(s_aram_buffer)) {
+            v->active = false;
+            pb_voice->pb.state = 0;
+            return 0;
+        }
+        int16_t sample = (int16_t)((s_aram_buffer[byte_idx] << 8) | s_aram_buffer[byte_idx + 1]);
+        v->curr_nibble++;
+        pb_voice->pb.addr.currentAddressHi = (u16)(v->curr_nibble >> 16);
+        pb_voice->pb.addr.currentAddressLo = (u16)(v->curr_nibble & 0xFFFF);
+        return sample;
+    }
+
+    /* Standard Nintendo GameCube DSP ADPCM */
+    uint32_t n = v->curr_nibble;
+    if ((n & 15) < 2) {
+        n = (n & ~15) + 2;
+        v->curr_nibble = n;
+    }
+
+    uint32_t frame_start_byte = (n >> 4) << 3;
+    if (frame_start_byte + 8 > sizeof(s_aram_buffer)) {
+        v->active = false;
+        pb_voice->pb.state = 0;
+        return 0;
+    }
+
+    const uint8_t* fptr = &s_aram_buffer[frame_start_byte];
+    uint8_t header = fptr[0];
+    int pred = (header >> 4) & 0x07;
+    int scale = header & 0x0F;
+
+    uint32_t nib_in_frame = n & 15;
+    uint32_t byte_in_frame = 1 + ((nib_in_frame - 2) >> 1);
+    uint8_t b = fptr[byte_in_frame];
+    int8_t nibble = ((nib_in_frame & 1) == 0) ? (int8_t)(b >> 4) : (int8_t)(b & 0x0F);
+    if (nibble >= 8) nibble -= 16;
+
+    int32_t c0 = (int32_t)v->coef[pred][0];
+    int32_t c1 = (int32_t)v->coef[pred][1];
+    int32_t sample = (nibble << scale) + ((c0 * (int32_t)v->yn1 + c1 * (int32_t)v->yn2 + 1024) >> 11);
+    if (sample > 32767) sample = 32767;
+    else if (sample < -32768) sample = -32768;
+
+    v->yn2 = v->yn1;
+    v->yn1 = (int16_t)sample;
+
+    n++;
+    if ((n & 15) == 0) {
+        n += 2;
+    }
+    v->curr_nibble = n;
+
+    pb_voice->pb.addr.currentAddressHi = (u16)(n >> 16);
+    pb_voice->pb.addr.currentAddressLo = (u16)(n & 0xFFFF);
+
+    return (int16_t)sample;
+}
+
+static void voice_start(int i) {
+    PortVoice* v = &s_port_voices[i];
+    AXVPB* p = &s_voices[i];
+
+    uint32_t curr = ((uint32_t)p->pb.addr.currentAddressHi << 16) | p->pb.addr.currentAddressLo;
+    uint32_t loop_addr = ((uint32_t)p->pb.addr.loopAddressHi << 16) | p->pb.addr.loopAddressLo;
+    uint32_t end_addr = ((uint32_t)p->pb.addr.endAddressHi << 16) | p->pb.addr.endAddressLo;
+
+    if (p->pb.addr.format == 0) {
+        if ((curr & 15) < 2) curr = (curr & ~15) + 2;
+        if ((loop_addr & 15) < 2) loop_addr = (loop_addr & ~15) + 2;
+    }
+
+    v->curr_nibble = curr;
+    v->loop_nibble = loop_addr;
+    v->end_nibble = end_addr;
+    v->loop = (p->pb.addr.loopFlag != 0);
+    v->format = p->pb.addr.format;
+
+    memcpy(v->coef, p->pb.adpcm.a, sizeof(v->coef));
+    v->yn1 = (int16_t)p->pb.adpcm.yn1;
+    v->yn2 = (int16_t)p->pb.adpcm.yn2;
+    v->pred_scale = p->pb.adpcm.pred_scale;
+
+    v->loop_yn1 = (int16_t)p->pb.adpcmLoop.loop_yn1;
+    v->loop_yn2 = (int16_t)p->pb.adpcmLoop.loop_yn2;
+    v->loop_pred_scale = p->pb.adpcmLoop.loop_pred_scale;
+
+    v->src_frac = 0;
+    v->active = true;
+    v->s0 = voice_decode_next(i);
+    v->s1 = voice_decode_next(i);
+
+    static int s_start_logs = 0;
+    if (++s_start_logs <= 15 || (s_start_logs % 50) == 0) {
+        fprintf(stderr, "[Melee-Audio] Voice %d playing: fmt=%d, addr=0x%x..0x%x (loop=0x%x, flag=%d), vol=(%d,%d)\n",
+                i, v->format, v->curr_nibble, v->end_nibble, v->loop_nibble, v->loop,
+                p->pb.mix.vL ? p->pb.mix.vL : p->pb.ve.currentVolume,
+                p->pb.mix.vR ? p->pb.mix.vR : p->pb.ve.currentVolume);
+    }
+}
+
+static void sdl_audio_cb(void* udata, Uint8* stream, int len) {
+    (void)udata;
+#if defined(__linux__) && defined(_GNU_SOURCE)
+    static __thread bool s_audio_pinned = false;
+    if (!s_audio_pinned) {
+        Port_PinThreadToCore(2);
+        s_audio_pinned = true;
+    }
+#endif
+    int total_frames = len / (2 * sizeof(int16_t));
+    int16_t* out = (int16_t*)stream;
+
+    int frames_done = 0;
+    while (frames_done < total_frames) {
+        int chunk = total_frames - frames_done;
+        if (chunk > 160) chunk = 160;
+
+        /* Execute AX frame callback WITHOUT holding s_audio_mutex to eliminate ABBA
+         * deadlocks with simulation threads (Core 0) holding s_intr_mutex (OSDisableInterrupts) */
+        if (s_ax_callback) {
+            s_ax_callback();
+        }
+
+        pthread_mutex_lock(&s_audio_mutex);
+
+        for (int i = 0; i < AX_MAX_VOICES; i++) {
+            if (s_voices[i].pb.state == 1 && !s_port_voices[i].active) {
+                voice_start(i);
+            } else if (s_voices[i].pb.state == 0 && s_port_voices[i].active) {
+                s_port_voices[i].active = false;
+            }
+        }
+
+        int32_t mix_l[160] = {0};
+        int32_t mix_r[160] = {0};
+
+        for (int i = 0; i < AX_MAX_VOICES; i++) {
+            PortVoice* v = &s_port_voices[i];
+            AXVPB* p = &s_voices[i];
+            if (!v->active || p->pb.state == 0) continue;
+
+            int32_t vl = p->pb.mix.vL;
+            int32_t vr = p->pb.mix.vR;
+            if (vl == 0 && vr == 0) {
+                vl = p->pb.ve.currentVolume;
+                vr = p->pb.ve.currentVolume;
+            } else if (p->pb.ve.currentVolume > 0) {
+                vl = (vl * (int32_t)p->pb.ve.currentVolume) >> 15;
+                vr = (vr * (int32_t)p->pb.ve.currentVolume) >> 15;
+            }
+
+            uint32_t ratio = ((uint32_t)p->pb.src.ratioHi << 16) | p->pb.src.ratioLo;
+            if (ratio == 0) ratio = 65536;
+
+            for (int s = 0; s < chunk; s++) {
+                int32_t sample = v->s0 + (((v->s1 - v->s0) * (int32_t)v->src_frac) >> 16);
+                mix_l[s] += (sample * vl) >> 15;
+                mix_r[s] += (sample * vr) >> 15;
+
+                v->src_frac += ratio;
+                while (v->src_frac >= 65536) {
+                    v->src_frac -= 65536;
+                    v->s0 = v->s1;
+                    v->s1 = voice_decode_next(i);
+                    if (!v->active) break;
+                }
+                if (!v->active) break;
+            }
+        }
+
+        for (int s = 0; s < chunk; s++) {
+            int32_t l = mix_l[s];
+            int32_t r = mix_r[s];
+            if (l > 32767) l = 32767;
+            else if (l < -32768) l = -32768;
+            if (r > 32767) r = 32767;
+            else if (r < -32768) r = -32768;
+            out[(frames_done + s) * 2 + 0] = (int16_t)l;
+            out[(frames_done + s) * 2 + 1] = (int16_t)r;
+        }
+
+        pthread_mutex_unlock(&s_audio_mutex);
+
+        frames_done += chunk;
+    }
+}
