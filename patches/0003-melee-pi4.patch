+static inline int16_t read_be16s(const uint8_t* p) {
+    uint16_t val;
+    memcpy(&val, p, sizeof(val));
+    return (int16_t)__builtin_bswap16(val);
+}
+
+static inline float read_be_float(const uint8_t* p) {
+    uint32_t val;
+    memcpy(&val, p, sizeof(val));
+    val = __builtin_bswap32(val);
+    float f;
+    memcpy(&f, &val, sizeof(f));
+    return f;
+}
+
+static inline void decode_pos_val_fast(const uint8_t* src, GXCompCnt comp_cnt, GXCompType comp_type, float scale, float out_pos[3]) {
+    out_pos[0] = 0.0f;
+    out_pos[1] = 0.0f;
+    out_pos[2] = 0.0f;
+    if (!src) return;
+
+    if (comp_type == GX_F32) {
+        out_pos[0] = read_be_float(&src[0]);
+        out_pos[1] = read_be_float(&src[4]);
+        if (comp_cnt == GX_POS_XYZ) out_pos[2] = read_be_float(&src[8]);
+    } else if (comp_type == GX_S16) {
+        out_pos[0] = (float)read_be16s(&src[0]) * scale;
+        out_pos[1] = (float)read_be16s(&src[2]) * scale;
+        if (comp_cnt == GX_POS_XYZ) out_pos[2] = (float)read_be16s(&src[4]) * scale;
+    } else if (comp_type == GX_U8) {
+        out_pos[0] = (float)src[0] * scale;
+        out_pos[1] = (float)src[1] * scale;
+        if (comp_cnt == GX_POS_XYZ) out_pos[2] = (float)src[2] * scale;
+    } else if (comp_type == GX_S8) {
+        out_pos[0] = (float)((int8_t)src[0]) * scale;
+        out_pos[1] = (float)((int8_t)src[1]) * scale;
+        if (comp_cnt == GX_POS_XYZ) out_pos[2] = (float)((int8_t)src[2]) * scale;
+    } else if (comp_type == GX_U16) {
+        out_pos[0] = (float)read_be16(&src[0]) * scale;
+        out_pos[1] = (float)read_be16(&src[2]) * scale;
+        if (comp_cnt == GX_POS_XYZ) out_pos[2] = (float)read_be16(&src[4]) * scale;
+    }
+}
+
+static inline void decode_pos_val(const uint8_t* src, GXCompCnt comp_cnt, GXCompType comp_type, uint8_t frac, float out_pos[3]) {
+    out_pos[0] = 0.0f;
+    out_pos[1] = 0.0f;
+    out_pos[2] = 0.0f;
+    if (!src) return;
+
+    float scale = (frac > 0) ? (1.0f / (float)(1 << frac)) : 1.0f;
+    int ncomp = (comp_cnt == GX_POS_XYZ) ? 3 : 2;
+
+    switch (comp_type) {
+        case GX_U8:
+            for (int i = 0; i < ncomp; i++) out_pos[i] = (float)src[i] * scale;
+            break;
+        case GX_S8:
+            for (int i = 0; i < ncomp; i++) out_pos[i] = (float)((int8_t)src[i]) * scale;
+            break;
+        case GX_U16:
+            for (int i = 0; i < ncomp; i++) out_pos[i] = (float)read_be16(&src[i * 2]) * scale;
+            break;
+        case GX_S16:
+            for (int i = 0; i < ncomp; i++) out_pos[i] = (float)read_be16s(&src[i * 2]) * scale;
+            break;
+        case GX_F32:
+            for (int i = 0; i < ncomp; i++) out_pos[i] = read_be_float(&src[i * 4]);
+            break;
+        default:
+            break;
+    }
+}
+
+static inline void decode_nrm_val(const uint8_t* src, GXCompType comp_type, uint8_t frac, float out_nrm[3]) {
+    out_nrm[0] = 0.0f;
+    out_nrm[1] = 0.0f;
+    out_nrm[2] = 1.0f;
+    if (!src) return;
+
+    if (comp_type == GX_F32) {
+        out_nrm[0] = read_be_float(&src[0]);
+        out_nrm[1] = read_be_float(&src[4]);
+        out_nrm[2] = read_be_float(&src[8]);
+    } else if (comp_type == GX_S16) {
+        float s = (frac > 0) ? (1.0f / (float)(1 << frac)) : (1.0f / 32768.0f);
+        out_nrm[0] = (float)read_be16s(&src[0]) * s;
+        out_nrm[1] = (float)read_be16s(&src[2]) * s;
+        out_nrm[2] = (float)read_be16s(&src[4]) * s;
+    } else if (comp_type == GX_S8) {
+        float s = (frac > 0) ? (1.0f / (float)(1 << frac)) : (1.0f / 64.0f);
+        out_nrm[0] = (float)((int8_t)src[0]) * s;
+        out_nrm[1] = (float)((int8_t)src[1]) * s;
+        out_nrm[2] = (float)((int8_t)src[2]) * s;
+    }
+}
+
+static inline void decode_clr_val(const uint8_t* src, GXCompType comp_type, uint8_t out_col[4]) {
+    out_col[0] = 255;
+    out_col[1] = 255;
+    out_col[2] = 255;
+    out_col[3] = 255;
+    if (!src) return;
+
+    switch (comp_type) {
+        case GX_RGB565: {
+            uint16_t c = read_be16(src);
+            out_col[0] = ((c >> 11) & 0x1F) * 255 / 31;
+            out_col[1] = ((c >> 5)  & 0x3F) * 255 / 63;
+            out_col[2] = (c         & 0x1F) * 255 / 31;
+            out_col[3] = 255;
+            break;
+        }
+        case GX_RGBA4: {
+            uint16_t c = read_be16(src);
+            out_col[0] = ((c >> 12) & 0x0F) * 255 / 15;
+            out_col[1] = ((c >> 8)  & 0x0F) * 255 / 15;
+            out_col[2] = ((c >> 4)  & 0x0F) * 255 / 15;
+            out_col[3] = (c         & 0x0F) * 255 / 15;
+            break;
+        }
+        case GX_RGB8:
+            out_col[0] = src[0];
+            out_col[1] = src[1];
+            out_col[2] = src[2];
+            out_col[3] = 255;
+            break;
+        case GX_RGBA6: {
+            uint32_t c = ((uint32_t)src[0] << 16) | ((uint32_t)src[1] << 8) | src[2];
+            out_col[0] = (uint8_t)((((c >> 18) & 0x3F) * 255) / 63);
+            out_col[1] = (uint8_t)((((c >> 12) & 0x3F) * 255) / 63);
+            out_col[2] = (uint8_t)((((c >> 6)  & 0x3F) * 255) / 63);
+            out_col[3] = (uint8_t)((((c)       & 0x3F) * 255) / 63);
+            break;
+        }
+        case GX_RGBX8:
+            out_col[0] = src[0];
+            out_col[1] = src[1];
+            out_col[2] = src[2];
+            out_col[3] = 255;
+            break;
+        case GX_RGBA8:
+            out_col[0] = src[0];
+            out_col[1] = src[1];
+            out_col[2] = src[2];
+            out_col[3] = src[3];
+            break;
+        default:
+            out_col[0] = src[0];
+            out_col[1] = src[1];
+            out_col[2] = src[2];
+            out_col[3] = src[3];
+            break;
+    }
+}
+
+static inline void decode_tex_val(const uint8_t* src, GXCompCnt comp_cnt, GXCompType comp_type, uint8_t frac, float out_tex[2]) {
+    out_tex[0] = 0.0f;
+    out_tex[1] = 0.0f;
+    if (!src) return;
+
+    float scale = (frac > 0) ? (1.0f / (float)(1 << frac)) : 1.0f;
+    int ncomp = (comp_cnt == GX_TEX_ST) ? 2 : 1;
+
+    switch (comp_type) {
+        case GX_U8:
+            for (int i = 0; i < ncomp; i++) out_tex[i] = (float)src[i] * scale;
+            break;
+        case GX_S8:
+            for (int i = 0; i < ncomp; i++) out_tex[i] = (float)((int8_t)src[i]) * scale;
+            break;
+        case GX_U16:
+            for (int i = 0; i < ncomp; i++) out_tex[i] = (float)read_be16(&src[i * 2]) * scale;
+            break;
+        case GX_S16:
+            for (int i = 0; i < ncomp; i++) out_tex[i] = (float)read_be16s(&src[i * 2]) * scale;
+            break;
+        case GX_F32:
+            for (int i = 0; i < ncomp; i++) out_tex[i] = read_be_float(&src[i * 4]);
+            break;
+        default:
+            break;
+    }
+}
+
+static inline void decode_nrm_val_fast(const uint8_t* src, GXCompType comp_type, float scale, float out_nrm[3]) {
+    out_nrm[0] = 0.0f;
+    out_nrm[1] = 0.0f;
+    out_nrm[2] = 1.0f;
+    if (!src) return;
+
+    if (comp_type == GX_F32) {
+        out_nrm[0] = read_be_float(&src[0]);
+        out_nrm[1] = read_be_float(&src[4]);
+        out_nrm[2] = read_be_float(&src[8]);
+    } else if (comp_type == GX_S16) {
+        out_nrm[0] = (float)read_be16s(&src[0]) * scale;
+        out_nrm[1] = (float)read_be16s(&src[2]) * scale;
+        out_nrm[2] = (float)read_be16s(&src[4]) * scale;
+    } else if (comp_type == GX_S8) {
+        out_nrm[0] = (float)((int8_t)src[0]) * scale;
+        out_nrm[1] = (float)((int8_t)src[1]) * scale;
+        out_nrm[2] = (float)((int8_t)src[2]) * scale;
+    }
+}
+
+static inline void decode_tex_val_fast(const uint8_t* src, GXCompCnt comp_cnt, GXCompType comp_type, float scale, float out_tex[2]) {
+    out_tex[0] = 0.0f;
+    out_tex[1] = 0.0f;
+    if (!src) return;
+
+    if (comp_type == GX_F32) {
+        out_tex[0] = read_be_float(&src[0]);
+        if (comp_cnt == GX_TEX_ST) out_tex[1] = read_be_float(&src[4]);
+    } else if (comp_type == GX_S16) {
+        out_tex[0] = (float)read_be16s(&src[0]) * scale;
+        if (comp_cnt == GX_TEX_ST) out_tex[1] = (float)read_be16s(&src[2]) * scale;
+    } else if (comp_type == GX_U16) {
+        out_tex[0] = (float)read_be16(&src[0]) * scale;
+        if (comp_cnt == GX_TEX_ST) out_tex[1] = (float)read_be16(&src[2]) * scale;
+    } else if (comp_type == GX_S8) {
+        out_tex[0] = (float)((int8_t)src[0]) * scale;
+        if (comp_cnt == GX_TEX_ST) out_tex[1] = (float)((int8_t)src[1]) * scale;
+    } else if (comp_type == GX_U8) {
+        out_tex[0] = (float)src[0] * scale;
+        if (comp_cnt == GX_TEX_ST) out_tex[1] = (float)src[1] * scale;
+    }
+}
+
+static inline void decode_clr_val_fast(const uint8_t* src, GXCompType comp_type, uint8_t out_col[4]) {
+    if (!src) return;
+    if (comp_type == GX_RGBA8) {
+        memcpy(out_col, src, 4);
+        return;
+    }
+    decode_clr_val(src, comp_type, out_col);
+}
+
+static inline bool is_bad_pos(const float pos[3]) {
+    union { float f; uint32_t u; } u0 = { pos[0] }, u1 = { pos[1] }, u2 = { pos[2] };
+    return (((u0.u & 0x7F800000U) == 0x7F800000U) ||
+            ((u1.u & 0x7F800000U) == 0x7F800000U) ||
+            ((u2.u & 0x7F800000U) == 0x7F800000U));
+}
+
+
+static int get_direct_size(GXAttr attr, GXCompCnt cnt, GXCompType type) {
+    if (attr == GX_VA_POS) {
+        int n = (cnt == GX_POS_XYZ) ? 3 : 2;
+        int sz = (type == GX_F32) ? 4 : ((type == GX_U16 || type == GX_S16) ? 2 : 1);
+        return n * sz;
+    } else if (attr == GX_VA_NRM) {
+        int sz = (type == GX_F32) ? 4 : ((type == GX_S16) ? 2 : 1);
+        return 3 * sz;
+    } else if (attr == GX_VA_NBT) {
+        int sz = (type == GX_F32) ? 4 : ((type == GX_S16) ? 2 : 1);
+        return 9 * sz;
+    } else if (attr == GX_VA_CLR0 || attr == GX_VA_CLR1) {
+        switch (type) {
+            case GX_RGB565:
+            case GX_RGBA4:  return 2;
+            case GX_RGB8:
+            case GX_RGBA6:  return 3;
+            case GX_RGBX8:
+            case GX_RGBA8:  return 4;
+            default:        return 4;
+        }
+    } else if (attr >= GX_VA_TEX0 && attr <= GX_VA_TEX7) {
+        int n = (cnt == GX_TEX_ST) ? 2 : 1;
+        int sz = (type == GX_F32) ? 4 : ((type == GX_U16 || type == GX_S16) ? 2 : 1);
+        return n * sz;
+    }
+    return 0;
+}
+
+void GXLoadPosMtxImm(const void* mtx_ptr, u32 id) {
+    if (id >= 64) id = 0;
+    const float (*mtx)[4] = (const float (*)[4])mtx_ptr;
+    float* m = s_pos_matrices[id];
+    /* Convert 3x4 row-major modelview to 4x4 column-major */
+    m[0]  = mtx[0][0]; m[1]  = mtx[1][0]; m[2]  = mtx[2][0]; m[3]  = 0.0f;
+    m[4]  = mtx[0][1]; m[5]  = mtx[1][1]; m[6]  = mtx[2][1]; m[7]  = 0.0f;
+    m[8]  = mtx[0][2]; m[9]  = mtx[1][2]; m[10] = mtx[2][2]; m[11] = 0.0f;
+    m[12] = mtx[0][3]; m[13] = mtx[1][3]; m[14] = mtx[2][3]; m[15] = 1.0f;
+    if (id == s_current_mtx_id) {
+        memcpy(s_modelview, m, sizeof(s_modelview));
+        update_mvp();
+    }
+}
+
+void GXLoadNrmMtxImm(const void* mtx, u32 id) {
+    if (mtx && id < 64) {
+        const float (*m)[4] = (const float (*)[4])mtx;
+        s_nrm_matrices[id][0][0] = m[0][0];
+        s_nrm_matrices[id][0][1] = m[0][1];
+        s_nrm_matrices[id][0][2] = m[0][2];
+        s_nrm_matrices[id][1][0] = m[1][0];
+        s_nrm_matrices[id][1][1] = m[1][1];
+        s_nrm_matrices[id][1][2] = m[1][2];
+        s_nrm_matrices[id][2][0] = m[2][0];
+        s_nrm_matrices[id][2][1] = m[2][1];
+        s_nrm_matrices[id][2][2] = m[2][2];
+        s_nrm_matrix_valid[id] = true;
+    }
+}
+
+void GXSetCurrentMtx(uint32_t id) {
+    if (id >= 64) id = 0;
+    s_current_mtx_id = id;
+    memcpy(s_modelview, s_pos_matrices[id], sizeof(s_modelview));
+    update_mvp();
+}
