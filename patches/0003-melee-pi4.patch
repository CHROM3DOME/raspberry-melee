+void Port_PinThreadToCore(int core_id) {
+#if defined(__linux__) && defined(_GNU_SOURCE)
+    cpu_set_t cpuset;
+    CPU_ZERO(&cpuset);
+    CPU_SET(core_id, &cpuset);
+    if (pthread_setaffinity_np(pthread_self(), sizeof(cpu_set_t), &cpuset) == 0) {
+        fprintf(stderr, "[Melee-Multicore] Pinned thread to CPU Core %d\n", core_id);
