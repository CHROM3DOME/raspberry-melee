+void GXCallDisplayList(const void* list, uint32_t nbytes) {
+    if (!list || nbytes < 3) return;
+
+    s_acc_dl_calls++;
+    bool profile_this_frame = (s_frame_num == 30 || s_frame_num == 60 || s_frame_num == 100);
+    struct timespec dl_start, dl_end;
+    if (__builtin_expect(profile_this_frame, 0)) {
+        clock_gettime(CLOCK_MONOTONIC, &dl_start);
+    }
+
+    static int s_dl_call_count = 0;
+    const uint8_t* dl = (const uint8_t*)list;
+    if (s_dl_call_count < 10) {
+        ++s_dl_call_count;
+        if (nbytes >= 8) {
+            fprintf(stderr, "[Melee-GX] GXCallDisplayList (#%d): list=%p, nbytes=%u, b[0..7]=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+                    s_dl_call_count, list, nbytes, dl[0], dl[1], dl[2], dl[3], dl[4], dl[5], dl[6], dl[7]);
+        } else {
+            fprintf(stderr, "[Melee-GX] GXCallDisplayList (#%d): list=%p, nbytes=%u\n",
+                    s_dl_call_count, list, nbytes);
+        }
+        fflush(stderr);
+    }
+
+    s_in_display_list = true;
+    uint32_t offset = 0;
+
+    uint8_t default_col[4];
+    port_gx_get_default_vtx_color(default_col);
+    uint32_t default_col_u32 = *(const uint32_t*)default_col;
+    bool tev_uses_ras = port_gx_tev_uses_ras();
+
+    if (__builtin_expect(s_cached_lighting.gen != s_lighting_state_gen, 0)) {
+        s_cached_lighting.gen = s_lighting_state_gen;
+        s_cached_lighting.chan_enable = (s_chan_ctrl[0].enable != GX_DISABLE);
+        s_cached_lighting.num_lights = 0;
+        s_cached_lighting.amb_r = 0.62f;
+        s_cached_lighting.amb_g = 0.62f;
+        s_cached_lighting.amb_b = 0.62f;
+        s_cached_lighting.default_mat_r = (float)default_col[0] * (1.0f / 255.0f);
+        s_cached_lighting.default_mat_g = (float)default_col[1] * (1.0f / 255.0f);
+        s_cached_lighting.default_mat_b = (float)default_col[2] * (1.0f / 255.0f);
+
+        if (s_cached_lighting.chan_enable) {
+            u32 mask = s_chan_ctrl[0].light_mask;
+            for (int li = 0; li < 8; li++) {
+                if (mask & (1 << li)) {
+                    if (s_gx_lights[li].active) {
+                        float lx = s_gx_lights[li].pos[0];
+                        float ly = s_gx_lights[li].pos[1];
+                        float lz = s_gx_lights[li].pos[2];
+                        float len_sq = lx*lx + ly*ly + lz*lz;
+                        int nl = s_cached_lighting.num_lights;
+                        if (len_sq > 0.0001f) {
+                            float inv_len = 1.0f / sqrtf(len_sq);
+                            s_cached_lighting.light_dirs[nl][0] = lx * inv_len;
+                            s_cached_lighting.light_dirs[nl][1] = ly * inv_len;
+                            s_cached_lighting.light_dirs[nl][2] = lz * inv_len;
+                        } else {
+                            float dx = -s_gx_lights[li].dir[0];
+                            float dy = -s_gx_lights[li].dir[1];
+                            float dz = -s_gx_lights[li].dir[2];
+                            float dlen = sqrtf(dx*dx + dy*dy + dz*dz);
+                            if (dlen > 0.0001f) {
+                                float inv_d = 1.0f / dlen;
+                                s_cached_lighting.light_dirs[nl][0] = dx * inv_d;
+                                s_cached_lighting.light_dirs[nl][1] = dy * inv_d;
+                                s_cached_lighting.light_dirs[nl][2] = dz * inv_d;
+                            } else {
+                                s_cached_lighting.light_dirs[nl][0] = 0.0f;
+                                s_cached_lighting.light_dirs[nl][1] = 0.7071f;
+                                s_cached_lighting.light_dirs[nl][2] = 0.7071f;
+                            }
+                        }
