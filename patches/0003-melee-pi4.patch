+        }
+        s_playback_file = fopen(s_playback_path, "r");
+        if (s_playback_file) {
+            s_playback_enabled = 1;
+            fprintf(stderr, "[Melee-Pad] Input playback active. Reading from '%s'\n", s_playback_path);
+        } else {
+            fprintf(stderr, "[Melee-Pad] Warning: Could not open playback file '%s' for reading: %s\n", s_playback_path, strerror(errno));
+            s_playback_enabled = 0;
+        }
+    } else {
+        s_playback_enabled = 0;
+    }
+
+    Port_Net_Init();
