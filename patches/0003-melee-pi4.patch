+
+#define STBI_ONLY_JPEG
+#define STB_IMAGE_IMPLEMENTATION
+#include "pc/stb_image.h"
+
+static uint8_t* reinflate_thp_jpeg(const uint8_t* src, size_t src_size, size_t* out_size) {
+    if (!src || src_size < 4) return NULL;
+
+    const uint8_t* p = src;
+    size_t soi_off = 0;
+    while (soi_off + 1 < src_size && soi_off < 64) {
+        if (p[soi_off] == 0xFF && p[soi_off + 1] == 0xD8) break;
+        soi_off++;
+    }
+    if (soi_off >= 64 || soi_off + 1 >= src_size) soi_off = 0;
+
+    size_t sos_off = soi_off + 2;
+    size_t scan_start = 0;
+    while (sos_off + 3 < src_size) {
+        if (p[sos_off] == 0xFF && p[sos_off + 1] == 0xDA) {
+            uint16_t sos_len = ((uint16_t)p[sos_off + 2] << 8) | p[sos_off + 3];
+            scan_start = sos_off + 2 + sos_len;
+            break;
+        }
+        sos_off++;
+    }
+    if (scan_start == 0 || scan_start >= src_size) return NULL;
+
+    /* Find true EOI (0xFF 0xD9) in the stream by scanning backwards from end of frame */
+    size_t end_pos = (src_size >= 2) ? (src_size - 2) : 0;
+    for (size_t i = end_pos; i >= scan_start; i--) {
+        if (p[i] == 0xFF && p[i + 1] == 0xD9) {
+            end_pos = i;
+            break;
+        }
+    }
+
+    size_t cap = src_size * 2 + 4096;
+    uint8_t* dst = (uint8_t*)malloc(cap);
+    if (!dst) return NULL;
+
+    memcpy(dst, p + soi_off, scan_start - soi_off);
+    size_t out_len = scan_start - soi_off;
+
+    size_t in_pos = scan_start;
+    while (in_pos < end_pos) {
+        uint8_t b = p[in_pos++];
+        dst[out_len++] = b;
+        if (b == 0xFF) {
+            /* GameCube Motion-JPEG unstuffed 0xFF: unconditionally insert 0x00 byte-stuffing */
+            dst[out_len++] = 0x00;
+        }
+    }
+
+    dst[out_len++] = 0xFF;
+    dst[out_len++] = 0xD9;
+    *out_size = out_len;
+    return dst;
+}
+
+void pc_thp_decode_frame(const void* jpeg, size_t sz, void* tile_y, void* tile_u, void* tile_v) {
+    if (!jpeg || !tile_y) return;
+
+    if (sz == 0) {
+        sz = __builtin_bswap32(*(const uint32_t*)((const uint8_t*)jpeg - 4));
+        if (sz == 0 || sz > 16 * 1024 * 1024) {
+            sz = 2 * 1024 * 1024;
+        }
+    }
+
+    size_t reinflated_sz = 0;
+    uint8_t* reinflated = reinflate_thp_jpeg((const uint8_t*)jpeg, sz, &reinflated_sz);
+    if (!reinflated) return;
+
+    int w = 0, h = 0, comp = 0;
+    if (tile_u && tile_v) {
+        unsigned char* img = stbi_load_from_memory(reinflated, (int)reinflated_sz, &w, &h, &comp, 3);
+        free(reinflated);
+        if (!img || w <= 0 || h <= 0) {
+            if (img) stbi_image_free(img);
+            return;
+        }
+
+        static int s_thp_decode_logs = 0;
+        if (++s_thp_decode_logs <= 5 || (s_thp_decode_logs % 60) == 0) {
+            fprintf(stderr, "[Melee-THP] Decoded JPEG frame %dx%d (total frames=%d, mode=YUV)\n",
+                    w, h, s_thp_decode_logs);
+            fflush(stderr);
+        }
+
+        /* Convert RGB to GameCube GX_TF_I8 8x4 tiled Y plane (w x h) */
+        uint8_t* out_y = (uint8_t*)tile_y;
+        for (int ty = 0; ty < h; ty += 4) {
+            for (int tx = 0; tx < w; tx += 8) {
+                for (int y = 0; y < 4; y++) {
+                    for (int x = 0; x < 8; x++) {
+                        int px = tx + x;
+                        int py = ty + y;
+                        if (px < w && py < h) {
+                            int idx = (py * w + px) * 3;
+                            int r = img[idx];
+                            int g = img[idx + 1];
+                            int b = img[idx + 2];
+                            *out_y++ = (uint8_t)(((66 * r + 129 * g + 25 * b + 128) >> 8) + 16);
+                        } else {
+                            *out_y++ = 16;
+                        }
+                    }
+                }
+            }
+        }
+
+        /* Convert RGB to GameCube GX_TF_I8 8x4 tiled U & V planes (w/2 x h/2) */
+        int uw = (w + 1) / 2;
+        int uh = (h + 1) / 2;
+        uint8_t* out_u = (uint8_t*)tile_u;
+        uint8_t* out_v = (uint8_t*)tile_v;
+
+        for (int ty = 0; ty < uh; ty += 4) {
+            for (int tx = 0; tx < uw; tx += 8) {
+                for (int y = 0; y < 4; y++) {
+                    for (int x = 0; x < 8; x++) {
+                        int px = tx + x;
+                        int py = ty + y;
+                        if (px < uw && py < uh) {
+                            int orig_x = px * 2;
+                            int orig_y = py * 2;
+                            int idx = (orig_y * w + orig_x) * 3;
+                            int r = img[idx];
+                            int g = img[idx + 1];
+                            int b = img[idx + 2];
+                            *out_u++ = (uint8_t)(((-38 * r - 74 * g + 112 * b + 128) >> 8) + 128);
+                            *out_v++ = (uint8_t)(((112 * r - 94 * g - 18 * b + 128) >> 8) + 128);
+                        } else {
+                            *out_u++ = 128;
+                            *out_v++ = 128;
+                        }
+                    }
+                }
+            }
+        }
+        stbi_image_free(img);
+        Port_GX_InvalidateTex(tile_u);
+        Port_GX_InvalidateTex(tile_v);
+    } else {
+        /* Direct Linear RGBA decoding: decode JPEG directly into 32-bit RGBA pixels */
+        unsigned char* img = stbi_load_from_memory(reinflated, (int)reinflated_sz, &w, &h, &comp, 4);
+        free(reinflated);
+        if (!img || w <= 0 || h <= 0) {
+            if (img) stbi_image_free(img);
+            return;
+        }
+
+        static int s_thp_decode_logs = 0;
+        if (++s_thp_decode_logs <= 5 || (s_thp_decode_logs % 60) == 0) {
+            fprintf(stderr, "[Melee-THP] Decoded JPEG frame %dx%d (total frames=%d, mode=RGBA8_LINEAR)\n",
+                    w, h, s_thp_decode_logs);
+            fflush(stderr);
+        }
+
+        memcpy(tile_y, img, (size_t)w * h * 4);
+        stbi_image_free(img);
+    }
+
+    Port_GX_InvalidateTex(tile_y);
+}
