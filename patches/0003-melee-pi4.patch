diff --git a/src/port/disc_support.c b/src/port/disc_support.c
new file mode 100755
index 0000000..8dbf769
--- /dev/null
+++ b/src/port/disc_support.c
@@ -0,0 +1,32 @@
+#include "port/disc.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#define MAX_EXT_PTRS 4096
+static const void* s_ext_ptrs[MAX_EXT_PTRS];
+static uint32_t    s_num_ext_ptrs = 0;
+
+uint32_t pc_register_ext_ptr(const void* p) {
+    if (!p) return 0;
+    for (uint32_t i = 1; i <= s_num_ext_ptrs; i++) {
+        if (s_ext_ptrs[i] == p) return i;
+    }
+    if (s_num_ext_ptrs + 1 < MAX_EXT_PTRS) {
+        s_num_ext_ptrs++;
+        s_ext_ptrs[s_num_ext_ptrs] = p;
+        return s_num_ext_ptrs;
+    }
+    return 0;
+}
+
+void* pc_resolve_ext_ptr(uint32_t id) {
+    if (id > 0 && id <= s_num_ext_ptrs) {
+        return (void*)s_ext_ptrs[id];
+    }
+    return NULL;
+}
+
+void pc_disc_ptr_overflow(const void* p, const char* file, int line) {
+    fprintf(stderr, "[Melee-Disc] Fatal disc pointer overflow: %p at %s:%d\n", p, file, line);
+    abort();
+}
