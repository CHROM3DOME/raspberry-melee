+static inline void port_gx_lookup_array_texcoord(uint32_t index) {
+    GXAttr attr = s_imm_tex_attr;
+    if (s_imm_tex_attr < GX_VA_TEX7) {
+        s_imm_tex_attr++;
+    }
+    if (!s_array_ptrs[attr] && s_array_ptrs[GX_VA_TEX0]) {
+        attr = GX_VA_TEX0;
+    }
+    if (s_array_ptrs[attr]) {
+        VtxFmtAttr fmt = s_vtx_fmt[s_current_vtx_fmt][attr];
+        if (fmt.comp_type == 0 && s_current_vtx_fmt != GX_VTXFMT0) {
+            fmt = s_vtx_fmt[GX_VTXFMT0][attr];
+        }
+        uint8_t stride = s_array_strides[attr];
+        if (!stride) {
+            int ncomp = (fmt.comp_cnt == GX_TEX_ST) ? 2 : 1;
+            int csz = (fmt.comp_type == GX_F32) ? 4 : ((fmt.comp_type == GX_S16 || fmt.comp_type == GX_U16) ? 2 : 1);
+            stride = ncomp * csz;
+            if (!stride) stride = 4;
+        }
+        uint32_t offset = index * stride;
+        if (s_array_sizes[attr] > 0 && offset + stride > s_array_sizes[attr]) {
+            return;
+        }
+        const uint8_t* p = (const uint8_t*)s_array_ptrs[attr] + offset;
+        float st[2] = {0.0f, 0.0f};
+        decode_tex_val(p, fmt.comp_cnt, fmt.comp_type, fmt.frac, st);
+
+        int coord_id = attr - GX_VA_TEX0;
+        if (coord_id < 0 || coord_id >= 8) coord_id = 0;
+        port_gx_transform_texcoord(coord_id, GX_IDENTITY, st[0], st[1], &st[0], &st[1]);
+
+
+        if (coord_id == s_active_tex_coord || coord_id == 0) {
+            s_current_vtx.tex[0] = st[0];
+            s_current_vtx.tex[1] = st[1];
+            if (s_vert_count > 0) {
+                s_vert_buffer[s_vert_count - 1].tex[0] = st[0];
+                s_vert_buffer[s_vert_count - 1].tex[1] = st[1];
+            }
+        }
+    }
+}
