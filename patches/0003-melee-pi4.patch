+void Port_GX_Shutdown(void) {
+    if (!s_gx_ready) return;
+    s_gx_ready = false;
+
+    if (Port_RenderThread_IsEnabled()) {
+        Port_RenderThread_Shutdown();
+    }
+
+    if (s_program) {
+        glDeleteProgram(s_program);
+        s_program = 0;
+    }
+    if (s_program_fast) {
+        glDeleteProgram(s_program_fast);
+        s_program_fast = 0;
+    }
+
+    if (s_gl_context) {
+        SDL_GL_DeleteContext(s_gl_context);
+        s_gl_context = NULL;
+    }
+
+#if defined(TARGET_PI_ARM) && !defined(TARGET_PI4)
+    if (s_dmx_element) {
+        DISPMANX_UPDATE_HANDLE_T update = vc_dispmanx_update_start(0);
+        vc_dispmanx_element_remove(update, s_dmx_element);
+        vc_dispmanx_resource_delete(s_dmx_resource);
+        vc_dispmanx_display_close(s_dmx_display);
+        vc_dispmanx_update_submit_sync(update);
+        s_dmx_element = 0;
+        s_dmx_resource = 0;
+        s_dmx_display = 0;
+    }
+#endif
+
+    Port_PAD_ResumeES();
+}
