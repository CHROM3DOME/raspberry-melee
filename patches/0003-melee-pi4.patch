+static inline uint16_t read_be16(const uint8_t* p) {
+    uint16_t val;
+    memcpy(&val, p, sizeof(val));
+    return __builtin_bswap16(val);
+}
+static inline uint32_t read_be32(const uint8_t* p) {
+    uint32_t val;
+    memcpy(&val, p, sizeof(val));
+    return __builtin_bswap32(val);
+}
+
+#define MAKE_RGBA(r, g, b, a) \
+    (((uint32_t)(uint8_t)(a) << 24) | ((uint32_t)(uint8_t)(b) << 16) | \
+     ((uint32_t)(uint8_t)(g) << 8)  | ((uint32_t)(uint8_t)(r)))
+
+static const uint8_t s_scale_5_to_8[32] = {0, 8, 16, 24, 32, 41, 49, 57, 65, 74, 82, 90, 98, 106, 115, 123, 131, 139, 148, 156, 164, 172, 180, 189, 197, 205, 213, 222, 230, 238, 246, 255};
+static const uint8_t s_scale_6_to_8[64] = {0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48, 52, 56, 60, 64, 68, 72, 76, 80, 85, 89, 93, 97, 101, 105, 109, 113, 117, 121, 125, 129, 133, 137, 141, 145, 149, 153, 157, 161, 165, 170, 174, 178, 182, 186, 190, 194, 198, 202, 206, 210, 214, 218, 222, 226, 230, 234, 238, 242, 246, 250, 255};
+static const uint8_t s_scale_4_to_8[16] = {0, 17, 34, 51, 68, 85, 102, 119, 136, 153, 170, 187, 204, 221, 238, 255};
+static const uint8_t s_scale_3_to_8[8]  = {0, 36, 72, 109, 145, 182, 218, 255};
+
+static inline uint32_t decode_rgb565(uint16_t c) {
+    uint32_t r = s_scale_5_to_8[(c >> 11) & 0x1F];
+    uint32_t g = s_scale_6_to_8[(c >> 5) & 0x3F];
+    uint32_t b = s_scale_5_to_8[c & 0x1F];
+    return MAKE_RGBA(r, g, b, 0xFF);
+}
+
+static void decode_cmpr(const uint8_t* src, uint32_t* dst, int w, int h) {
+    int sub_x_off[4] = {0, 4, 0, 4};
+    int sub_y_off[4] = {0, 0, 4, 4};
+    const uint8_t* block = src;
+
+    for (int ty = 0; ty < h; ty += 8) {
+        for (int tx = 0; tx < w; tx += 8) {
+            for (int sub = 0; sub < 4; sub++) {
+                uint16_t c0 = read_be16(block);
+                uint16_t c1 = read_be16(block + 2);
+                uint32_t bits = read_be32(block + 4);
+                block += 8;
+
+                uint32_t r0 = s_scale_5_to_8[(c0 >> 11) & 0x1F];
+                uint32_t g0 = s_scale_6_to_8[(c0 >> 5) & 0x3F];
+                uint32_t b0 = s_scale_5_to_8[c0 & 0x1F];
+
+                uint32_t r1 = s_scale_5_to_8[(c1 >> 11) & 0x1F];
+                uint32_t g1 = s_scale_6_to_8[(c1 >> 5) & 0x3F];
+                uint32_t b1 = s_scale_5_to_8[c1 & 0x1F];
+
+                uint32_t col[4];
+                col[0] = MAKE_RGBA(r0, g0, b0, 0xFF);
+                col[1] = MAKE_RGBA(r1, g1, b1, 0xFF);
+
+                if (c0 > c1) {
+                    uint32_t r2 = (2 * r0 + r1) * 683 >> 11;
+                    uint32_t g2 = (2 * g0 + g1) * 683 >> 11;
+                    uint32_t b2 = (2 * b0 + b1) * 683 >> 11;
+                    uint32_t r3 = (r0 + 2 * r1) * 683 >> 11;
+                    uint32_t g3 = (g0 + 2 * g1) * 683 >> 11;
+                    uint32_t b3 = (b0 + 2 * b1) * 683 >> 11;
+                    col[2] = MAKE_RGBA(r2, g2, b2, 0xFF);
+                    col[3] = MAKE_RGBA(r3, g3, b3, 0xFF);
+                } else {
+                    uint32_t r2 = (r0 + r1) >> 1;
+                    uint32_t g2 = (g0 + g1) >> 1;
+                    uint32_t b2 = (b0 + b1) >> 1;
+                    col[2] = MAKE_RGBA(r2, g2, b2, 0xFF);
+                    col[3] = MAKE_RGBA(r2, g2, b2, 0);
+                }
+
+                int bx = tx + sub_x_off[sub];
+                int by = ty + sub_y_off[sub];
+
+                for (int y = 0; y < 4; y++) {
+                    for (int x = 0; x < 4; x++) {
+                        int sel = (bits >> (30 - 2 * (y * 4 + x))) & 3;
+                        int px = bx + x;
+                        int py = by + y;
+                        if (px < w && py < h) {
+                            dst[py * w + px] = col[sel];
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_rgb5a3(const uint8_t* src, uint32_t* dst, int w, int h) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 4) {
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 4; x++) {
+                    uint16_t val = read_be16(p);
+                    p += 2;
+                    uint32_t r, g, b, a;
+                    if (val & 0x8000) {
+                        r = s_scale_5_to_8[(val >> 10) & 0x1F];
+                        g = s_scale_5_to_8[(val >> 5) & 0x1F];
+                        b = s_scale_5_to_8[val & 0x1F];
+                        a = 0xFF;
+                    } else {
+                        a = s_scale_3_to_8[(val >> 12) & 0x07];
+                        r = s_scale_4_to_8[(val >> 8) & 0x0F];
+                        g = s_scale_4_to_8[(val >> 4) & 0x0F];
+                        b = s_scale_4_to_8[val & 0x0F];
+                    }
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = MAKE_RGBA(r, g, b, a);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_rgba8(const uint8_t* src, uint32_t* dst, int w, int h) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 4) {
+            const uint8_t* ar = p;
+            const uint8_t* gb = p + 32;
+            p += 64;
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 4; x++) {
+                    int idx = (y * 4 + x) * 2;
+                    uint8_t a = ar[idx];
+                    uint8_t r = ar[idx + 1];
+                    uint8_t g = gb[idx];
+                    uint8_t b = gb[idx + 1];
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = MAKE_RGBA(r, g, b, a);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_i8(const uint8_t* src, uint32_t* dst, int w, int h) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 8) {
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 8; x++) {
+                    uint8_t val = *p++;
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = MAKE_RGBA(val, val, val, val);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_rgb565_tex(const uint8_t* src, uint32_t* dst, int w, int h) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 4) {
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 4; x++) {
+                    uint16_t val = read_be16(p);
+                    p += 2;
+                    uint32_t r = ((val >> 11) & 0x1F) * 255 / 31;
+                    uint32_t g = ((val >> 5)  & 0x3F) * 255 / 63;
+                    uint32_t b = (val & 0x1F) * 255 / 31;
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = MAKE_RGBA(r, g, b, 0xFF);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_ia8_tex(const uint8_t* src, uint32_t* dst, int w, int h) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 4) {
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 4; x++) {
+                    uint8_t a = *p++;
+                    uint8_t i = *p++;
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = MAKE_RGBA(i, i, i, a);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_ia4_tex(const uint8_t* src, uint32_t* dst, int w, int h) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 8) {
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 8; x++) {
+                    uint8_t val = *p++;
+                    uint8_t a = ((val >> 4) & 0x0F) * 255 / 15;
+                    uint8_t i = (val & 0x0F) * 255 / 15;
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = MAKE_RGBA(i, i, i, a);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_i4_tex(const uint8_t* src, uint32_t* dst, int w, int h) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 8) {
+        for (int tx = 0; tx < w; tx += 8) {
+            for (int y = 0; y < 8; y++) {
+                for (int x = 0; x < 8; x += 2) {
+                    uint8_t val = *p++;
+                    uint8_t i0 = ((val >> 4) & 0x0F) * 255 / 15;
+                    uint8_t i1 = (val & 0x0F) * 255 / 15;
+                    int px0 = tx + x;
+                    int px1 = tx + x + 1;
+                    int py = ty + y;
+                    if (px0 < w && py < h) dst[py * w + px0] = MAKE_RGBA(i0, i0, i0, i0);
+                    if (px1 < w && py < h) dst[py * w + px1] = MAKE_RGBA(i1, i1, i1, i1);
+                }
+            }
+        }
+    }
+}
+
+typedef struct {
+    const void* data;
+    uint32_t    format;
+    uint16_t    entries;
+} PortTlutEntry;
+
+static PortTlutEntry s_tlut_table[24];
+
+static inline uint32_t lookup_tlut(const PortTlutEntry* tlut, uint32_t idx) {
+    if (!tlut || !tlut->data) {
+        if (idx == 0) return 0x00000000;
+        return MAKE_RGBA(240, 200, 160, 0xFF);
+    }
+    uint32_t entries = tlut->entries ? tlut->entries : 256;
+    if (idx >= entries) {
+        idx = entries - 1;
+    }
+    const uint8_t* p = (const uint8_t*)tlut->data + idx * 2;
+    uint16_t val = ((uint16_t)p[0] << 8) | p[1];
+    if (tlut->format == 2) { /* GX_TL_RGB5A3 */
+        if (val & 0x8000) {
+            uint8_t r = ((val >> 10) & 0x1F) * 255 / 31;
+            uint8_t g = ((val >> 5)  & 0x1F) * 255 / 31;
+            uint8_t b = (val & 0x1F) * 255 / 31;
+            return MAKE_RGBA(r, g, b, 0xFF);
+        } else {
+            uint8_t a = ((val >> 12) & 0x07) * 255 / 7;
+            uint8_t r = ((val >> 8)  & 0x0F) * 255 / 15;
+            uint8_t g = ((val >> 4)  & 0x0F) * 255 / 15;
+            uint8_t b = (val & 0x0F) * 255 / 15;
+            return MAKE_RGBA(r, g, b, a);
+        }
+    } else if (tlut->format == 1) { /* GX_TL_RGB565 */
+        uint8_t r = ((val >> 11) & 0x1F) * 255 / 31;
+        uint8_t g = ((val >> 5)  & 0x3F) * 255 / 63;
+        uint8_t b = (val & 0x1F) * 255 / 31;
+        return MAKE_RGBA(r, g, b, 0xFF);
+    } else { /* GX_TL_IA8 */
+        uint8_t a = (val >> 8) & 0xFF;
+        uint8_t i = val & 0xFF;
+        return MAKE_RGBA(i, i, i, a);
+    }
+}
+
+static void decode_ci4_tex(const uint8_t* src, uint32_t* dst, int w, int h, const PortTlutEntry* tlut) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 8) {
+        for (int tx = 0; tx < w; tx += 8) {
+            for (int y = 0; y < 8; y++) {
+                for (int x = 0; x < 8; x += 2) {
+                    uint8_t val = *p++;
+                    uint8_t idx0 = (val >> 4) & 0x0F;
+                    uint8_t idx1 = val & 0x0F;
+                    int px0 = tx + x;
+                    int px1 = tx + x + 1;
+                    int py = ty + y;
+                    if (px0 < w && py < h) dst[py * w + px0] = lookup_tlut(tlut, idx0);
+                    if (px1 < w && py < h) dst[py * w + px1] = lookup_tlut(tlut, idx1);
+                }
+            }
+        }
+    }
+}
+
+static void decode_ci8_tex(const uint8_t* src, uint32_t* dst, int w, int h, const PortTlutEntry* tlut) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 8) {
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 8; x++) {
+                    uint8_t idx = *p++;
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = lookup_tlut(tlut, idx);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_ci14x2_tex(const uint8_t* src, uint32_t* dst, int w, int h, const PortTlutEntry* tlut) {
+    const uint8_t* p = src;
+    for (int ty = 0; ty < h; ty += 4) {
+        for (int tx = 0; tx < w; tx += 4) {
+            for (int y = 0; y < 4; y++) {
+                for (int x = 0; x < 4; x++) {
+                    uint16_t val = read_be16(p);
+                    p += 2;
+                    int px = tx + x;
+                    int py = ty + y;
+                    if (px < w && py < h) {
+                        dst[py * w + px] = lookup_tlut(tlut, val & 0x3FFF);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void decode_texture(const void* src, uint32_t* dst, int w, int h, int fmt, const PortTlutEntry* tlut) {
+    if (!src || !dst || w <= 0 || h <= 0) return;
+    if (fmt == 0x3F) {
+        memcpy(dst, src, (size_t)w * h * sizeof(uint32_t));
+        return;
+    }
+    if (fmt == 0x0E) {
+        decode_cmpr((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x05) {
+        decode_rgb5a3((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x06) {
+        decode_rgba8((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x01) {
+        decode_i8((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x04) {
+        decode_rgb565_tex((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x03) {
+        decode_ia8_tex((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x02) {
+        decode_ia4_tex((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x00) {
+        decode_i4_tex((const uint8_t*)src, dst, w, h);
+    } else if (fmt == 0x08) {
+        decode_ci4_tex((const uint8_t*)src, dst, w, h, tlut);
+    } else if (fmt == 0x09) {
+        decode_ci8_tex((const uint8_t*)src, dst, w, h, tlut);
+    } else if (fmt == 0x0A) {
+        decode_ci14x2_tex((const uint8_t*)src, dst, w, h, tlut);
+    } else {
+        for (int i = 0; i < w * h; i++) dst[i] = 0x00000000;
+    }
+
+    if (s_num_cached_tex < 150) {
+        int zero_a = 0, full_a = 0;
+        for (int i = 0; i < w * h; i++) {
+            uint8_t a = (dst[i] >> 24) & 0xFF;
+            if (a == 0) zero_a++;
+            else if (a == 255) full_a++;
+        }
+        fprintf(stderr, "  [TexDec #%d] %dx%d fmt=0x%x zero_a=%d full_a=%d other_a=%d\n",
+                s_num_cached_tex, w, h, fmt, zero_a, full_a, (w * h) - zero_a - full_a);
+        fflush(stderr);
+    }
+}
+
+static void save_bmp(const char* filename, const uint32_t* pixels, int w, int h) {
+    uint8_t header[54];
+    memset(header, 0, sizeof(header));
+    header[0] = 'B';
+    header[1] = 'M';
+    uint32_t file_size = 54 + w * h * 4;
+    memcpy(&header[2], &file_size, 4);
+    uint32_t offset = 54;
+    memcpy(&header[10], &offset, 4);
+    uint32_t dib_size = 40;
+    memcpy(&header[14], &dib_size, 4);
+    memcpy(&header[18], &w, 4);
+    int32_t neg_h = -h;
+    memcpy(&header[22], &neg_h, 4);
+    uint16_t planes = 1;
+    memcpy(&header[26], &planes, 2);
+    uint16_t bpp = 32;
+    memcpy(&header[28], &bpp, 2);
+
+    FILE* f = fopen(filename, "wb");
+    if (f) {
+        fwrite(header, 1, 54, f);
+        fwrite(pixels, 4, w * h, f);
+        fclose(f);
+        int non_black = 0;
+        for (int i = 0; i < w * h; i++) {
+            if ((pixels[i] & 0x00FFFFFF) != 0) non_black++;
+        }
+        fprintf(stderr, "[Melee-GX] Screenshot saved: %s (%dx%d, %u bytes, non-black pixels: %d/%d)\n",
+                filename, w, h, (unsigned)file_size, non_black, w * h);
+        fflush(stderr);
+    } else {
+        fprintf(stderr, "[Melee-GX] Failed to open screenshot file '%s'\n", filename);
+    }
+}
+
+static void check_and_save_screenshot(int frame) {
+    const char* path = getenv("MELEE_SCREENSHOT_PATH");
+    if (!path) return;
+
+    int should_capture = 0;
+    const char* frames_str = getenv("MELEE_SCREENSHOT_FRAMES");
+    const char* interval_str = getenv("MELEE_SCREENSHOT_INTERVAL");
+    const char* frame_str = getenv("MELEE_SCREENSHOT_FRAME");
+
+    if (frames_str) {
+        char buf[512];
+        strncpy(buf, frames_str, sizeof(buf) - 1);
+        buf[sizeof(buf) - 1] = '\0';
+        char* token = strtok(buf, ", ");
+        while (token) {
+            if (atoi(token) == frame) {
+                should_capture = 1;
+                break;
+            }
+            token = strtok(NULL, ", ");
+        }
+    } else if (interval_str) {
+        int interval = atoi(interval_str);
+        const char* start_str = getenv("MELEE_SCREENSHOT_START");
+        int start_f = start_str ? atoi(start_str) : 300;
+        if (interval > 0 && frame >= start_f && ((frame - start_f) % interval == 0)) {
+            should_capture = 1;
+        }
+    } else {
+        int target = frame_str ? atoi(frame_str) : 300;
+        if (frame == target) {
+            should_capture = 1;
+        }
+    }
+
+    if (!should_capture) return;
+
+    char out_path[512];
+    if (strchr(path, '%')) {
+        snprintf(out_path, sizeof(out_path), path, frame);
+    } else if (frames_str || interval_str) {
+        char base[512];
+        strncpy(base, path, sizeof(base) - 1);
+        base[sizeof(base) - 1] = '\0';
+        char* ext = strrchr(base, '.');
+        if (ext && strcmp(ext, ".bmp") == 0) {
+            *ext = '\0';
+            snprintf(out_path, sizeof(out_path), "%s_f%04d.bmp", base, frame);
+        } else {
+            snprintf(out_path, sizeof(out_path), "%s_f%04d.bmp", base, frame);
+        }
+    } else {
+        snprintf(out_path, sizeof(out_path), "%s", path);
+    }
+
+    if (s_is_software_renderer) {
+        save_bmp(out_path, (const uint32_t*)s_soft_fb, s_fb_width, s_fb_height);
+    } else if (s_gl_context) {
+        uint32_t* pixels = (uint32_t*)malloc(s_fb_width * s_fb_height * sizeof(uint32_t));
+        if (pixels) {
+            glFinish();
+            glReadPixels(0, 0, s_fb_width, s_fb_height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+            uint32_t* flipped = (uint32_t*)malloc(s_fb_width * s_fb_height * sizeof(uint32_t));
+            if (flipped) {
+                for (int y = 0; y < s_fb_height; y++) {
+                    const uint8_t* src_row = (const uint8_t*)&pixels[(s_fb_height - 1 - y) * s_fb_width];
+                    uint8_t* dst_row = (uint8_t*)&flipped[y * s_fb_width];
+                    for (int x = 0; x < s_fb_width; x++) {
+                        dst_row[x * 4 + 0] = src_row[x * 4 + 2]; /* B */
+                        dst_row[x * 4 + 1] = src_row[x * 4 + 1]; /* G */
+                        dst_row[x * 4 + 2] = src_row[x * 4 + 0]; /* R */
+                        dst_row[x * 4 + 3] = src_row[x * 4 + 3]; /* A */
+                    }
+                }
+                save_bmp(out_path, flipped, s_fb_width, s_fb_height);
+                free(flipped);
+            }
+            free(pixels);
+        }
+    }
+    if (getenv("MELEE_SCREENSHOT_EXIT")) {
+        fprintf(stderr, "[Melee-GX] Screenshot frame %d saved to '%s'. Exiting (MELEE_SCREENSHOT_EXIT).\n", frame, out_path);
+        fflush(stderr);
+        Port_PAD_ResumeES();
+        _exit(0);
+    }
+}
