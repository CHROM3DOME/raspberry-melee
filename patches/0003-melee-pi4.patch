+int HSD_VIGetXFBDrawEnable(void)
+{
+    bool intr;
+    int idx = -1;
+
+    if (HSD_VIGetNbXFB() < 2) {
+        goto ret;
+    }
+
+    intr = OSDisableInterrupts();
+
+    if ((idx = HSD_VISearchXFBByStatus(HSD_VI_XFB_DRAWING)) == -1) {
+        if ((idx = HSD_VISearchXFBByStatus(HSD_VI_XFB_FREE)) != -1) {
+            _p->xfb[idx].status = HSD_VI_XFB_DRAWING;
+        }
+    }
+
+    OSRestoreInterrupts(intr);
+
+ret:
+    return idx;
+}
+
+int HSD_VIWaitXFBDrawEnable(void)
+{
+    int idx = -1;
+
+    if (HSD_VIGetNbXFB() < 2) {
+        goto ret;
+    }
+
+#ifdef TARGET_PC
+    /* On PC / Linux, rendering is synchronized by the dual-core pipeline and KMSDRM pageflips.
+     * Stalling Core 0 waiting for simulated GameCube CRT retrace wastes CPU time and quantizes to 30 FPS. */
+    idx = HSD_VIGetXFBDrawEnable();
+    if (idx != -1) return idx;
+    for (int i = 0; i < HSD_VI_XFB_MAX; i++) {
+        if (_p->xfb[i].buffer) {
+            _p->xfb[i].status = HSD_VI_XFB_DRAWING;
+            return i;
+        }
+    }
+#endif
+
+    int timeout = 0;
+    while ((idx = HSD_VIGetXFBDrawEnable()) == -1) {
+        if (++timeout > 120) {
+            break;
+        }
+        VIWaitForRetrace();
+    }
+
+ret:
+    return idx;
+}
