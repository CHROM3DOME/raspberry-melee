+void Port_Audio_Init(void) {
+    if (s_audio_dev != 0) return;
+
+    for (int i = 0; i < AX_MAX_VOICES; i++) {
+        memset(&s_voices[i], 0, sizeof(AXVPB));
+        s_voices[i].index = i;
+        s_voice_allocated[i] = false;
+        memset(&s_port_voices[i], 0, sizeof(PortVoice));
+    }
+
+    const char* env_audio = getenv("MELEE_AUDIO");
+    if (env_audio && atoi(env_audio) == 0) {
+        fprintf(stderr, "[Melee-Audio] Audio subsystem disabled (MELEE_AUDIO=0). Zero cycle overhead.\n");
+        return;
+    }
+
+    if (SDL_WasInit(SDL_INIT_AUDIO) == 0) {
+        SDL_InitSubSystem(SDL_INIT_AUDIO);
+    }
+
+    SDL_AudioSpec want, have;
+    memset(&want, 0, sizeof(want));
+    want.freq = 32000;
+    want.format = AUDIO_S16SYS;
+    want.channels = 2;
+    want.samples = 512;
+    const char* env_samples = getenv("MELEE_AUDIO_SAMPLES");
+    if (env_samples && atoi(env_samples) > 0) {
+        want.samples = (uint16_t)atoi(env_samples);
+    }
+    want.callback = sdl_audio_cb;
+
+    s_audio_dev = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);
+    if (s_audio_dev != 0) {
+        SDL_PauseAudioDevice(s_audio_dev, 0);
+        fprintf(stderr, "[Melee-Audio] SDL2 ALSA audio stream opened (%d Hz, %d channels, 64-voice mixer active).\n", have.freq, have.channels);
+    } else {
+        fprintf(stderr, "[Melee-Audio] SDL_OpenAudioDevice unavailable (%s), running silent.\n", SDL_GetError());
+    }
+}
