+static inline void evaluate_tev_color_arg(uint8_t arg,
+                                          uint8_t rasc_r, uint8_t rasc_g, uint8_t rasc_b, uint8_t rasc_a,
+                                          uint8_t texc_r, uint8_t texc_g, uint8_t texc_b, uint8_t texc_a,
+                                          const uint8_t regs[4][4],
+                                          const RenderDrawState* state,
+                                          int stage,
+                                          uint8_t* out_r, uint8_t* out_g, uint8_t* out_b) {
+    switch (arg) {
+        case GX_CC_CPREV:
+            *out_r = regs[GX_TEVPREV][0]; *out_g = regs[GX_TEVPREV][1]; *out_b = regs[GX_TEVPREV][2];
+            break;
+        case GX_CC_APREV:
+            *out_r = *out_g = *out_b = regs[GX_TEVPREV][3];
+            break;
+        case GX_CC_C0:
+            *out_r = regs[GX_TEVREG0][0]; *out_g = regs[GX_TEVREG0][1]; *out_b = regs[GX_TEVREG0][2];
+            break;
+        case GX_CC_A0:
+            *out_r = *out_g = *out_b = regs[GX_TEVREG0][3];
+            break;
+        case GX_CC_C1:
+            *out_r = regs[GX_TEVREG1][0]; *out_g = regs[GX_TEVREG1][1]; *out_b = regs[GX_TEVREG1][2];
+            break;
+        case GX_CC_A1:
+            *out_r = *out_g = *out_b = regs[GX_TEVREG1][3];
+            break;
+        case GX_CC_C2:
+            *out_r = regs[GX_TEVREG2][0]; *out_g = regs[GX_TEVREG2][1]; *out_b = regs[GX_TEVREG2][2];
+            break;
+        case GX_CC_A2:
+            *out_r = *out_g = *out_b = regs[GX_TEVREG2][3];
+            break;
+        case GX_CC_TEXC:
+            *out_r = texc_r; *out_g = texc_g; *out_b = texc_b;
+            break;
+        case GX_CC_TEXA:
+            *out_r = *out_g = *out_b = texc_a;
+            break;
+        case GX_CC_RASC:
+            *out_r = rasc_r; *out_g = rasc_g; *out_b = rasc_b;
+            break;
+        case GX_CC_RASA:
+            *out_r = *out_g = *out_b = rasc_a;
+            break;
+        case GX_CC_ONE:
+            *out_r = *out_g = *out_b = 255;
+            break;
+        case GX_CC_HALF:
+            *out_r = *out_g = *out_b = 128;
+            break;
+        case GX_CC_KONST: {
+            uint8_t kcsel = state ? state->tev_kcsel[stage] : 0;
+            get_tev_konst_color(kcsel, state, out_r, out_g, out_b);
+            break;
+        }
+        case GX_CC_ZERO:
+        default:
+            *out_r = *out_g = *out_b = 0;
+            break;
+    }
+}
+
+static inline uint8_t evaluate_tev_alpha_arg(uint8_t arg,
+                                             uint8_t rasc_a,
+                                             uint8_t texc_a,
+                                             const uint8_t regs[4][4],
+                                             const RenderDrawState* state,
+                                             int stage) {
+    switch (arg) {
+        case GX_CA_APREV:
+            return regs[GX_TEVPREV][3];
+        case GX_CA_A0:
+            return regs[GX_TEVREG0][3];
+        case GX_CA_A1:
+            return regs[GX_TEVREG1][3];
+        case GX_CA_A2:
+            return regs[GX_TEVREG2][3];
+        case GX_CA_TEXA:
+            return texc_a;
+        case GX_CA_RASA:
+            return rasc_a;
+        case GX_CA_KONST: {
+            uint8_t kasel = state ? state->tev_kasel[stage] : 0;
+            return get_tev_konst_alpha(kasel, state);
+        }
+        case GX_CA_ZERO:
+        default:
+            return 0;
+    }
+}
