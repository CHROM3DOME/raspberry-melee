+  assert(src && "MTXTranspose():  NULL MtxPtr 'src' ");
+  assert(xPose && "MTXTranspose():  NULL MtxPtr 'xPose' ");
+
+  if (src == xPose) {
+    m = mTmp;
+  } else {
+    m = xPose;
+  }
+
+  m[0][0] = src[0][0];
+  m[0][1] = src[1][0];
+  m[0][2] = src[2][0];
+  m[0][3] = 0;
+  m[1][0] = src[0][1];
+  m[1][1] = src[1][1];
+  m[1][2] = src[2][1];
+  m[1][3] = 0;
+  m[2][0] = src[0][2];
+  m[2][1] = src[1][2];
+  m[2][2] = src[2][2];
+  m[2][3] = 0;
+  if (m == mTmp) {
+    C_MTXCopy(mTmp, xPose);
