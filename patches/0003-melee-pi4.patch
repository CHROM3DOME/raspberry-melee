+/* ========================================================================= */
+/* Pillar 1: Exclusive Input Grab (EVIOCGRAB)                                */
+/* ========================================================================= */
+
+void Port_PAD_GrabExclusive(void) {
+    /* evdev EVIOCGRAB is disabled by default so system background hotkey services remain active. */
+    const char* env_grab = getenv("MELEE_EVIOCGRAB");
+    if (!env_grab || atoi(env_grab) == 0) {
+        return;
+    }
+
+    /* 1. Grab all /dev/input/event* descriptors opened in this process (e.g. by SDL) */
+    DIR* dir = opendir("/proc/self/fd");
+    if (dir) {
+        struct dirent* entry;
+        while ((entry = readdir(dir)) != NULL) {
+            if (entry->d_name[0] == '.') continue;
+            int fd = atoi(entry->d_name);
+            if (fd <= 2) continue;
+
+            int already = 0;
+            for (int i = 0; i < s_grabbed_count; i++) {
+                if (s_grabbed_fds[i] == fd) {
+                    already = 1;
+                    break;
+                }
+            }
+            if (already) continue;
+
+            char linkpath[64];
+            char target[256];
+            snprintf(linkpath, sizeof(linkpath), "/proc/self/fd/%d", fd);
+            ssize_t len = readlink(linkpath, target, sizeof(target) - 1);
+            if (len > 0) {
+                target[len] = '\0';
+                if (strstr(target, "/dev/input/event")) {
+                    if (ioctl(fd, EVIOCGRAB, 1) == 0) {
+                        if (s_grabbed_count < MAX_GRABBED_FDS) {
+                            s_grabbed_fds[s_grabbed_count] = fd;
+                            s_grabbed_direct[s_grabbed_count] = 0;
+                            s_grabbed_count++;
+                        }
+                        fprintf(stderr, "[Melee-Pad] Acquired exclusive evdev grab on %s (FD %d).\n", target, fd);
+                        fflush(stderr);
+                    } else {
+                        fprintf(stderr, "[Melee-Pad] Notice: ioctl(EVIOCGRAB) on %s (FD %d) returned errno %d.\n", target, fd, errno);
+                        fflush(stderr);
+                    }
+                }
+            }
+        }
+        closedir(dir);
+    }
+
+    /* 2. Fallback: If no event device was opened by SDL, grab /dev/input/event0 directly */
+    if (s_grabbed_count == 0) {
+        int direct_fd = open("/dev/input/event0", O_RDONLY | O_NONBLOCK);
+        if (direct_fd >= 0) {
+            if (ioctl(direct_fd, EVIOCGRAB, 1) == 0) {
+                if (s_grabbed_count < MAX_GRABBED_FDS) {
+                    s_grabbed_fds[s_grabbed_count] = direct_fd;
+                    s_grabbed_direct[s_grabbed_count] = 1;
+                    s_grabbed_count++;
+                }
+                fprintf(stderr, "[Melee-Pad] Acquired direct exclusive evdev grab on /dev/input/event0 (FD %d).\n", direct_fd);
+                fflush(stderr);
+            } else {
+                close(direct_fd);
+            }
+        }
+    }
+}
+
+void Port_PAD_ReleaseExclusive(void) {
+    for (int i = 0; i < s_grabbed_count; i++) {
+        int fd = s_grabbed_fds[i];
+        if (fd >= 0) {
+            ioctl(fd, EVIOCGRAB, 0);
+            if (s_grabbed_direct[i]) {
+                close(fd);
+            }
+            fprintf(stderr, "[Melee-Pad] Released exclusive evdev grab on FD %d.\n", fd);
+            fflush(stderr);
+        }
+    }
+    s_grabbed_count = 0;
+}
+
+/* ========================================================================= */
+/* Pillar 2: EmulationStation Lifecycle Management                           */
+/* ========================================================================= */
+
+void Port_PAD_ResumeES(void) {
+    if (s_record_file) {
+        fflush(s_record_file);
+        fclose(s_record_file);
+        s_record_file = NULL;
+        fprintf(stderr, "[Melee-Pad] Input recording successfully saved to '%s' (%u frames).\n", s_record_path, s_pad_frame);
+        fflush(stderr);
+    }
+    if (s_playback_file) {
+        fclose(s_playback_file);
+        s_playback_file = NULL;
+        fprintf(stderr, "[Melee-Pad] Input playback ended (%u frames).\n", s_pad_frame);
+        fflush(stderr);
+    }
+
+    Port_PAD_ReleaseExclusive();
+    s_es_frozen = 0;
+#if !defined(TARGET_PI4)
+    system("killall -CONT emulationstation emulationstatio 2>/dev/null || true");
+    fprintf(stderr, "[Melee-Pad] Resumed EmulationStation.\n");
+#endif
+    fflush(stderr);
+}
+
+static void on_clean_signal(int sig) {
+    fprintf(stderr, "\n[Melee-Pad] Signal %d received. Restoring EmulationStation and exiting cleanly...\n", sig);
+    Port_PAD_ResumeES();
+    _exit(128 + sig);
+}
+
+#include <ucontext.h>
+#if defined(__linux__)
+#include <sys/prctl.h>
+#endif
+
+static void on_crash_signal(int sig, siginfo_t* info, void* ucontext) {
+    fprintf(stderr, "\n[Melee-Pad] CRASH/FAULT DETECTED (Signal %d, addr=%p)! Emergency diagnostics...\n",
+            sig, info ? info->si_addr : NULL);
+    if (ucontext != NULL) {
+        ucontext_t* uc = (ucontext_t*) ucontext;
+#ifdef __arm__
+        fprintf(stderr, "[Melee-Pad] CPU Regs: PC=0x%08lx LR=0x%08lx SP=0x%08lx IP=0x%08lx\n",
+                (unsigned long) uc->uc_mcontext.arm_pc,
+                (unsigned long) uc->uc_mcontext.arm_lr,
+                (unsigned long) uc->uc_mcontext.arm_sp,
+                (unsigned long) uc->uc_mcontext.arm_ip);
+        fprintf(stderr, "[Melee-Pad] CPU Regs: R0=0x%08lx R1=0x%08lx R2=0x%08lx R3=0x%08lx\n",
+                (unsigned long) uc->uc_mcontext.arm_r0,
+                (unsigned long) uc->uc_mcontext.arm_r1,
+                (unsigned long) uc->uc_mcontext.arm_r2,
+                (unsigned long) uc->uc_mcontext.arm_r3);
+#endif
+    }
+#if defined(__linux__)
+    fprintf(stderr, "\n--- Process Memory Maps ---\n");
+    FILE* mf = fopen("/proc/self/maps", "r");
+    if (mf) {
+        char mline[512];
+        while (fgets(mline, sizeof(mline), mf)) {
+            if (strstr(mline, "melee_pi") || strstr(mline, "[heap]") || strstr(mline, "[stack]")) {
+                fputs(mline, stderr);
+            }
+        }
+        fclose(mf);
+    }
+    fprintf(stderr, "---------------------------\n\n");
+    fflush(stderr);
+
+    /* Invoke GDB to print full backtrace */
+    char gdb_cmd[512];
+    snprintf(gdb_cmd, sizeof(gdb_cmd),
+             "gdb -p %d -batch -ex 'set print thread-events off' -ex 'thread apply all bt' 2>&1",
+             getpid());
+    FILE* fp = popen(gdb_cmd, "r");
+    if (fp) {
+        char line[512];
+        while (fgets(line, sizeof(line), fp)) {
+            fputs(line, stderr);
+        }
+        pclose(fp);
+    }
+#endif
+    void* callstack[64];
+    int frames = backtrace(callstack, 64);
+    fprintf(stderr, "[Melee-Pad] Stack trace (%d frames):\n", frames);
+    backtrace_symbols_fd(callstack, frames, STDERR_FILENO);
+    fflush(stderr);
+    Port_PAD_ResumeES();
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+void Port_PAD_FreezeES(void) {
+    if (!s_es_frozen) {
+#if defined(TARGET_PI4)
+        /* On Pi 4, EmulationStation lifecycle is managed externally by the launcher
+         * script or benchmark harness to avoid DRM master conflicts and spurious restarts. */
+        s_es_frozen = 1;
+#else
+        system("killall -STOP emulationstation emulationstatio 2>/dev/null || true");
+        s_es_frozen = 1;
+        fprintf(stderr, "[Melee-Pad] Suspended EmulationStation for exclusive hardware access.\n");
+#endif
+        fflush(stderr);
+
+        atexit(Port_PAD_ResumeES);
+
+        /* Termination signals */
+        signal(SIGINT,  on_clean_signal);
+        signal(SIGTERM, on_clean_signal);
+        signal(SIGHUP,  on_clean_signal);
+        signal(SIGQUIT, on_clean_signal);
+
+        /* Crash handlers */
+        struct sigaction sa;
+        memset(&sa, 0, sizeof(sa));
+        sa.sa_sigaction = on_crash_signal;
+        sa.sa_flags = SA_SIGINFO;
+        sigaction(SIGSEGV, &sa, NULL);
+        sigaction(SIGABRT, &sa, NULL);
+        sigaction(SIGBUS,  &sa, NULL);
+        sigaction(SIGFPE,  &sa, NULL);
+        sigaction(SIGILL,  &sa, NULL);
+    }
+}
+
+/* ========================================================================= */
+/* Pillar 1: Exclusive Input Polling for GPIOnext Joypad 1                  */
+/* ========================================================================= */
+
+BOOL PADInit(void) {
+    if (s_pad_initialized) return TRUE;
