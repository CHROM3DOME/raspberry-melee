+    if (s_begin_call_count < 10) {
+        fprintf(stderr, "[Melee-GX] GXBegin (#%d): prim=%d, fmt=%d, nverts=%d\n",
+                ++s_begin_call_count, prim, vtxfmt, nverts);
+        fflush(stderr);
