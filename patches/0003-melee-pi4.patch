+                        float dot_key = nx * 0.35f + ny * 0.65f + nz * 0.65f;
+                        if (dot_key > 0.0f) diff += dot_key * (0.50f * 0.30f);
+                        float dot_fill = nx * -0.50f + ny * 0.40f + nz * 0.55f;
+                        if (dot_fill > 0.0f) diff += dot_fill * (0.30f * 0.30f);
+                        if (nz > 0.0f) diff += nz * (0.15f * 0.30f);
+                    }
+
+                    if (is_textured) {
+                        float lit = fminf(1.0f, base_amb_r + diff);
+                        if (has_vtx_clr) {
+                            vert.col[0] = (uint8_t)(lit * (float)vert.col[0]);
+                            vert.col[1] = (uint8_t)(lit * (float)vert.col[1]);
+                            vert.col[2] = (uint8_t)(lit * (float)vert.col[2]);
+                        } else {
+                            uint8_t c = (uint8_t)(lit * 255.0f);
+                            vert.col[0] = c;
+                            vert.col[1] = c;
+                            vert.col[2] = c;
+                        }
+                    } else {
+                        float mat = has_vtx_clr ? ((float)vert.col[0] * (1.0f / 255.0f)) : default_mat_r;
+                        float lit = fminf(1.0f, (amb_r + diff * 3.333333f) * mat);
+                        uint8_t c = (uint8_t)(lit * 255.0f);
+                        vert.col[0] = c;
+                        vert.col[1] = c;
+                        vert.col[2] = c;
+                    }
+                    if (!has_vtx_clr) {
+                        vert.col[3] = default_col[3];
+                    }
+                } else {
+                    float diff_r = 0.0f, diff_g = 0.0f, diff_b = 0.0f;
+                    if (num_lights == 1) {
+                        float dot = nx * light_dirs[0][0] + ny * light_dirs[0][1] + nz * light_dirs[0][2];
+                        float wrap_dot = dot * 0.5f + 0.5f;
+                        float diffuse = wrap_dot * wrap_dot;
+                        diff_r = diffuse * scaled_light_cols[0][0];
+                        diff_g = diffuse * scaled_light_cols[0][1];
+                        diff_b = diffuse * scaled_light_cols[0][2];
+                    } else if (num_lights > 1) {
+                        for (int li = 0; li < num_lights; li++) {
+                            float dot = nx * light_dirs[li][0] + ny * light_dirs[li][1] + nz * light_dirs[li][2];
+                            float wrap_dot = dot * 0.5f + 0.5f;
+                            float diffuse = wrap_dot * wrap_dot;
+                            diff_r += diffuse * scaled_light_cols[li][0];
+                            diff_g += diffuse * scaled_light_cols[li][1];
+                            diff_b += diffuse * scaled_light_cols[li][2];
+                        }
+                    }
+                    if (num_lights > 0) {
+                        float fill_dot = nz * 0.70f + ny * 0.30f;
+                        if (fill_dot > 0.0f) {
+                            float fill_amt = fill_dot * (0.20f * 0.30f);
+                            diff_r += fill_amt;
+                            diff_g += fill_amt;
+                            diff_b += fill_amt;
+                        }
+                    } else {
+                        float dot_key = nx * 0.35f + ny * 0.65f + nz * 0.65f;
+                        if (dot_key > 0.0f) {
+                            diff_r += dot_key * (0.50f * 0.30f);
+                            diff_g += dot_key * (0.50f * 0.30f);
+                            diff_b += dot_key * (0.50f * 0.30f);
+                        }
+                        float dot_fill = nx * -0.50f + ny * 0.40f + nz * 0.55f;
+                        if (dot_fill > 0.0f) {
+                            diff_r += dot_fill * (0.30f * 0.30f);
+                            diff_g += dot_fill * (0.30f * 0.30f);
+                            diff_b += dot_fill * (0.30f * 0.30f);
+                        }
+                        if (nz > 0.0f) {
+                            diff_r += nz * (0.15f * 0.30f);
+                            diff_g += nz * (0.15f * 0.30f);
+                            diff_b += nz * (0.15f * 0.30f);
+                        }
+                    }
+
+                    float lit_r, lit_g, lit_b;
+                    if (is_textured) {
+                        lit_r = fminf(1.0f, base_amb_r + diff_r);
+                        lit_g = fminf(1.0f, base_amb_g + diff_g);
+                        lit_b = fminf(1.0f, base_amb_b + diff_b);
+                        if (has_vtx_clr) {
+                            lit_r *= ((float)vert.col[0] * (1.0f / 255.0f));
+                            lit_g *= ((float)vert.col[1] * (1.0f / 255.0f));
+                            lit_b *= ((float)vert.col[2] * (1.0f / 255.0f));
+                        }
+                    } else {
+                        float mat_r = has_vtx_clr ? ((float)vert.col[0] * (1.0f / 255.0f)) : default_mat_r;
+                        float mat_g = has_vtx_clr ? ((float)vert.col[1] * (1.0f / 255.0f)) : default_mat_g;
+                        float mat_b = has_vtx_clr ? ((float)vert.col[2] * (1.0f / 255.0f)) : default_mat_b;
+                        lit_r = fminf(1.0f, (amb_r + diff_r * 3.333333f) * mat_r);
+                        lit_g = fminf(1.0f, (amb_g + diff_g * 3.333333f) * mat_g);
+                        lit_b = fminf(1.0f, (amb_b + diff_b * 3.333333f) * mat_b);
+                    }
+
+                    vert.col[0] = (uint8_t)(lit_r * 255.0f);
+                    vert.col[1] = (uint8_t)(lit_g * 255.0f);
+                    vert.col[2] = (uint8_t)(lit_b * 255.0f);
+                    if (!has_vtx_clr) {
+                        vert.col[3] = default_col[3];
+                    }
+                }
+            }
+
+            if (dl_error) {
+                s_vert_count = 0;
+                break;
+            }
+
+            if (!has_active_tex) {
+                if (has_fallback_tex) {
+                    vert.tex[0] = fallback_tex[0];
+                    vert.tex[1] = fallback_tex[1];
+                } else if (s_current_state.texture_id != 0 &&
+                           (s_tex_coord_src[s_active_tex_coord] == 1 || s_tex_coord_src[s_active_tex_coord] == 0)) {
+                    port_gx_generate_texcoord(s_active_tex_coord, vert.pos, raw_nrm, has_vtx_nrm, current_vtx_mtx, &vert.tex[0], &vert.tex[1]);
+                }
+            }
+
+            if (s_vert_count < MAX_IMMEDIATE_VERTS) {
+                s_vert_buffer[s_vert_count++] = vert;
+            }
+        }
+        }
+
+        if (dl_error) {
+            s_vert_count = 0;
+            break;
+        }
+
+        GXEnd();
+    }
+    s_in_display_list = false;
+
+    if (__builtin_expect(profile_this_frame, 0)) {
+        clock_gettime(CLOCK_MONOTONIC, &dl_end);
+        s_metric_dl_time_ms += (double)(dl_end.tv_sec - dl_start.tv_sec) * 1000.0 +
+                               (double)(dl_end.tv_nsec - dl_start.tv_nsec) / 1e6;
+    }
+}
