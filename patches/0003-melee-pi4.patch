+void GXSetTevOrder(GXTevStageID stage, GXTexCoordID coord, GXTexMapID map, GXChannelID color) {
+    (void)color;
+    if (stage < MAX_TEV_STAGES) {
+        s_current_state.tev_tex_map[stage] = (uint8_t)map;
+        s_tev_tex_coord[stage] = (uint8_t)coord;
+        uint8_t prev_coord = s_active_tex_coord;
+        if (map != GX_TEXMAP_NULL && map < 8 && s_current_state.tex_maps[map]) {
+            s_current_state.texture_id = s_current_state.tex_maps[map];
+            s_active_tex_coord = (coord < 8) ? (uint8_t)coord : 0;
+        } else {
+            uint32_t active_tex = 0;
+            uint8_t active_coord = 0;
+            int max_check = s_current_state.num_tev_stages;
+            if (max_check < 1) max_check = 1;
+            if (max_check > MAX_TEV_STAGES) max_check = MAX_TEV_STAGES;
+            for (int s = 0; s < max_check; s++) {
+                uint8_t m = s_current_state.tev_tex_map[s];
+                if (m != GX_TEXMAP_NULL && m < 8 && s_current_state.tex_maps[m]) {
+                    active_tex = s_current_state.tex_maps[m];
+                    active_coord = (s_tev_tex_coord[s] < 8) ? s_tev_tex_coord[s] : 0;
+                    break;
+                }
+            }
+            s_current_state.texture_id = active_tex;
+            s_active_tex_coord = active_coord;
+        }
+        if (s_active_tex_coord != prev_coord) {
+            s_vat_state_gen++;
+        }
+    }
+}
