+
+int g_drawing_lupe_bubble = 0;
+
+void GXLoadTexObj(GXTexObj* obj, GXTexMapID id) {
+    if (!obj) {
+        if (id < 8) s_current_state.tex_maps[id] = 0;
+        s_current_state.texture_id = 0;
+        return;
+    }
+
+    const void* ptr = (const void*)(uintptr_t)obj->dummy[0];
+    uint16_t w = (uint16_t)(obj->dummy[1] >> 16);
+    uint16_t h = (uint16_t)(obj->dummy[1] & 0xFFFF);
+    int fmt    = (int)obj->dummy[2];
+    uint8_t wrap_s = (uint8_t)(obj->dummy[4] >> 16);
+    uint8_t wrap_t = (uint8_t)(obj->dummy[4] & 0xFFFF);
+    uint32_t tlut_idx = obj->dummy[5];
+
+    if (g_drawing_lupe_bubble) {
+        fprintf(stderr, "[GXLoadTexObj-Bubble] id=%d ptr=%p w=%u h=%u fmt=0x%x\n", id, ptr, w, h, fmt);
+        fflush(stderr);
+    }
+
+    if (!ptr || w == 0 || h == 0) {
+        if (id < 8) s_current_state.tex_maps[id] = 0;
+        s_current_state.texture_id = 0;
+        return;
+    }
+    if (getenv("MELEE_TEX_DEBUG") && s_num_cached_tex < 150) {
+        fprintf(stderr, "[TexLoad #%d] id=%d ptr=%p w=%u h=%u fmt=0x%x tlut=%u wrap=(%u,%u)\n",
+                s_num_cached_tex, id, ptr, w, h, fmt, tlut_idx, wrap_s, wrap_t);
+        fflush(stderr);
+    }
+
+    const PortTlutEntry* current_tlut = (tlut_idx < 24) ? &s_tlut_table[tlut_idx] : NULL;
+    const void* current_tlut_data = current_tlut ? current_tlut->data : NULL;
+    bool is_ci = (fmt == 0x08 || fmt == 0x09 || fmt == 0x0A);
+
+    /* Check texture cache */
+    for (int i = 0; i < s_num_cached_tex; i++) {
+        if (s_tex_cache[i].ptr == ptr) {
+            if (s_tex_cache[i].is_efb_copy) {
+                s_tex_cache[i].last_frame = (uint32_t)s_frame_num;
+                GLuint tid = s_is_software_renderer ? (i + 1) : s_tex_cache[i].gl_id;
+                static int s_efb_bind_log = 0;
+                if (s_efb_bind_log++ < 15) {
+                    fprintf(stderr, "[GXLoadTexObj-EFB] id=%d ptr=%p tid=%u\n", id, ptr, tid);
+                    fflush(stderr);
+                }
+                if (id < 8) s_current_state.tex_maps[id] = tid;
+                s_current_state.texture_id = tid;
+                return;
+            }
+            if (s_tex_cache[i].dirty) {
+                s_tex_cache[i].dirty = 0;
+                s_tex_cache[i].last_frame = (uint32_t)s_frame_num;
+                if (wrap_s == 1) s_tex_cache[i].wrap_s = 1;
+                if (wrap_t == 1) s_tex_cache[i].wrap_t = 1;
+                if (s_is_software_renderer) {
+                    if (!s_tex_cache[i].rgba) {
+                        s_tex_cache[i].rgba = (uint32_t*)malloc(w * h * sizeof(uint32_t));
+                    }
+                    if (s_tex_cache[i].rgba) {
+                        decode_texture(ptr, s_tex_cache[i].rgba, w, h, fmt, current_tlut);
+                    }
+                } else if (Port_RenderThread_IsEnabled()) {
+                    uint32_t* rgba = (uint32_t*)malloc(w * h * sizeof(uint32_t));
+                    if (rgba) {
+                        decode_texture(ptr, rgba, w, h, fmt, current_tlut);
+                        Port_RenderThread_PushTexUpload((uint16_t)s_tex_cache[i].gl_id, rgba, w, h, wrap_s, wrap_t);
+                        s_metric_tex_uploads++;
+                        s_metric_tex_bytes += ((uint64_t)w * h * 4);
+                    }
+                } else if (s_gl_context) {
+                    glBindTexture(GL_TEXTURE_2D, s_tex_cache[i].gl_id);
+                    uint32_t* rgba = (uint32_t*)malloc(w * h * sizeof(uint32_t));
+                    if (rgba) {
+                        decode_texture(ptr, rgba, w, h, fmt, current_tlut);
+                        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+                        free(rgba);
+                        s_metric_tex_uploads++;
+                        s_metric_tex_bytes += ((uint64_t)w * h * 4);
+                    }
+                }
+                GLuint tid = s_is_software_renderer ? (i + 1) : s_tex_cache[i].gl_id;
+                if (id < 8) s_current_state.tex_maps[id] = tid;
+                s_current_state.texture_id = tid;
+                return;
+            }
+            if (s_tex_cache[i].fmt == (uint8_t)fmt &&
+                (!is_ci || (s_tex_cache[i].tlut_idx == (uint8_t)tlut_idx && s_tex_cache[i].tlut_data == current_tlut_data))) {
+                if (wrap_s == 1) s_tex_cache[i].wrap_s = 1;
+                if (wrap_t == 1) s_tex_cache[i].wrap_t = 1;
+                s_tex_cache[i].last_frame = (uint32_t)s_frame_num;
+                GLuint tid = s_is_software_renderer ? (i + 1) : s_tex_cache[i].gl_id;
+                if (id < 8) s_current_state.tex_maps[id] = tid;
+                s_current_state.texture_id = tid;
+                return;
+            }
+    }
+}
+
+    if (s_is_software_renderer) {
+        int idx = -1;
+        if (s_num_cached_tex < MAX_TEX_CACHE) {
+            idx = s_num_cached_tex++;
+        } else {
+            /* LRU fallback */
+            uint32_t oldest_frame = 0xFFFFFFFF;
+            int victim = -1;
+            for (int i = 0; i < s_num_cached_tex; i++) {
+                if (s_frame_num - (int)s_tex_cache[i].last_frame >= 2 && s_tex_cache[i].last_frame < oldest_frame) {
+                    oldest_frame = s_tex_cache[i].last_frame;
+                    victim = i;
+                }
+            }
+            if (victim >= 0) {
+                idx = victim;
+                if (s_tex_cache[idx].rgba) {
+                    free(s_tex_cache[idx].rgba);
+                    s_tex_cache[idx].rgba = NULL;
+                }
+            }
+        }
+        if (idx >= 0) {
+            s_tex_cache[idx].ptr = ptr;
+            s_tex_cache[idx].tlut_data = current_tlut_data;
+            s_tex_cache[idx].width = w;
+            s_tex_cache[idx].height = h;
+            s_tex_cache[idx].fmt = (uint8_t)fmt;
+            s_tex_cache[idx].tlut_idx = (uint8_t)tlut_idx;
+            s_tex_cache[idx].wrap_s = wrap_s;
+            s_tex_cache[idx].wrap_t = wrap_t;
+            s_tex_cache[idx].last_frame = (uint32_t)s_frame_num;
+            s_tex_cache[idx].rgba = (uint32_t*)malloc(w * h * sizeof(uint32_t));
+            if (s_tex_cache[idx].rgba) {
+                decode_texture(ptr, s_tex_cache[idx].rgba, w, h, fmt, current_tlut);
+            }
+            s_tex_cache[idx].gl_id = idx + 1;
+            if (id < 8) s_current_state.tex_maps[id] = idx + 1;
+            s_current_state.texture_id = idx + 1;
+        }
+        return;
+    }
+
+    if (Port_RenderThread_IsEnabled()) {
+        int idx = -1;
+        if (s_num_cached_tex < MAX_TEX_CACHE) {
+            idx = s_num_cached_tex++;
+        } else {
+            /* LRU fallback */
+            uint32_t oldest_frame = 0xFFFFFFFF;
+            int victim = -1;
+            for (int i = 0; i < s_num_cached_tex; i++) {
+                if (s_frame_num - (int)s_tex_cache[i].last_frame >= 2 && s_tex_cache[i].last_frame < oldest_frame) {
+                    oldest_frame = s_tex_cache[i].last_frame;
+                    victim = i;
+                }
+            }
+            if (victim >= 0) {
+                idx = victim;
+                if (s_tex_cache[idx].rgba) {
+                    free(s_tex_cache[idx].rgba);
+                    s_tex_cache[idx].rgba = NULL;
+                }
+            }
+        }
+        if (idx >= 0) {
+            s_tex_cache[idx].ptr = ptr;
+            s_tex_cache[idx].tlut_data = current_tlut_data;
+            s_tex_cache[idx].width = w;
+            s_tex_cache[idx].height = h;
+            s_tex_cache[idx].fmt = (uint8_t)fmt;
+            s_tex_cache[idx].tlut_idx = (uint8_t)tlut_idx;
+            s_tex_cache[idx].wrap_s = wrap_s;
+            s_tex_cache[idx].wrap_t = wrap_t;
+            s_tex_cache[idx].gl_id = idx + 1;
+            s_tex_cache[idx].last_frame = (uint32_t)s_frame_num;
+
+            uint32_t* rgba = (uint32_t*)malloc(w * h * sizeof(uint32_t));
+            if (rgba) {
+                decode_texture(ptr, rgba, w, h, fmt, current_tlut);
+                if (getenv("MELEE_DUMP_TEX")) {
+                    char dpath[64];
+                    snprintf(dpath, sizeof(dpath), "tex_%d.bmp", idx + 1);
+                    save_bmp(dpath, rgba, w, h);
+                }
+                Port_RenderThread_PushTexUpload((uint16_t)(idx + 1), rgba, w, h, wrap_s, wrap_t);
+                s_metric_tex_uploads++;
+                s_metric_tex_bytes += ((uint64_t)w * h * 4);
+            }
+            if (id < 8) s_current_state.tex_maps[id] = idx + 1;
+            s_current_state.texture_id = idx + 1;
+        }
+        return;
+    }
+
+    if (!s_gl_context) {
+        return;
+    }
+
+    /* Single-threaded GLES2 path */
+    int idx = -1;
+    GLuint tex = 0;
+    if (s_num_cached_tex < MAX_TEX_CACHE) {
+        glGenTextures(1, &tex);
+        idx = s_num_cached_tex++;
+    } else {
+        uint32_t oldest_frame = 0xFFFFFFFF;
+        int victim = -1;
+        for (int i = 0; i < s_num_cached_tex; i++) {
+            if (s_frame_num - (int)s_tex_cache[i].last_frame >= 2 && s_tex_cache[i].last_frame < oldest_frame) {
+                oldest_frame = s_tex_cache[i].last_frame;
+                victim = i;
+            }
+        }
+        if (victim >= 0) {
+            idx = victim;
+            tex = s_tex_cache[idx].gl_id;
+            if (s_tex_cache[idx].rgba) {
+                free(s_tex_cache[idx].rgba);
+                s_tex_cache[idx].rgba = NULL;
+            }
+        }
+    }
+
+    if (idx < 0) return;
+
+    glBindTexture(GL_TEXTURE_2D, tex);
+
+    GLint gl_wrap_s = GL_CLAMP_TO_EDGE;
+    GLint gl_wrap_t = GL_CLAMP_TO_EDGE;
+    bool is_pot = ((w & (w - 1)) == 0) && ((h & (h - 1)) == 0);
+    if (is_pot) {
+        if (wrap_s == 1) gl_wrap_s = GL_REPEAT;
+        else if (wrap_s == 2) gl_wrap_s = GL_MIRRORED_REPEAT;
+
+        if (wrap_t == 1) gl_wrap_t = GL_REPEAT;
+        else if (wrap_t == 2) gl_wrap_t = GL_MIRRORED_REPEAT;
+    }
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, gl_wrap_s);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, gl_wrap_t);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+
+    /* Allocate and decode texture */
+    uint32_t* rgba = (uint32_t*)malloc(w * h * sizeof(uint32_t));
+    if (rgba) {
+        decode_texture(ptr, rgba, w, h, fmt, current_tlut);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+        s_metric_tex_uploads++;
+        s_metric_tex_bytes += ((uint64_t)w * h * 4);
+    } else {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+    }
+
+    s_tex_cache[idx].ptr = ptr;
+    s_tex_cache[idx].tlut_data = current_tlut_data;
+    s_tex_cache[idx].gl_id = tex;
+    s_tex_cache[idx].width = w;
+    s_tex_cache[idx].height = h;
+    s_tex_cache[idx].fmt = (uint8_t)fmt;
+    s_tex_cache[idx].tlut_idx = (uint8_t)tlut_idx;
+    s_tex_cache[idx].wrap_s = wrap_s;
+    s_tex_cache[idx].wrap_t = wrap_t;
+    s_tex_cache[idx].rgba = rgba;
+    s_tex_cache[idx].last_frame = (uint32_t)s_frame_num;
+
+    if (id < 8) s_current_state.tex_maps[id] = tex;
+    s_current_state.texture_id = tex;
+}
+
+void Port_GX_ResetTextureCache(void) {
+    if (Port_RenderThread_IsEnabled()) {
+        Port_RenderThread_PushTexReset();
+    } else if (s_gl_context) {
+        for (int i = 0; i < s_num_cached_tex; i++) {
+            if (s_tex_cache[i].gl_id) {
+                glDeleteTextures(1, &s_tex_cache[i].gl_id);
+                s_tex_cache[i].gl_id = 0;
+            }
+        }
+    }
+
+    for (int i = 0; i < s_num_cached_tex; i++) {
+        if (s_tex_cache[i].rgba) {
+            free(s_tex_cache[i].rgba);
+            s_tex_cache[i].rgba = NULL;
+        }
+    }
+    memset(s_tex_cache, 0, sizeof(s_tex_cache));
+    s_num_cached_tex = 0;
+
+    s_current_state.texture_id = 0;
+    s_current_state.texture1_id = 0;
+    for (int i = 0; i < 8; i++) {
+        s_current_state.tex_maps[i] = 0;
+    }
+    fprintf(stderr, "[Melee-GX] Port_GX_ResetTextureCache() completed (frame=%d).\n", s_frame_num);
+    fflush(stderr);
+}
+
+void Port_GX_InvalidateTex(const void* ptr) {
+    if (!ptr) return;
+    for (int i = 0; i < s_num_cached_tex; i++) {
+        if (s_tex_cache[i].ptr == ptr) {
+            s_tex_cache[i].dirty = 1;
+            break;
+        }
+    }
+}
