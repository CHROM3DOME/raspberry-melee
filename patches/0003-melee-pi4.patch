+static inline void evaluate_state_tev_uniforms_uncached(const RenderDrawState* state,
+                                                        float out_tev_mod[4],
+                                                        float out_tev_mod2[4],
+                                                        int* out_lerp_mode) {
+    float out_kcolor[4];
+    float out_c0[4];
+    out_kcolor[0] = 1.0f;
+    out_kcolor[1] = 1.0f;
+    out_kcolor[2] = 1.0f;
+    out_kcolor[3] = 1.0f;
+
+    out_c0[0] = 1.0f;
+    out_c0[1] = 1.0f;
+    out_c0[2] = 1.0f;
+    out_c0[3] = 1.0f;
+
+    out_tev_mod[0] = 1.0f; out_tev_mod[1] = 1.0f; out_tev_mod[2] = 1.0f; out_tev_mod[3] = 1.0f;
+    out_tev_mod2[0] = 0.0f; out_tev_mod2[1] = 0.0f; out_tev_mod2[2] = 0.0f; out_tev_mod2[3] = 0.0f;
+    *out_lerp_mode = 0;
+
+    if (!state) return;
+    int num_stages = state->num_tev_stages;
+    if (state->texture_id != 0 && state->texture1_id != 0) {
+        /* Check if any TEV stage multiplies CPREV with TEXC/TEXA or APREV with TEXA (e.g. title screen masked flames) */
+        bool is_multiply = false;
+        for (int s = 0; s < num_stages && s < 4; s++) {
+            if ((state->tev_c_in[s][3] == 15 && state->tev_c_in[s][0] == 15 &&
+                 ((state->tev_c_in[s][1] == 0 && (state->tev_c_in[s][2] == 8 || state->tev_c_in[s][2] == 9)) ||
+                  (state->tev_c_in[s][2] == 0 && (state->tev_c_in[s][1] == 8 || state->tev_c_in[s][1] == 9)))) ||
+                (state->tev_a_in[s][3] == 7 && state->tev_a_in[s][0] == 7 &&
+                 ((state->tev_a_in[s][1] == 0 && state->tev_a_in[s][2] == 4) ||
+                  (state->tev_a_in[s][2] == 0 && state->tev_a_in[s][1] == 4)))) {
+                is_multiply = true;
+                break;
+            }
+        }
+        if (is_multiply) {
+            *out_lerp_mode = 4;
+            /* For additive dual-texture passes (e.g. starburst rays), modulate with K0 tint */
+            if (state->blend_enable && state->blend_dst == 1) {
+                uint8_t kr = 255, kg = 255, kb = 255;
+                Port_GetTevKonstColor(state->tev_kcsel[0], state, &kr, &kg, &kb);
+                out_tev_mod[0] = ((float)kr / 255.0f) * 1.5f;
+                out_tev_mod[1] = ((float)kg / 255.0f) * 1.5f;
+                out_tev_mod[2] = ((float)kb / 255.0f) * 1.5f;
+                out_tev_mod[3] = 1.0f;
+            } else {
+                /* Title logo letter quads: pure flame texture, boosted for fiery brilliance */
+                out_tev_mod[0] = 1.6f;
+                out_tev_mod[1] = 1.3f;
+                out_tev_mod[2] = 1.0f;
+                out_tev_mod[3] = 1.0f;
+            }
+            out_tev_mod2[0] = 0.0f;
+            out_tev_mod2[1] = 0.0f;
+            out_tev_mod2[2] = 0.0f;
+            out_tev_mod2[3] = 0.0f;
+            return;
+        }
+
+        /* Dual-texture passes (e.g. character specular / reflection overlay) */
+        float spec_k[3] = { 0.35f, 0.35f, 0.35f };
+        for (int s = 0; s < num_stages && s < 4; s++) {
+            if (state->tev_tex_map[s] == 1 || s == 1) {
+                if (state->tev_c_in[s][0] == 14 || state->tev_c_in[s][1] == 14 ||
+                    state->tev_c_in[s][2] == 14 || state->tev_c_in[s][3] == 14) {
+                    uint8_t kr = 255, kg = 255, kb = 255;
+                    Port_GetTevKonstColor(state->tev_kcsel[s], state, &kr, &kg, &kb);
+                    spec_k[0] = (float)kr / 255.0f;
+                    spec_k[1] = (float)kg / 255.0f;
+                    spec_k[2] = (float)kb / 255.0f;
+                    break;
+                }
+            }
+        }
+        out_tev_mod2[0] = spec_k[0];
+        out_tev_mod2[1] = spec_k[1];
+        out_tev_mod2[2] = spec_k[2];
+        out_tev_mod2[3] = 0.0f;
+        return;
+    }
+    if (num_stages < 1) return;
+
+    /* Check for single-texture KONST color and A0 alpha modulation (e.g. "Melee" logo text & glow) */
+    if (state->texture_id != 0 && state->texture1_id == 0 && num_stages >= 1) {
+        if (state->tev_c_in[0][3] == 15 && state->tev_c_in[0][0] == 15 &&
+            ((state->tev_c_in[0][1] == 14 && state->tev_c_in[0][2] == 8) ||
+             (state->tev_c_in[0][1] == 8 && state->tev_c_in[0][2] == 14))) {
+            uint8_t kr = 255, kg = 255, kb = 255;
+            Port_GetTevKonstColor(state->tev_kcsel[0], state, &kr, &kg, &kb);
+            out_tev_mod[0] = (float)kr / 255.0f;
+            out_tev_mod[1] = (float)kg / 255.0f;
+            out_tev_mod[2] = (float)kb / 255.0f;
+        }
+        if (state->tev_a_in[0][3] == 7 && state->tev_a_in[0][0] == 7 &&
+            ((state->tev_a_in[0][1] == 1 && state->tev_a_in[0][2] == 4) ||
+             (state->tev_a_in[0][1] == 4 && state->tev_a_in[0][2] == 1))) {
+            out_tev_mod[3] = (float)state->tev_regs[GX_TEVREG0][3] / 255.0f;
+        }
+    }
+
+    /* Check for TEV dual-color lerp pattern: out = (1 - TEXC) * A + TEXC * B.
+     * Note: Additive blending passes (blend_dst == GX_BL_ONE) are particles/effects, not background gradients */
+    if (!state->blend_enable || state->blend_dst != 1) {
+        for (int s = 0; s < num_stages && s < 4; s++) {
+            if ((state->tev_c_in[s][2] == 8 || state->tev_c_in[s][2] == 9) && /* GX_CC_TEXC or GX_CC_TEXA */
+                state->tev_c_in[s][3] == 15) {                                 /* GX_CC_ZERO */
+                uint8_t arg_a = state->tev_c_in[s][0];
+                uint8_t arg_b = state->tev_c_in[s][1];
+
+                uint8_t colA[3] = {255, 255, 255};
+                uint8_t colB[3] = {255, 255, 255};
+                bool hasA = false, hasB = false;
+
+                /* Resolve Arg A */
+                if (arg_a == 14) { /* GX_CC_KONST */
+                    Port_GetTevKonstColor(state->tev_kcsel[s], state, &colA[0], &colA[1], &colA[2]);
+                    hasA = true;
+                } else if (arg_a == 6 || arg_a == 2 || arg_a == 4) { /* GX_CC_C2, GX_CC_C0, GX_CC_C1 */
+                    int reg_id = (arg_a == 2) ? 1 : ((arg_a == 4) ? 2 : 3);
+                    bool found_writer = false;
+                    for (int prev_s = 0; prev_s < s; prev_s++) {
+                        if (state->tev_c_out[prev_s] == reg_id) {
+                            uint8_t prev_d = state->tev_c_in[prev_s][3];
+                            if (prev_d == 14) { /* GX_CC_KONST */
+                                Port_GetTevKonstColor(state->tev_kcsel[prev_s], state, &colA[0], &colA[1], &colA[2]);
+                                hasA = true;
+                                found_writer = true;
+                                break;
+                            }
+                        }
+                    }
+                    if (!found_writer) {
+                        colA[0] = state->tev_regs[reg_id][0];
+                        colA[1] = state->tev_regs[reg_id][1];
+                        colA[2] = state->tev_regs[reg_id][2];
+                        hasA = true;
+                    }
+                }
+
+                /* Resolve Arg B */
+                if (arg_b == 14) { /* GX_CC_KONST */
+                    Port_GetTevKonstColor(state->tev_kcsel[s], state, &colB[0], &colB[1], &colB[2]);
+                    hasB = true;
+                } else if (arg_b == 6 || arg_b == 2 || arg_b == 4) { /* GX_CC_C2, GX_CC_C0, GX_CC_C1 */
+                    int reg_id = (arg_b == 2) ? 1 : ((arg_b == 4) ? 2 : 3);
+                    bool found_writer = false;
+                    for (int prev_s = 0; prev_s < s; prev_s++) {
+                        if (state->tev_c_out[prev_s] == reg_id) {
+                            uint8_t prev_d = state->tev_c_in[prev_s][3];
+                            if (prev_d == 14) { /* GX_CC_KONST */
+                                Port_GetTevKonstColor(state->tev_kcsel[prev_s], state, &colB[0], &colB[1], &colB[2]);
+                                hasB = true;
+                                found_writer = true;
+                                break;
+                            }
+                        }
+                    }
+                    if (!found_writer) {
+                        colB[0] = state->tev_regs[reg_id][0];
+                        colB[1] = state->tev_regs[reg_id][1];
+                        colB[2] = state->tev_regs[reg_id][2];
+                        hasB = true;
+                    }
+                }
+
+                if (hasA && hasB) {
+                    float boost = 1.30f;
+                    out_tev_mod[0] = fminf(1.0f, ((float)colA[0] / 255.0f) * boost);
+                    out_tev_mod[1] = fminf(1.0f, ((float)colA[1] / 255.0f) * boost);
+                    out_tev_mod[2] = fminf(1.0f, ((float)colA[2] / 255.0f) * boost);
+                    out_tev_mod[3] = 1.0f;
+
+                    out_tev_mod2[0] = fminf(1.0f, ((float)colB[0] / 255.0f) * boost);
+                    out_tev_mod2[1] = fminf(1.0f, ((float)colB[1] / 255.0f) * boost);
+                    out_tev_mod2[2] = fminf(1.0f, ((float)colB[2] / 255.0f) * boost);
+                    out_tev_mod2[3] = 1.0f;
+
+                    *out_lerp_mode = 1;
+                    return;
+                }
+            }
+        }
+
+        /* Check for TEV additive window / facade glow pattern:
+         * c_in = (RASC, TEXC, TEXC, ZERO) -> out = (1 - TEXC) * RASC + TEXC * TEXC
+         * c_in = (CPREV, TEXC, TEXC, ZERO) -> out = (1 - TEXC) * CPREV + TEXC * TEXC
+         * This illuminates windows on building facades while preserving shaded wall colors */
+        for (int s = 0; s < num_stages && s < 4; s++) {
+            if (state->tev_c_in[s][2] == 8 && state->tev_c_in[s][3] == 15 && state->tev_c_out[s] == 0) {
+                uint8_t a = state->tev_c_in[s][0];
+                uint8_t b = state->tev_c_in[s][1];
+                if ((a == 10 || a == 0) && (b == 8 || b == 12)) {
+                    *out_lerp_mode = 3;
+                    return;
+                }
+            }
+        }
+
+        /* Check for TEV reflection / ambient lerp pattern:
+         * c_in = (CPREV/RASC, TEXC, KONST, ZERO) -> out = (1 - KONST) * CPREV/RASC + KONST * TEXC
+         * c_in = (TEXC, CPREV/RASC, KONST, ZERO) -> out = KONST * CPREV/RASC + (1 - KONST) * TEXC
+         * This blends an environment / reflection / shadow texture with the shaded mesh */
+        for (int s = 0; s < num_stages && s < 4; s++) {
+            if (state->tev_c_in[s][3] == 15 && state->tev_c_out[s] == 0) { /* GX_CC_ZERO */
+                uint8_t a = state->tev_c_in[s][0];
+                uint8_t b = state->tev_c_in[s][1];
+                uint8_t c = state->tev_c_in[s][2];
+                if (c == 14 && ((a == 0 && b == 8) || (a == 8 && b == 0) ||
+                                (a == 10 && b == 8) || (a == 8 && b == 10))) {
+                    uint8_t kr = 128, kg = 128, kb = 128;
+                    Port_GetTevKonstColor(state->tev_kcsel[s], state, &kr, &kg, &kb);
+                    float weight_r = (float)kr / 255.0f;
+                    float weight_g = (float)kg / 255.0f;
+                    float weight_b = (float)kb / 255.0f;
+                    if ((a == 8 && b == 0) || (a == 8 && b == 10)) {
+                        /* out = (1 - K) * TEXC + K * CPREV/RASC = mix(color.rgb, tex.rgb, 1 - K) */
+                        weight_r = 1.0f - weight_r;
+                        weight_g = 1.0f - weight_g;
+                        weight_b = 1.0f - weight_b;
+                    }
+                    out_tev_mod[0] = weight_r;
+                    out_tev_mod[1] = weight_g;
+                    out_tev_mod[2] = weight_b;
+                    out_tev_mod[3] = 1.0f;
+                    *out_lerp_mode = 2;
+                    return;
+                }
+            }
+        }
+    }
+
+    /* Standard single-modifier fallback */
+    for (int s = 0; s < num_stages && s < 8; s++) {
+        /* Color register checks: skip accumulator stages where d == GX_CC_CPREV (0)
+         * or output is an intermediate register (out != 0), as these add specular/ambient
+         * highlights (e.g. CPREV + RASC * KONST on character skin) rather than modulating texture.
+         * Also skip stages where a == GX_CC_CPREV (0): (1 - C) * CPREV + C * B is a lerp/fade
+         * (e.g. (1 - C0) * CPREV + C0 * KONST on Mute City road) where C0 is a fade weight,
+         * NOT a multiplicative texture tint. Multiplying CPREV by K0 * C0 turns the road pitch black! */
+        if (state->tev_c_in[s][3] != 0 && state->tev_c_out[s] == 0 && (s == 0 || state->tev_c_in[s][0] != 0)) {
+            /* Check if color equation uses GX_CC_KONST (14) */
+            if (state->tev_c_in[s][0] == 14 ||
+                state->tev_c_in[s][1] == 14 ||
+                state->tev_c_in[s][2] == 14 ||
+                state->tev_c_in[s][3] == 14) {
+                uint8_t kcsel = state->tev_kcsel[s];
+                uint8_t kr = 255, kg = 255, kb = 255;
+                Port_GetTevKonstColor(kcsel, state, &kr, &kg, &kb);
+                out_kcolor[0] = (float)kr / 255.0f;
+                out_kcolor[1] = (float)kg / 255.0f;
+                out_kcolor[2] = (float)kb / 255.0f;
+            }
+
+            /* Check if color equation uses GX_CC_C0 (2) */
+            if (state->tev_c_in[s][0] == 2 ||
+                state->tev_c_in[s][1] == 2 ||
+                state->tev_c_in[s][2] == 2 ||
+                state->tev_c_in[s][3] == 2) {
+                out_c0[0] = (float)state->tev_regs[GX_TEVREG0][0] / 255.0f;
+                out_c0[1] = (float)state->tev_regs[GX_TEVREG0][1] / 255.0f;
+                out_c0[2] = (float)state->tev_regs[GX_TEVREG0][2] / 255.0f;
+            }
+        }
+
+        /* Alpha register checks: skip accumulator stages where d == GX_CA_APREV (0)
+         * or output is an intermediate register (out != 0). */
+        if (state->tev_a_in[s][3] != 0 && state->tev_a_out[s] == 0) {
+            /* Check if alpha equation uses GX_CA_KONST (6) */
+            if (state->tev_a_in[s][0] == 6 ||
+                state->tev_a_in[s][1] == 6 ||
+                state->tev_a_in[s][2] == 6 ||
+                state->tev_a_in[s][3] == 6) {
+                uint8_t kasel = state->tev_kasel[s];
+                uint8_t ka = Port_GetTevKonstAlpha(kasel, state);
+                out_kcolor[3] = (float)ka / 255.0f;
+            }
+
+            /* Check if alpha equation uses GX_CA_A0 (1) */
+            if (state->tev_a_in[s][0] == 1 ||
+                state->tev_a_in[s][1] == 1 ||
+                state->tev_a_in[s][2] == 1 ||
+                state->tev_a_in[s][3] == 1) {
+                out_c0[3] = (float)state->tev_regs[GX_TEVREG0][3] / 255.0f;
+            }
+
+            /* Alpha blend lerp: a_in = (A0, TEXA, KONST, ZERO) -> out = (1 - K) * A0 + K * TEXA */
+            if (state->blend_enable && state->tev_a_in[s][0] == 1 && state->tev_a_in[s][1] == 4 &&
+                state->tev_a_in[s][2] == 6 && state->tev_a_in[s][3] == 7) {
+                float k = out_kcolor[3];
+                float a0 = out_c0[3];
+                out_tev_mod2[3] = (1.0f - k) * a0;
+            }
+        }
+    }
+    out_tev_mod[0] = out_kcolor[0] * out_c0[0];
+    out_tev_mod[1] = out_kcolor[1] * out_c0[1];
+    out_tev_mod[2] = out_kcolor[2] * out_c0[2];
+    out_tev_mod[3] = 1.0f;
+}
+
+typedef struct TevCacheKey {
+    GLuint   texture_id;
+    GLuint   texture1_id;
+    uint8_t  num_tev_stages;
+    uint8_t  blend_enable;
+    uint8_t  blend_dst;
+    uint8_t  pad;
+    uint8_t  tev_regs[4][4];
+    uint8_t  kcolors[4][4];
+    uint8_t  tev_c_in[MAX_TEV_STAGES][4];
+    uint8_t  tev_a_in[MAX_TEV_STAGES][4];
+    uint8_t  tev_c_out[MAX_TEV_STAGES];
+    uint8_t  tev_a_out[MAX_TEV_STAGES];
+    uint8_t  tev_kcsel[MAX_TEV_STAGES];
+    uint8_t  tev_kasel[MAX_TEV_STAGES];
+    uint8_t  tev_tex_map[MAX_TEV_STAGES];
+} TevCacheKey;
+
+typedef struct TevCacheVal {
+    float tev_mod[4];
+    float tev_mod2[4];
+    int   tev_lerp_mode;
+} TevCacheVal;
+
+static __thread TevCacheKey s_last_tev_key;
+static __thread TevCacheVal s_last_tev_val;
+static __thread bool        s_last_tev_valid = false;
+
+static inline void evaluate_state_tev_uniforms(const RenderDrawState* state,
+                                               float out_tev_mod[4],
+                                               float out_tev_mod2[4],
+                                               int* out_lerp_mode) {
+    if (!state) {
+        out_tev_mod[0] = 1.0f; out_tev_mod[1] = 1.0f; out_tev_mod[2] = 1.0f; out_tev_mod[3] = 1.0f;
+        out_tev_mod2[0] = 0.0f; out_tev_mod2[1] = 0.0f; out_tev_mod2[2] = 0.0f; out_tev_mod2[3] = 0.0f;
+        *out_lerp_mode = 0;
+        return;
+    }
+
+    TevCacheKey cur_key;
+    memset(&cur_key, 0, sizeof(cur_key));
+    cur_key.texture_id = state->texture_id;
+    cur_key.texture1_id = state->texture1_id;
+    cur_key.num_tev_stages = state->num_tev_stages;
+    cur_key.blend_enable = state->blend_enable;
+    cur_key.blend_dst = state->blend_dst;
+    memcpy(cur_key.tev_regs, state->tev_regs, sizeof(cur_key.tev_regs));
+    memcpy(cur_key.kcolors, state->kcolors, sizeof(cur_key.kcolors));
+    memcpy(cur_key.tev_c_in, state->tev_c_in, sizeof(cur_key.tev_c_in));
+    memcpy(cur_key.tev_a_in, state->tev_a_in, sizeof(cur_key.tev_a_in));
+    memcpy(cur_key.tev_c_out, state->tev_c_out, sizeof(cur_key.tev_c_out));
+    memcpy(cur_key.tev_a_out, state->tev_a_out, sizeof(cur_key.tev_a_out));
+    memcpy(cur_key.tev_kcsel, state->tev_kcsel, sizeof(cur_key.tev_kcsel));
+    memcpy(cur_key.tev_kasel, state->tev_kasel, sizeof(cur_key.tev_kasel));
+    memcpy(cur_key.tev_tex_map, state->tev_tex_map, sizeof(cur_key.tev_tex_map));
+
+    if (s_last_tev_valid && memcmp(&cur_key, &s_last_tev_key, sizeof(TevCacheKey)) == 0) {
+        memcpy(out_tev_mod, s_last_tev_val.tev_mod, sizeof(s_last_tev_val.tev_mod));
+        memcpy(out_tev_mod2, s_last_tev_val.tev_mod2, sizeof(s_last_tev_val.tev_mod2));
+        *out_lerp_mode = s_last_tev_val.tev_lerp_mode;
+        return;
+    }
+
+    evaluate_state_tev_uniforms_uncached(state, out_tev_mod, out_tev_mod2, out_lerp_mode);
+
+    memcpy(s_last_tev_val.tev_mod, out_tev_mod, sizeof(s_last_tev_val.tev_mod));
+    memcpy(s_last_tev_val.tev_mod2, out_tev_mod2, sizeof(s_last_tev_val.tev_mod2));
+    s_last_tev_val.tev_lerp_mode = *out_lerp_mode;
+    s_last_tev_key = cur_key;
+    s_last_tev_valid = true;
+}
+
+extern uint8_t gm_GetCurrentGameMode(void);
+
+static void render_thread_check_screenshot(int frame) {
+    const char* path = getenv("MELEE_SCREENSHOT_PATH");
+    if (!path) return;
+
+    int should_capture = 0;
+    const char* title_shot_str = getenv("MELEE_SCREENSHOT_TITLE");
+    if (title_shot_str) {
+        static int s_title_frames = 0;
+        if (gm_GetCurrentGameMode() == 0x00) {
+            s_title_frames++;
+            int target_title_f = atoi(title_shot_str);
+            if (target_title_f <= 0) target_title_f = 60;
+            if (s_title_frames == target_title_f) {
+                should_capture = 1;
+            }
+        }
+    }
+    const char* frames_str = getenv("MELEE_SCREENSHOT_FRAMES");
+    const char* interval_str = getenv("MELEE_SCREENSHOT_INTERVAL");
+    const char* frame_str = getenv("MELEE_SCREENSHOT_FRAME");
+
+    if (frames_str) {
+        char buf[512];
+        strncpy(buf, frames_str, sizeof(buf) - 1);
+        buf[sizeof(buf) - 1] = '\0';
+        char* token = strtok(buf, ", ");
+        while (token) {
+            if (atoi(token) == frame) {
+                should_capture = 1;
+                break;
+            }
+            token = strtok(NULL, ", ");
+        }
+    } else if (interval_str) {
+        int interval = atoi(interval_str);
+        const char* start_str = getenv("MELEE_SCREENSHOT_START");
+        int start_f = start_str ? atoi(start_str) : 300;
+        if (interval > 0 && frame >= start_f && ((frame - start_f) % interval == 0)) {
+            should_capture = 1;
+        }
+    } else if (frame_str) {
+        int target = atoi(frame_str);
+        if (frame == target) {
+            should_capture = 1;
+        }
+    }
+
+    if (!should_capture) return;
+
+    char out_path[512];
+    if (strchr(path, '%')) {
+        snprintf(out_path, sizeof(out_path), path, frame);
+    } else if (frames_str || interval_str) {
+        char base[512];
+        strncpy(base, path, sizeof(base) - 1);
+        base[sizeof(base) - 1] = '\0';
+        char* ext = strrchr(base, '.');
+        if (ext && strcmp(ext, ".bmp") == 0) {
+            *ext = '\0';
+            snprintf(out_path, sizeof(out_path), "%s_f%04d.bmp", base, frame);
+        } else {
+            snprintf(out_path, sizeof(out_path), "%s_f%04d.bmp", base, frame);
+        }
+    } else {
+        snprintf(out_path, sizeof(out_path), "%s", path);
+    }
+
+    uint32_t* pixels = (uint32_t*)malloc(s_width * s_height * sizeof(uint32_t));
+    if (pixels) {
+        glFinish();
+        glReadPixels(0, 0, s_width, s_height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+        uint32_t* flipped = (uint32_t*)malloc(s_width * s_height * sizeof(uint32_t));
+        if (flipped) {
+            for (int y = 0; y < s_height; y++) {
+                const uint8_t* src_row = (const uint8_t*)&pixels[y * s_width];
+                uint8_t* dst_row = (uint8_t*)&flipped[y * s_width];
+                for (int x = 0; x < s_width; x++) {
+                    dst_row[x * 4 + 0] = src_row[x * 4 + 2]; /* B */
+                    dst_row[x * 4 + 1] = src_row[x * 4 + 1]; /* G */
+                    dst_row[x * 4 + 2] = src_row[x * 4 + 0]; /* R */
+                    dst_row[x * 4 + 3] = src_row[x * 4 + 3]; /* A */
+                }
+            }
+            uint8_t header[54];
+            memset(header, 0, sizeof(header));
+            header[0] = 'B'; header[1] = 'M';
+            uint32_t file_size = 54 + s_width * s_height * 4;
+            memcpy(&header[2], &file_size, 4);
+            uint32_t offset = 54;
+            memcpy(&header[10], &offset, 4);
+            uint32_t dib_size = 40;
+            memcpy(&header[14], &dib_size, 4);
+            memcpy(&header[18], &s_width, 4);
+            int32_t pos_h = s_height;
+            memcpy(&header[22], &pos_h, 4);
+            uint16_t planes = 1, bpp = 32;
+            memcpy(&header[26], &planes, 2);
+            memcpy(&header[28], &bpp, 2);
+            FILE* f = fopen(out_path, "wb");
+            if (f) {
+                fwrite(header, 1, 54, f);
+                fwrite(flipped, 4, s_width * s_height, f);
+                fclose(f);
+                fprintf(stderr, "[Melee-RenderThread] Screenshot frame %d saved to '%s'.\n", frame, out_path);
+            } else {
+                fprintf(stderr, "[Melee-RenderThread] Warning: Could not open '%s' for writing screenshot.\n", out_path);
+            }
+            free(flipped);
+        }
+        free(pixels);
+    }
+    if (getenv("MELEE_SCREENSHOT_EXIT")) {
+        fprintf(stderr, "[Melee-RenderThread] Screenshot frame %d saved. Exiting cleanly (MELEE_SCREENSHOT_EXIT).\n", frame);
+        fflush(stderr);
+        Port_PAD_ResumeES();
+        _exit(0);
+    }
+}
+
+static inline bool is_alpha_test_always_pass(uint8_t comp0, uint8_t op, uint8_t comp1) {
+    if (comp0 == 7 && comp1 == 7) return true;
+    if (op == 1 && (comp0 == 7 || comp1 == 7)) return true;
+    if (op == 3 && ((comp0 == 7 && comp1 == 7) || (comp0 == 0 && comp1 == 0))) return true;
+    return false;
+}
