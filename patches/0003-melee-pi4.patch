+void GXPosition3f32(float x, float y, float z) {
+    s_imm_tex_attr = GX_VA_TEX0;
+    float raw[3] = {x, y, z};
+    transform_pos(raw, s_current_mtx_id, s_current_vtx.pos);
+
+    uint32_t ux, uy, uz;
+    memcpy(&ux, &s_current_vtx.pos[0], 4);
+    memcpy(&uy, &s_current_vtx.pos[1], 4);
+    memcpy(&uz, &s_current_vtx.pos[2], 4);
+    if (__builtin_expect(((ux & 0x7F800000) == 0x7F800000) |
+                         ((uy & 0x7F800000) == 0x7F800000) |
+                         ((uz & 0x7F800000) == 0x7F800000), 0)) {
+        return;
+    }
+
+    if (__builtin_expect(s_vert_count < MAX_IMMEDIATE_VERTS, 1)) {
+        s_vert_buffer[s_vert_count++] = s_current_vtx;
+    }
+}
