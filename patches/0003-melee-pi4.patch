+    VIRetraceCallback old = s_pre_retrace_cb;
+    s_pre_retrace_cb = cb;
+    return old;
+}
+
+VIRetraceCallback VISetPostRetraceCallback(VIRetraceCallback cb) {
+    VIRetraceCallback old = s_post_retrace_cb;
+    s_post_retrace_cb = cb;
+    return old;
+}
