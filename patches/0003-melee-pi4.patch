+    /* Initialize Recording / Playback if requested */
+    const char* env_rec = getenv("MELEE_RECORD_INPUT");
+    if (!env_rec) env_rec = getenv("PORT_RECORD_INPUT");
+    if (env_rec && env_rec[0] != '\0' && strcmp(env_rec, "0") != 0) {
+        if (strcmp(env_rec, "1") == 0) {
