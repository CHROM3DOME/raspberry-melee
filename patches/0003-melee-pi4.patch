+#if defined(TARGET_PI4)
+    fprintf(stderr, "[Melee-VI] Video interface initialized (%dx%d @ Mesa KMSDRM).\n", width, height);
+#elif defined(TARGET_PI_TIN)
+    fprintf(stderr, "[Melee-VI] Video interface initialized (%dx%d @ DispmanX layer 10010).\n", width, height);
+#else
+    const char* dmx_env = getenv("SDL_RPI_VIDEO_LAYER");
+    fprintf(stderr, "[Melee-VI] Video interface initialized (%dx%d @ DispmanX layer %s).\n", width, height, dmx_env ? dmx_env : "10000");
+#endif
+}
