+void C_MTXRotTrig(Mtx m, char axis, f32 sinA, f32 cosA) {
+  assert(m && "MTXRotTrig():  NULL MtxPtr 'm' ");
+  switch(axis) {
+  case 'x':
+  case 'X':
+    m[0][0] = 1;
+    m[0][1] = 0;
+    m[0][2] = 0;
+    m[0][3] = 0;
+    m[1][0] = 0;
+    m[1][1] = cosA;
+    m[1][2] = -sinA;
+    m[1][3] = 0;
+    m[2][0] = 0;
+    m[2][1] = sinA;
+    m[2][2] = cosA;
+    m[2][3] = 0;
+    break;
+  case 'y':
+  case 'Y':
+    m[0][0] = cosA;
+    m[0][1] = 0;
+    m[0][2] = sinA;
+    m[0][3] = 0;
+    m[1][0] = 0;
+    m[1][1] = 1;
+    m[1][2] = 0;
+    m[1][3] = 0;
+    m[2][0] = -sinA;
+    m[2][1] = 0;
+    m[2][2] = cosA;
+    m[2][3] = 0;
+    break;
+  case 'z':
+  case 'Z':
+    m[0][0] = cosA;
+    m[0][1] = -sinA;
+    m[0][2] = 0;
+    m[0][3] = 0;
+    m[1][0] = sinA;
+    m[1][1] = cosA;
+    m[1][2] = 0;
+    m[1][3] = 0;
+    m[2][0] = 0;
+    m[2][1] = 0;
+    m[2][2] = 1;
+    m[2][3] = 0;
+    break;
+  default:
+    assert(0 && "MTXRotTrig():  invalid 'axis' value ");
+    break;
+  }
+}
