+static struct sockaddr_in s_local_addr;
+static struct sockaddr_in s_peer_addr;
+static socklen_t          s_peer_len = sizeof(struct sockaddr_in);
+static bool               s_has_peer = false;
+
+static uint32_t           s_sender_id = 0;
+static uint32_t           s_net_delay = 2;    /* 2 frames = 33.3 ms delay buffer */
+static uint32_t           s_current_frame = 0;
+static uint32_t           s_highest_peer_frame = 0;
+
+static PADStatus          s_local_ring[RING_SIZE];
+static uint32_t           s_local_ring_frame[RING_SIZE];
+
+static PADStatus          s_remote_ring[RING_SIZE];
+static uint32_t           s_remote_ring_frame[RING_SIZE];
+static PADStatus          s_last_remote_pad;
+
+static uint64_t           s_last_beacon_ms = 0;
+static uint64_t           s_last_rx_ms = 0;
+static uint32_t           s_packet_count_tx = 0;
+static uint32_t           s_packet_count_rx = 0;
+static uint32_t           s_stalls = 0;
+
+static uint64_t get_time_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000ULL + (uint64_t)(ts.tv_nsec / 1000000ULL);
+}
+
+static uint32_t calc_checksum(const MeleeNetPacket* pkt) {
+    const uint8_t* p = (const uint8_t*)pkt;
+    size_t len = sizeof(MeleeNetPacket) - sizeof(uint32_t);
+    uint32_t hash = 2166136261u;
+    for (size_t i = 0; i < len; i++) {
+        hash ^= p[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static void send_packet(MeleeNetMsgType msg_type, uint32_t frame, const PADStatus* pad_curr, const PADStatus* pad_prev, uint32_t seed) {
+    if (s_sockfd < 0 || !s_has_peer) return;
+
+    MeleeNetPacket pkt;
+    memset(&pkt, 0, sizeof(pkt));
+    pkt.magic = MELEE_NET_MAGIC;
+    pkt.version = MELEE_NET_VERSION;
+    pkt.msg_type = (uint16_t)msg_type;
+    pkt.sender_id = s_sender_id;
+    pkt.frame = frame;
+    pkt.ack_frame = s_highest_peer_frame;
+    if (pad_curr) pkt.pad_curr = *pad_curr;
+    if (pad_prev) pkt.pad_prev = *pad_prev;
+    pkt.rand_seed = seed;
+    pkt.checksum = calc_checksum(&pkt);
+
+    sendto(s_sockfd, &pkt, sizeof(pkt), 0, (struct sockaddr*)&s_peer_addr, sizeof(s_peer_addr));
+    s_packet_count_tx++;
+}
+
+static void broadcast_beacon(uint16_t port) {
+    if (s_sockfd < 0) return;
+
+    struct sockaddr_in bcast_addr;
+    memset(&bcast_addr, 0, sizeof(bcast_addr));
+    bcast_addr.sin_family = AF_INET;
+    bcast_addr.sin_port = htons(port);
+    bcast_addr.sin_addr.s_addr = htonl(INADDR_BROADCAST);
+
+    MeleeNetPacket pkt;
+    memset(&pkt, 0, sizeof(pkt));
+    pkt.magic = MELEE_NET_MAGIC;
+    pkt.version = MELEE_NET_VERSION;
+    pkt.msg_type = (uint16_t)NET_MSG_BEACON;
+    pkt.sender_id = s_sender_id;
+    pkt.checksum = calc_checksum(&pkt);
+
+    sendto(s_sockfd, &pkt, sizeof(pkt), 0, (struct sockaddr*)&bcast_addr, sizeof(bcast_addr));
+}
+
+bool Port_Net_Init(void) {
+    const char* env_net   = getenv("MELEE_NET");        /* Direct target: "ip:port" or "ip" */
+    const char* env_host  = getenv("MELEE_NET_HOST");   /* "1" = Act as Host */
+    const char* env_join  = getenv("MELEE_NET_JOIN");   /* "1" = Auto-discover on LAN */
+    const char* env_port  = getenv("MELEE_NET_PORT");   /* Local port */
+    const char* env_delay = getenv("MELEE_NET_DELAY");  /* Input delay buffer frames */
+
+    if (!env_net && !env_host && !env_join) {
+        /* Offline mode */
+        s_net_active = false;
+        return false;
+    }
+
+    s_net_active = true;
+    s_sender_id = (uint32_t)get_time_ms() ^ (uint32_t)getpid();
+    memset(&s_last_remote_pad, 0, sizeof(s_last_remote_pad));
+
+    if (env_delay) {
+        int d = atoi(env_delay);
+        if (d >= 0 && d <= 10) s_net_delay = (uint32_t)d;
+    }
+
+    uint16_t local_port = env_port ? (uint16_t)atoi(env_port) : MELEE_NET_PORT_DEFAULT;
+
+    s_sockfd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (s_sockfd < 0) {
+        fprintf(stderr, "[Melee-Net] Error creating UDP socket: %s\n", strerror(errno));
+        s_net_active = false;
+        return false;
+    }
+
+    /* Enable SO_BROADCAST for LAN auto-discovery */
+    int bcast_opt = 1;
+    setsockopt(s_sockfd, SOL_SOCKET, SO_BROADCAST, &bcast_opt, sizeof(bcast_opt));
+
+    /* Enable SO_REUSEADDR */
+    int reuse_opt = 1;
+    setsockopt(s_sockfd, SOL_SOCKET, SO_REUSEADDR, &reuse_opt, sizeof(reuse_opt));
+
+    /* Non-blocking socket */
+    int flags = fcntl(s_sockfd, F_GETFL, 0);
+    fcntl(s_sockfd, F_SETFL, flags | O_NONBLOCK);
+
+    memset(&s_local_addr, 0, sizeof(s_local_addr));
+    s_local_addr.sin_family = AF_INET;
+    s_local_addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    s_local_addr.sin_port = htons(local_port);
+
+    if (bind(s_sockfd, (struct sockaddr*)&s_local_addr, sizeof(s_local_addr)) < 0) {
+        fprintf(stderr, "[Melee-Net] Bind failed on port %u: %s\n", local_port, strerror(errno));
+        close(s_sockfd);
+        s_sockfd = -1;
+        s_net_active = false;
+        return false;
+    }
+
+    fprintf(stderr, "[Melee-Net] Initialized UDP socket on port %u (Delay: %u frames, ID: 0x%08X)\n",
+            local_port, s_net_delay, s_sender_id);
+
+    if (env_host || (!env_net && !env_join)) {
+        s_is_host = true;
+        s_local_slot = 0;
+        s_remote_slot = 1;
+        fprintf(stderr, "[Melee-Net] Operating in HOST mode (Player 1). Waiting for peer...\n");
+    } else {
+        s_is_host = false;
+        s_local_slot = 1;
+        s_remote_slot = 0;
+        fprintf(stderr, "[Melee-Net] Operating in CLIENT mode (Player 2).\n");
+
+        if (env_net) {
+            char host_str[128];
+            uint16_t peer_port = MELEE_NET_PORT_DEFAULT;
+            strncpy(host_str, env_net, sizeof(host_str) - 1);
+            char* col = strchr(host_str, ':');
+            if (col) {
+                *col = '\0';
+                peer_port = (uint16_t)atoi(col + 1);
+            }
+
+            memset(&s_peer_addr, 0, sizeof(s_peer_addr));
+            s_peer_addr.sin_family = AF_INET;
+            s_peer_addr.sin_port = htons(peer_port);
+            if (inet_pton(AF_INET, host_str, &s_peer_addr.sin_addr) > 0) {
+                s_has_peer = true;
+                fprintf(stderr, "[Melee-Net] Direct target configured: %s:%u\n", host_str, peer_port);
+                /* Send initial connect handshake */
+                send_packet(NET_MSG_CONNECT, 0, NULL, NULL, 0);
+            }
+        } else {
+            fprintf(stderr, "[Melee-Net] Auto-discovery active. Listening for host beacon on port %u...\n", local_port);
+        }
+    }
+
+    /* Initialize rings with invalid frame numbers */
+    for (int i = 0; i < RING_SIZE; i++) {
+        s_local_ring_frame[i] = 0xFFFFFFFF;
+        s_remote_ring_frame[i] = 0xFFFFFFFF;
+    }
+
+    return true;
+}
+
+bool Port_Net_IsActive(void) {
+    return s_net_active;
+}
+
+bool Port_Net_IsConnected(void) {
+    return s_net_connected;
+}
+
+int Port_Net_LocalPlayer(void) {
+    return s_local_slot;
+}
+
+int Port_Net_RemotePlayer(void) {
+    return s_remote_slot;
+}
+
+uint32_t Port_Net_Frame(void) {
+    return s_current_frame;
+}
+
+void Port_Net_Poll(void) {
+    if (!s_net_active || s_sockfd < 0) return;
+
+    uint64_t now = get_time_ms();
+
+    /* Host: Broadcast discovery beacon every 500 ms until connected */
+    if (s_is_host && !s_net_connected) {
+        if (now - s_last_beacon_ms > 500) {
+            s_last_beacon_ms = now;
+            broadcast_beacon(MELEE_NET_PORT_DEFAULT);
+        }
+    }
+
+    /* Client: Resend connect request every 500 ms if peer is known but not yet connected */
+    if (!s_is_host && s_has_peer && !s_net_connected) {
+        if (now - s_last_beacon_ms > 500) {
+            s_last_beacon_ms = now;
+            send_packet(NET_MSG_CONNECT, 0, NULL, NULL, 0);
+        }
+    }
+
+    /* Receive incoming packets */
+    MeleeNetPacket pkt;
+    struct sockaddr_in from_addr;
+    socklen_t from_len = sizeof(from_addr);
+
+    while (1) {
+        ssize_t n = recvfrom(s_sockfd, &pkt, sizeof(pkt), 0, (struct sockaddr*)&from_addr, &from_len);
+        if (n <= 0) break;
+        if (n < (ssize_t)sizeof(MeleeNetPacket)) continue;
+        if (pkt.magic != MELEE_NET_MAGIC || pkt.version != MELEE_NET_VERSION) continue;
+        if (calc_checksum(&pkt) != pkt.checksum) continue;
+        if (pkt.sender_id == s_sender_id) continue; /* Drop self-echoed broadcasts */
+
+        s_packet_count_rx++;
+        s_last_rx_ms = now;
+
+        switch (pkt.msg_type) {
+            case NET_MSG_BEACON:
+                if (!s_is_host && !s_has_peer) {
+                    s_peer_addr = from_addr;
+                    s_has_peer = true;
+                    char ip_buf[INET_ADDRSTRLEN];
+                    inet_ntop(AF_INET, &s_peer_addr.sin_addr, ip_buf, sizeof(ip_buf));
+                    fprintf(stderr, "[Melee-Net] Discovered Host beacon from %s:%u! Sending connect request...\n",
+                            ip_buf, ntohs(s_peer_addr.sin_port));
+                    send_packet(NET_MSG_CONNECT, 0, NULL, NULL, 0);
+                }
+                break;
+
+            case NET_MSG_CONNECT:
+                if (s_is_host) {
+                    s_peer_addr = from_addr;
+                    s_has_peer = true;
+                    s_net_connected = true;
+
+                    /* Generate deterministic match seed */
+                    uint32_t seed = (uint32_t)now ^ (s_sender_id + pkt.sender_id);
+                    if (HSD_RandSeedPtr) {
+                        *HSD_RandSeedPtr = seed;
+                    }
+
+                    char ip_buf[INET_ADDRSTRLEN];
+                    inet_ntop(AF_INET, &s_peer_addr.sin_addr, ip_buf, sizeof(ip_buf));
+                    fprintf(stderr, "[Melee-Net] Client connected from %s:%u! Agreed match seed: 0x%08X\n",
+                            ip_buf, ntohs(s_peer_addr.sin_port), seed);
+
+                    send_packet(NET_MSG_ACCEPT, 0, NULL, NULL, seed);
+                }
+                break;
+
+            case NET_MSG_ACCEPT:
+                if (!s_is_host && !s_net_connected) {
+                    s_peer_addr = from_addr;
+                    s_has_peer = true;
+                    s_net_connected = true;
+
+                    if (HSD_RandSeedPtr && pkt.rand_seed != 0) {
+                        *HSD_RandSeedPtr = pkt.rand_seed;
+                    }
+
+                    char ip_buf[INET_ADDRSTRLEN];
+                    inet_ntop(AF_INET, &s_peer_addr.sin_addr, ip_buf, sizeof(ip_buf));
+                    fprintf(stderr, "[Melee-Net] Connected to Host %s:%u! Synchronized seed: 0x%08X\n",
+                            ip_buf, ntohs(s_peer_addr.sin_port), pkt.rand_seed);
+                }
+                break;
+
+            case NET_MSG_INPUT:
+                if (!s_net_connected) {
+                    s_net_connected = true;
+                }
+                if (pkt.frame > s_highest_peer_frame) {
+                    s_highest_peer_frame = pkt.frame;
+                }
+
+                /* Store primary frame input */
+                uint32_t idx = pkt.frame & RING_MASK;
+                s_remote_ring[idx] = pkt.pad_curr;
+                s_remote_ring_frame[idx] = pkt.frame;
+
+                /* Store redundant previous frame input if newer */
+                if (pkt.frame > 0) {
+                    uint32_t prev_idx = (pkt.frame - 1) & RING_MASK;
+                    if (s_remote_ring_frame[prev_idx] != (pkt.frame - 1)) {
+                        s_remote_ring[prev_idx] = pkt.pad_prev;
+                        s_remote_ring_frame[prev_idx] = pkt.frame - 1;
+                    }
+                }
+                break;
+
+            case NET_MSG_DISCONNECT:
+                fprintf(stderr, "[Melee-Net] Peer disconnected cleanly.\n");
+                s_net_connected = false;
+                break;
+
+            default:
+                break;
+        }
+    }
+}
+
+bool Port_Net_Step(const PADStatus* local_in, PADStatus* local_out, PADStatus* remote_out) {
+    if (!s_net_active) return false;
+
+    Port_Net_Poll();
+
+    /* 1. Schedule local input for (current_frame + delay) */
+    uint32_t tx_frame = s_current_frame + s_net_delay;
+    uint32_t tx_idx = tx_frame & RING_MASK;
+    s_local_ring[tx_idx] = *local_in;
+    s_local_ring_frame[tx_idx] = tx_frame;
+
+    /* Previous frame input for redundancy */
+    PADStatus* prev_pad = NULL;
+    if (tx_frame > 0) {
+        prev_pad = &s_local_ring[(tx_frame - 1) & RING_MASK];
+    }
+
+    /* Send input packet to peer */
+    if (s_has_peer) {
+        send_packet(NET_MSG_INPUT, tx_frame, local_in, prev_pad, 0);
+    }
+
+    /* 2. Retrieve local input for execution at s_current_frame */
+    uint32_t cur_idx = s_current_frame & RING_MASK;
+    if (s_local_ring_frame[cur_idx] == s_current_frame) {
+        *local_out = s_local_ring[cur_idx];
+    } else {
+        /* Neutral input during initial startup buffer frames */
+        memset(local_out, 0, sizeof(PADStatus));
+    }
+
+    /* 3. Retrieve remote input for execution at s_current_frame */
+    if (s_net_connected) {
+        if (s_remote_ring_frame[cur_idx] != s_current_frame) {
+            /* Input not yet received: poll socket with short timeout */
+            struct pollfd pfd;
+            pfd.fd = s_sockfd;
+            pfd.events = POLLIN;
+            pfd.revents = 0;
+
+            int poll_res = poll(&pfd, 1, 6); /* Wait up to 6 ms */
+            if (poll_res > 0 && (pfd.revents & POLLIN)) {
+                Port_Net_Poll();
+            }
+        }
+
+        if (s_remote_ring_frame[cur_idx] == s_current_frame) {
+            *remote_out = s_remote_ring[cur_idx];
+            s_last_remote_pad = *remote_out;
+        } else {
+            /* Packet late: repeat last remote input */
+            *remote_out = s_last_remote_pad;
+            s_stalls++;
+            if ((s_stalls % 60) == 1) {
+                fprintf(stderr, "[Melee-Net] Jitter stall at frame %u (peer frame: %u)\n",
+                        s_current_frame, s_highest_peer_frame);
+            }
+        }
+    } else {
+        /* While waiting for connection, remote player is idle */
+        memset(remote_out, 0, sizeof(PADStatus));
+    }
+
+    s_current_frame++;
+    return true;
+}
+
+void Port_Net_Shutdown(void) {
+    if (s_sockfd >= 0) {
+        if (s_has_peer) {
+            send_packet(NET_MSG_DISCONNECT, s_current_frame, NULL, NULL, 0);
+        }
+        close(s_sockfd);
+        s_sockfd = -1;
+    }
+    s_net_active = false;
+    s_net_connected = false;
+    fprintf(stderr, "[Melee-Net] Netplay engine shutdown (Frames: %u, TX: %u, RX: %u, Stalls: %u)\n",
+            s_current_frame, s_packet_count_tx, s_packet_count_rx, s_stalls);
+}
diff --git a/src/port/port_os.c b/src/port/port_os.c
new file mode 100755
index 0000000..a8ca618
--- /dev/null
+++ b/src/port/port_os.c
@@ -0,0 +1,402 @@
+#define _GNU_SOURCE
+#include "port/port_os.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <time.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <dolphin/types.h>
+
+#if !defined(_WIN32)
+#include <sys/mman.h>
+#endif
+
+#define GC_MEM_SIZE (48 * 1024 * 1024)
+
+static uint8_t* s_arena_base = NULL;
+static uint8_t* s_arena_lo   = NULL;
+static uint8_t* s_arena_hi   = NULL;
+static uint64_t s_boot_time_ns = 0;
+
+uintptr_t OSBaseAddress = 0;
+
+static uint64_t get_time_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+/* ========================================================================= */
+/* OS Interrupts & Alarms Implementation                                     */
+/* ========================================================================= */
+
+static pthread_mutex_t s_intr_mutex = PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP;
+static __thread int s_intr_depth = 0;
+static __thread int s_is_game_thread = 0;
+
+static OSAlarm* s_alarms = NULL;
+
+void OSInitAlarm(void) {}
+
+void OSCreateAlarm(OSAlarm* alarm) {
+    if (!alarm) return;
+    alarm->handler = NULL;
+    alarm->tag = 0;
+    alarm->prev = alarm->next = NULL;
+    alarm->period = 0;
+    alarm->start = 0;
+    alarm->fire = 0;
+}
+
+static void insert_alarm(OSAlarm* alarm, OSTime fire, OSAlarmHandler handler) {
+    BOOL intr = OSDisableInterrupts();
+    if (alarm->handler) {
+        OSCancelAlarm(alarm);
+    }
+    alarm->handler = handler;
+    alarm->fire = fire;
+    alarm->prev = NULL;
+    alarm->next = s_alarms;
+    if (s_alarms) {
+        s_alarms->prev = alarm;
+    }
+    s_alarms = alarm;
+    OSRestoreInterrupts(intr);
+}
+
+void OSSetAlarm(OSAlarm* alarm, OSTime tick, OSAlarmHandler handler) {
+    if (!alarm) return;
+    alarm->period = 0;
+    insert_alarm(alarm, OSGetTime() + tick, handler);
+}
+
+void OSSetAbsAlarm(OSAlarm* alarm, OSTime time, OSAlarmHandler handler) {
+    if (!alarm) return;
+    alarm->period = 0;
+    insert_alarm(alarm, time, handler);
+}
+
+void OSSetPeriodicAlarm(OSAlarm* alarm, OSTime start, OSTime period, OSAlarmHandler handler) {
+    if (!alarm) return;
+    alarm->period = period;
+    alarm->start = start;
+    insert_alarm(alarm, OSGetTime() + start, handler);
+}
+
+void OSCancelAlarm(OSAlarm* alarm) {
+    if (!alarm) return;
+    BOOL intr = OSDisableInterrupts();
+    if (alarm->handler) {
+        if (alarm->prev) {
+            alarm->prev->next = alarm->next;
+        } else if (s_alarms == alarm) {
+            s_alarms = alarm->next;
+        }
+        if (alarm->next) {
+            alarm->next->prev = alarm->prev;
+        }
+        alarm->handler = NULL;
+        alarm->prev = alarm->next = NULL;
+    }
+    OSRestoreInterrupts(intr);
+}
+
+void OSSetAlarmTag(OSAlarm* alarm, u32 tag) {
+    if (alarm) alarm->tag = tag;
+}
+
+void OSCancelAlarms(u32 tag) {
+    BOOL intr = OSDisableInterrupts();
+    for (OSAlarm* a = s_alarms; a;) {
+        OSAlarm* next = a->next;
+        if (a->tag == tag) {
+            OSCancelAlarm(a);
+        }
+        a = next;
+    }
+    OSRestoreInterrupts(intr);
+}
+
+BOOL OSCheckAlarmQueue(void) {
+    return s_alarms != NULL;
+}
+
+void pc_os_run_alarms(void) {
+    OSTime now = OSGetTime();
+    BOOL intr = OSDisableInterrupts();
+    for (OSAlarm* a = s_alarms; a;) {
+        OSAlarm* next = a->next;
+        if (a->fire <= now) {
+            OSAlarmHandler handler = a->handler;
+            if (a->period > 0) {
+                if (a->period <= OSMillisecondsToTicks(10)) {
+                    a->fire += a->period;
+                    if (a->fire <= now) {
+                        a->fire = now + a->period;
+                    }
+                    if (handler) handler(a, NULL);
+                } else {
+                    int max_catchup = 10;
+                    while (a->fire <= now && max_catchup-- > 0 && a->handler == handler) {
+                        a->fire += a->period;
+                        if (handler) handler(a, NULL);
+                    }
+                    if (a->fire <= now) {
+                        a->fire = now + a->period;
+                    }
+                }
+            } else {
+                OSCancelAlarm(a);
+                if (handler) handler(a, NULL);
+            }
+        }
+        a = next;
+    }
+    OSRestoreInterrupts(intr);
+}
+
+static void deliver_pending(void) {
+    static __thread int in_delivery = 0;
+    if (s_is_game_thread && !in_delivery) {
+        in_delivery = 1;
+        pc_os_run_alarms();
+        in_delivery = 0;
+    }
+}
+
+BOOL OSDisableInterrupts(void) {
+    pthread_mutex_lock(&s_intr_mutex);
+    return s_intr_depth++ == 0;
+}
+
+BOOL OSEnableInterrupts(void) {
+    BOOL was_enabled = (s_intr_depth == 0);
+    while (s_intr_depth > 0) {
+        s_intr_depth--;
+        pthread_mutex_unlock(&s_intr_mutex);
+    }
+    deliver_pending();
+    return was_enabled;
+}
+
+BOOL OSRestoreInterrupts(BOOL level) {
+    BOOL was_enabled = (s_intr_depth == 0);
+    if (level) {
+        OSEnableInterrupts();
+    } else if (s_intr_depth > 0) {
+        s_intr_depth--;
+        pthread_mutex_unlock(&s_intr_mutex);
+    }
+    return was_enabled;
+}
+
+int Port_OS_ReleaseInterruptsAll(void) {
+    int saved = s_intr_depth;
+    while (s_intr_depth > 0) {
+        s_intr_depth--;
+        pthread_mutex_unlock(&s_intr_mutex);
+    }
+    return saved;
+}
+
+void Port_OS_RestoreInterruptsDepth(int depth) {
+    while (s_intr_depth < depth) {
