+void GXSetViewport(float left, float top, float width, float height, float near_z, float far_z) {
+    (void)near_z;
+    (void)far_z;
+    s_viewport_x = left;
+    s_viewport_y = top;
+    s_viewport_w = (width > 0.0f) ? width : 640.0f;
+    s_viewport_h = (height > 0.0f) ? height : 480.0f;
+
+    /* Map from GameCube virtual 640x480 (Y-down) to display pillarboxed view (Y-up) */
+    float sx = (float)s_view_w / 640.0f;
+    float sy = (float)s_view_h / 480.0f;
+    float gl_w = width * sx;
+    float gl_h = height * sy;
+    float gl_x = (float)s_offset_x + left * sx;
+    float gl_y = (float)s_offset_y + (float)s_view_h - (top * sy) - gl_h;
+    if (gl_y < 0.0f) gl_y = 0.0f;
+    if (gl_x < 0.0f) gl_x = 0.0f;
+    if (gl_w < 1.0f) gl_w = 1.0f;
+    if (gl_h < 1.0f) gl_h = 1.0f;
+
+    s_current_state.viewport_box[0] = (int16_t)gl_x;
+    s_current_state.viewport_box[1] = (int16_t)gl_y;
+    s_current_state.viewport_box[2] = (int16_t)gl_w;
+    s_current_state.viewport_box[3] = (int16_t)gl_h;
+
+    if (Port_RenderThread_IsEnabled() || !s_gl_context) return;
+
+    glViewport((GLint)gl_x, (GLint)gl_y, (GLsizei)gl_w, (GLsizei)gl_h);
+}
+
+void GXSetScissor(uint32_t left, uint32_t top, uint32_t width, uint32_t height) {
+    float sx = (float)s_view_w / 640.0f;
+    float sy = (float)s_view_h / 480.0f;
+    float gl_w = (float)width * sx;
+    float gl_h = (float)height * sy;
+    float gl_x = (float)s_offset_x + (float)left * sx;
+    float gl_y = (float)s_offset_y + (float)s_view_h - ((float)top * sy) - gl_h;
+    if (gl_y < 0.0f) gl_y = 0.0f;
+    if (gl_x < 0.0f) gl_x = 0.0f;
+    if (gl_w < 1.0f) gl_w = 1.0f;
+    if (gl_h < 1.0f) gl_h = 1.0f;
+
+    s_current_state.scissor_box[0] = (int16_t)gl_x;
+    s_current_state.scissor_box[1] = (int16_t)gl_y;
+    s_current_state.scissor_box[2] = (int16_t)gl_w;
+    s_current_state.scissor_box[3] = (int16_t)gl_h;
+
+    if (Port_RenderThread_IsEnabled() || !s_gl_context) return;
+
+    glScissor((GLint)gl_x, (GLint)gl_y, (GLsizei)gl_w, (GLsizei)gl_h);
+}
