+AXVPB* AXAcquireVoice(u32 priority, void (*callback)(void*), u32 userContext) {
+    pthread_mutex_lock(&s_audio_mutex);
+    int chosen = -1;
+    for (int i = 0; i < AX_MAX_VOICES; i++) {
+        if (!s_voice_allocated[i]) {
+            chosen = i;
+            break;
+        }
+    }
+    if (chosen < 0) {
+        u32 lowest_prio = priority;
+        for (int i = 0; i < AX_MAX_VOICES; i++) {
+            if (s_voices[i].priority < (int)lowest_prio) {
+                lowest_prio = s_voices[i].priority;
+                chosen = i;
+            }
+        }
+        if (chosen >= 0 && s_voices[chosen].callback) {
+            void (*cb)(void*) = s_voices[chosen].callback;
+            s_voices[chosen].callback = NULL;
+            s_voices[chosen].pb.state = 0;
+            s_port_voices[chosen].active = false;
+            cb((void*)&s_voices[chosen]);
+        }
+    }
+    if (chosen >= 0) {
+        s_voice_allocated[chosen] = true;
+        AXVPB* p = &s_voices[chosen];
+        p->index = chosen;
+        p->priority = priority;
+        p->callback = callback;
+        p->userContext = userContext;
+        p->pb.state = 0;
+        s_port_voices[chosen].active = false;
+        static int s_acq_logs = 0;
+        if (++s_acq_logs <= 15 || (s_acq_logs % 50) == 0) {
+            fprintf(stderr, "[Melee-Audio] Acquired voice %d (prio=%u, total=%d)\n", chosen, priority, s_acq_logs);
+        }
+        pthread_mutex_unlock(&s_audio_mutex);
+        return p;
+    }
+    pthread_mutex_unlock(&s_audio_mutex);
+    return NULL;
+}
