+            if (s_controllers[gc_slot]) {
+                fprintf(stderr, "[Melee-Pad] Connected GameController (Port %d): %s\n", gc_slot + 1, SDL_GameControllerName(s_controllers[gc_slot]));
+                gc_slot++;
+            }
+        }
+    }
+
+    /* Acquire exclusive evdev grab on all open input event devices */
+    Port_PAD_GrabExclusive();
