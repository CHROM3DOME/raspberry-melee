+static inline void apply_tev_swap(uint8_t swap_sel, uint8_t in_r, uint8_t in_g, uint8_t in_b, uint8_t in_a,
+                                  uint8_t* out_r, uint8_t* out_g, uint8_t* out_b, uint8_t* out_a) {
+    switch (swap_sel) {
+        case 1: /* SWAP1: Red channel replicated */
+            *out_r = in_r; *out_g = in_r; *out_b = in_r; *out_a = in_a;
+            break;
+        case 2: /* SWAP2: Green channel replicated */
+            *out_r = in_g; *out_g = in_g; *out_b = in_g; *out_a = in_a;
+            break;
+        case 3: /* SWAP3: Blue channel replicated */
+            *out_r = in_b; *out_g = in_b; *out_b = in_b; *out_a = in_a;
+            break;
+        case 0: /* SWAP0: Identity */
+        default:
+            *out_r = in_r; *out_g = in_g; *out_b = in_b; *out_a = in_a;
+            break;
+    }
+}
