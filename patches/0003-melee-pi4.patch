+static inline u32 lbMthp_GetFrame(u32** rate_table, u32 counter)
+{
+    u32* rate_ptr = *rate_table;
+    u32 frame = 0;
+    u32 count;
+    u32 total;
+
+    if (rate_ptr != NULL) {
+        for (;; rate_ptr += 2) {
+            count = rate_ptr[0];
+            total = count * rate_ptr[1];
+            if (counter >= total) {
+                frame += count;
+                counter -= total;
+                continue;
+            } else {
+                frame += counter / rate_ptr[1];
+                break;
+            }
+        }
+    } else {
+        frame = counter;
+    }
+
+    return frame;
+}
