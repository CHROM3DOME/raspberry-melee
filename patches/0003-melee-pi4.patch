+void GXLoadTexMtxImm(const void* mtx, u32 id, GXTexMtxType type) {
+    if (mtx && id < 128) {
+        const float* f = (const float*)mtx;
+        s_tex_matrices[id][0][0] = f[0]; s_tex_matrices[id][0][1] = f[1]; s_tex_matrices[id][0][2] = f[2]; s_tex_matrices[id][0][3] = f[3];
+        s_tex_matrices[id][1][0] = f[4]; s_tex_matrices[id][1][1] = f[5]; s_tex_matrices[id][1][2] = f[6]; s_tex_matrices[id][1][3] = f[7];
+        if (type == GX_MTX3x4) {
+            s_tex_matrices[id][2][0] = f[8]; s_tex_matrices[id][2][1] = f[9]; s_tex_matrices[id][2][2] = f[10]; s_tex_matrices[id][2][3] = f[11];
+        } else {
+            s_tex_matrices[id][2][0] = 0.0f; s_tex_matrices[id][2][1] = 0.0f; s_tex_matrices[id][2][2] = 1.0f; s_tex_matrices[id][2][3] = 0.0f;
+        }
+        bool is_id = (fabsf(f[0] - 1.0f) < 1e-4f && fabsf(f[1]) < 1e-4f && fabsf(f[2]) < 1e-4f && fabsf(f[3]) < 1e-4f &&
+                      fabsf(f[4]) < 1e-4f && fabsf(f[5] - 1.0f) < 1e-4f && fabsf(f[6]) < 1e-4f && fabsf(f[7]) < 1e-4f);
+        if (type == GX_MTX3x4) {
+            is_id = is_id && (fabsf(f[8]) < 1e-4f && fabsf(f[9]) < 1e-4f && fabsf(f[10] - 1.0f) < 1e-4f && fabsf(f[11]) < 1e-4f);
+        }
+        s_tex_matrix_is_identity[id] = is_id;
+    }
+}
