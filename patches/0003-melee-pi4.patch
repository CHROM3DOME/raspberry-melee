+}
+
+static void poll_game_controller_channel(int chan, SDL_GameController* gc) {
+    if (!gc || chan < 0 || chan >= PAD_CHAN_MAX) return;
+    PADStatus* p = &s_pad_state[chan];
+    p->err = PAD_ERR_NONE;
+
+    int sel = SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_BACK) ||
+              SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_GUIDE);
+    int st  = SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_START);
+    if (sel && st) {
+        fprintf(stderr, "\n[Melee-Pad] GameController Select+Start (or Hotkey+Start) exit combo activated. Exiting cleanly...\n");
+        Port_PAD_ResumeES();
+        exit(0);
+    }
+
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_A)) p->button |= PAD_BUTTON_A;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_B)) p->button |= PAD_BUTTON_B;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_X)) p->button |= PAD_BUTTON_X;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_Y)) p->button |= PAD_BUTTON_Y;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_START)) p->button |= PAD_BUTTON_START;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_BACK))  p->button |= PAD_TRIGGER_Z;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_DPAD_UP))    p->button |= PAD_BUTTON_UP;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_DPAD_DOWN))  p->button |= PAD_BUTTON_DOWN;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_DPAD_LEFT))  p->button |= PAD_BUTTON_LEFT;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_DPAD_RIGHT)) p->button |= PAD_BUTTON_RIGHT;
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_LEFTSHOULDER)) {
+        p->button |= PAD_TRIGGER_L;
+        p->triggerLeft = 255;
+    }
+    if (SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER)) {
+        p->button |= PAD_TRIGGER_R;
+        p->triggerRight = 255;
+    }
+
+    int16_t lx = SDL_GameControllerGetAxis(gc, SDL_CONTROLLER_AXIS_LEFTX);
+    int16_t ly = SDL_GameControllerGetAxis(gc, SDL_CONTROLLER_AXIS_LEFTY);
+    int16_t rx = SDL_GameControllerGetAxis(gc, SDL_CONTROLLER_AXIS_RIGHTX);
+    int16_t ry = SDL_GameControllerGetAxis(gc, SDL_CONTROLLER_AXIS_RIGHTY);
+    int16_t lt = SDL_GameControllerGetAxis(gc, SDL_CONTROLLER_AXIS_TRIGGERLEFT);
+    int16_t rt = SDL_GameControllerGetAxis(gc, SDL_CONTROLLER_AXIS_TRIGGERRIGHT);
+
+    if (abs(lx) > 4000 && p->stickX == 0) p->stickX = (int8_t)(lx / 450);
+    if (abs(ly) > 4000 && p->stickY == 0) p->stickY = (int8_t)(-ly / 450);
+    if (abs(rx) > 4000 && p->substickX == 0) p->substickX = (int8_t)(rx / 450);
+    if (abs(ry) > 4000 && p->substickY == 0) p->substickY = (int8_t)(-ry / 450);
+
+    if (lt > 4000) {
+        p->triggerLeft = (uint8_t)(lt / 130);
+        p->button |= PAD_TRIGGER_L;
+    }
+    if (rt > 4000) {
+        p->triggerRight = (uint8_t)(rt / 130);
+        p->button |= PAD_TRIGGER_R;
+    }
+}
+
+void Port_PAD_PollEvents(void) {
+    SDL_Event ev;
+    while (SDL_PollEvent(&ev)) {
+        if (ev.type == SDL_QUIT) {
+            fprintf(stderr, "[Melee-Pad] SDL_QUIT requested. Exiting cleanly.\n");
+            Port_PAD_ResumeES();
+            exit(0);
+        } else if (ev.type == SDL_CONTROLLERDEVICEADDED) {
+            for (int i = 0; i < PAD_CHAN_MAX; i++) {
+                if (!s_controllers[i]) {
+                    s_controllers[i] = SDL_GameControllerOpen(ev.cdevice.which);
+                    if (s_controllers[i]) {
+                        fprintf(stderr, "[Melee-Pad] Hotplugged GameController to Port %d: %s\n", i + 1, SDL_GameControllerName(s_controllers[i]));
+                        Port_PAD_GrabExclusive();
+                    }
+                    break;
+                }
+            }
+        } else if (ev.type == SDL_CONTROLLERDEVICEREMOVED) {
+            for (int i = 0; i < PAD_CHAN_MAX; i++) {
+                if (s_controllers[i] && ev.cdevice.which == SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(s_controllers[i]))) {
+                    SDL_GameControllerClose(s_controllers[i]);
+                    s_controllers[i] = NULL;
+                    fprintf(stderr, "[Melee-Pad] Controller at Port %d removed.\n", i + 1);
+                    break;
+                }
+            }
+        } else if (ev.type == SDL_JOYDEVICEADDED) {
+            if (!s_joystick) {
+                s_joystick = SDL_JoystickOpen(ev.jdevice.which);
+                if (s_joystick) {
+                    fprintf(stderr, "[Melee-Pad] Hotplugged Joystick: %s\n", SDL_JoystickName(s_joystick));
+                    Port_PAD_GrabExclusive();
+                }
+            }
+        } else if (ev.type == SDL_JOYDEVICEREMOVED) {
+            if (s_joystick && ev.jdevice.which == SDL_JoystickInstanceID(s_joystick)) {
+                SDL_JoystickClose(s_joystick);
+                s_joystick = NULL;
+                fprintf(stderr, "[Melee-Pad] Joystick removed.\n");
+            }
+        }
+    }
+
+    memset(s_pad_state, 0, sizeof(s_pad_state));
+    for (int i = 0; i < PAD_CHAN_MAX; i++) {
+        s_pad_state[i].err = (s_controllers[i] != NULL) ? PAD_ERR_NONE : PAD_ERR_NO_CONTROLLER;
+    }
+    PADStatus* p = &s_pad_state[0];
+
+    /* 1. Direct Joystick Polling (GPIO Handheld / Generic Gamepad for Port 0) */
+    if (s_joystick) {
+        s_pad_state[0].err = PAD_ERR_NONE;
+        int nb = SDL_JoystickNumButtons(s_joystick);
+        int na = SDL_JoystickNumAxes(s_joystick);
+
+        /* Universal In-Engine Exit Combo: Select (8) + Start (9) or Hotkey (10) + Start (9) */
+        if (nb > 9) {
+            int sel = (SDL_JoystickGetButton(s_joystick, 8) || (nb > 10 && SDL_JoystickGetButton(s_joystick, 10)));
+            int st  = SDL_JoystickGetButton(s_joystick, 9);
+            if (sel && st) {
+                fprintf(stderr, "\n[Melee-Pad] Universal Select+Start exit combo activated. Exiting cleanly...\n");
+                Port_PAD_ResumeES();
+                exit(0);
+            }
+        }
+
+        /* Direct button mappings */
+        if (nb > 0 && SDL_JoystickGetButton(s_joystick, 0)) p->button |= PAD_BUTTON_A;
+        if (nb > 1 && SDL_JoystickGetButton(s_joystick, 1)) p->button |= PAD_BUTTON_B;
+        if (nb > 2 && SDL_JoystickGetButton(s_joystick, 2)) p->button |= PAD_BUTTON_X;
+        if (nb > 3 && SDL_JoystickGetButton(s_joystick, 3)) p->button |= PAD_BUTTON_Y;
+        if (nb > 4 && SDL_JoystickGetButton(s_joystick, 4)) { p->button |= PAD_TRIGGER_L; p->triggerLeft = 255; }
+        if (nb > 5 && SDL_JoystickGetButton(s_joystick, 5)) { p->button |= PAD_TRIGGER_R; p->triggerRight = 255; }
+        if (nb > 6 && SDL_JoystickGetButton(s_joystick, 6)) { p->button |= PAD_TRIGGER_L; p->triggerLeft = 255; }
+        if (nb > 7 && SDL_JoystickGetButton(s_joystick, 7)) p->button |= PAD_TRIGGER_Z;
+        if (nb > 8 && SDL_JoystickGetButton(s_joystick, 8)) p->button |= PAD_TRIGGER_Z;
+        if (nb > 9 && SDL_JoystickGetButton(s_joystick, 9)) p->button |= PAD_BUTTON_START;
+
+        /* Analog / D-Pad axes */
+        if (na >= 1) {
+            int16_t ax = SDL_JoystickGetAxis(s_joystick, 0);
+            if (ax < -8000) {
+                p->stickX = (int8_t)(ax / 450);
+                p->button |= PAD_BUTTON_LEFT;
+            } else if (ax > 8000) {
+                p->stickX = (int8_t)(ax / 450);
+                p->button |= PAD_BUTTON_RIGHT;
+            }
+        }
+        if (na >= 2) {
+            int16_t ay = SDL_JoystickGetAxis(s_joystick, 1);
+            if (ay < -8000) {
+                p->stickY = (int8_t)(-ay / 450); /* GameCube Y is inverted (up positive) */
+                p->button |= PAD_BUTTON_UP;
+            } else if (ay > 8000) {
+                p->stickY = (int8_t)(-ay / 450);
+                p->button |= PAD_BUTTON_DOWN;
+            }
+        }
+        /* C-Stick axes */
+        if (na >= 4) {
+            int16_t rx = SDL_JoystickGetAxis(s_joystick, 2);
+            int16_t ry = SDL_JoystickGetAxis(s_joystick, 3);
+            if (abs(rx) > 4000) p->substickX = (int8_t)(rx / 450);
+            if (abs(ry) > 4000) p->substickY = (int8_t)(-ry / 450);
+        }
+    }
+
+    /* 2. SDL Game Controller Polling (Ports 0..3) */
+    for (int i = 0; i < PAD_CHAN_MAX; i++) {
+        if (s_controllers[i]) {
+            poll_game_controller_channel(i, s_controllers[i]);
+        }
+    }
+
+    /* 3. Keyboard Fallback (for PC/dev testing, Port 0) */
+    const uint8_t* k = SDL_GetKeyboardState(NULL);
+    if (k && (k[SDL_SCANCODE_ESCAPE] || k[SDL_SCANCODE_Q])) {
+        fprintf(stderr, "[Melee-Pad] Exit key pressed. Exiting cleanly.\n");
+        Port_PAD_ResumeES();
+        exit(0);
+    }
+    if (k && !s_controllers[0] && !s_joystick) {
+        p->err = PAD_ERR_NONE;
+        if (k[SDL_SCANCODE_W] || k[SDL_SCANCODE_UP])    { p->stickY += 64; p->button |= PAD_BUTTON_UP; }
+        if (k[SDL_SCANCODE_S] || k[SDL_SCANCODE_DOWN])  { p->stickY -= 64; p->button |= PAD_BUTTON_DOWN; }
+        if (k[SDL_SCANCODE_D] || k[SDL_SCANCODE_RIGHT]) { p->stickX += 64; p->button |= PAD_BUTTON_RIGHT; }
+        if (k[SDL_SCANCODE_A] || k[SDL_SCANCODE_LEFT])  { p->stickX -= 64; p->button |= PAD_BUTTON_LEFT; }
+
+        if (k[SDL_SCANCODE_RETURN] || k[SDL_SCANCODE_SPACE] || k[SDL_SCANCODE_X]) p->button |= PAD_BUTTON_A;
+        if (k[SDL_SCANCODE_Z] || k[SDL_SCANCODE_B])                               p->button |= PAD_BUTTON_B;
+        if (k[SDL_SCANCODE_C])                                                    p->button |= PAD_BUTTON_X;
+        if (k[SDL_SCANCODE_V])                                                    p->button |= PAD_BUTTON_Y;
+        if (k[SDL_SCANCODE_RETURN] || k[SDL_SCANCODE_TAB])                        p->button |= PAD_BUTTON_START;
+        if (k[SDL_SCANCODE_U] || k[SDL_SCANCODE_E])                               p->button |= PAD_TRIGGER_Z;
+        if (k[SDL_SCANCODE_R] || k[SDL_SCANCODE_LSHIFT]) {
+            p->button |= PAD_TRIGGER_R;
+            p->triggerRight = 255;
+        }
+        if (k[SDL_SCANCODE_L] || k[SDL_SCANCODE_LCTRL]) {
+            p->button |= PAD_TRIGGER_L;
+            p->triggerLeft = 255;
+        }
+    }
+}
+
+u32 PADRead(PADStatus* status) {
+    if (!status) return 0;
+    Port_Watchdog_Beat();
+
+    if (s_playback_enabled > 0 && s_playback_file) {
+        /* Read next frame's inputs from recorded macro */
+        uint32_t f = 0, btn = 0, tl = 0, tr = 0;
+        int sx = 0, sy = 0, cx = 0, cy = 0;
+        char line[256];
+        bool found = false;
+        while (fgets(line, sizeof(line), s_playback_file)) {
+            if (line[0] == '#' || line[0] == '\n' || line[0] == '\r') continue;
+            if (sscanf(line, "%u %x %d %d %d %d %u %u", &f, &btn, &sx, &sy, &cx, &cy, &tl, &tr) >= 8) {
+                memset(&s_pad_state[0], 0, sizeof(PADStatus));
+                s_pad_state[0].button = (uint16_t)btn;
+                s_pad_state[0].stickX = (int8_t)sx;
+                s_pad_state[0].stickY = (int8_t)sy;
+                s_pad_state[0].substickX = (int8_t)cx;
+                s_pad_state[0].substickY = (int8_t)cy;
+                s_pad_state[0].triggerLeft = (uint8_t)tl;
+                s_pad_state[0].triggerRight = (uint8_t)tr;
+                found = true;
+                break;
+            }
+        }
+        if (!found) {
+            memset(&s_pad_state[0], 0, sizeof(PADStatus));
+        }
+
+        /* Check physical controller for Select+Start emergency escape during playback */
+        SDL_Event ev;
+        while (SDL_PollEvent(&ev)) {
+            if (ev.type == SDL_QUIT) {
+                Port_PAD_ResumeES();
+                exit(0);
+            }
+        }
+        for (int i = 0; i < PAD_CHAN_MAX; i++) {
+            if (s_controllers[i]) {
+                int sel = SDL_GameControllerGetButton(s_controllers[i], SDL_CONTROLLER_BUTTON_BACK) ||
+                          SDL_GameControllerGetButton(s_controllers[i], SDL_CONTROLLER_BUTTON_GUIDE);
+                int st  = SDL_GameControllerGetButton(s_controllers[i], SDL_CONTROLLER_BUTTON_START);
+                if (sel && st) {
+                    fprintf(stderr, "\n[Melee-Pad] Playback interrupted by GameController Select+Start exit combo.\n");
+                    Port_PAD_ResumeES();
+                    exit(0);
+                }
+            }
+        }
+        if (s_joystick) {
+            int nb = SDL_JoystickNumButtons(s_joystick);
+            int select_down = (nb > 8 && SDL_JoystickGetButton(s_joystick, 8)) ||
+                              (nb > 10 && SDL_JoystickGetButton(s_joystick, 10));
+            int start_down  = (nb > 9 && SDL_JoystickGetButton(s_joystick, 9));
+            if (select_down && start_down) {
+                fprintf(stderr, "\n[Melee-Pad] Playback interrupted by Joystick Select+Start exit combo.\n");
+                Port_PAD_ResumeES();
+                exit(0);
+            }
+        }
+    } else {
+        Port_PAD_PollEvents();
+        if (s_record_enabled > 0 && s_record_file) {
+            fprintf(s_record_file, "%u 0x%04X %d %d %d %d %u %u\n",
+                    s_pad_frame,
+                    s_pad_state[0].button,
+                    (int)s_pad_state[0].stickX,
+                    (int)s_pad_state[0].stickY,
+                    (int)s_pad_state[0].substickX,
+                    (int)s_pad_state[0].substickY,
+                    (unsigned)s_pad_state[0].triggerLeft,
+                    (unsigned)s_pad_state[0].triggerRight);
+            if ((s_pad_frame % 60) == 0) {
+                fflush(s_record_file);
+            }
+        }
+    }
+
+    const char* auto_start_env = getenv("MELEE_AUTO_START");
+    if (auto_start_env) {
+        int as_f = atoi(auto_start_env);
+        if (s_pad_frame >= as_f && s_pad_frame <= as_f + 15) {
+            s_pad_state[0].button |= PAD_BUTTON_START;
+            s_pad_state[0].err = PAD_ERR_NONE;
+        }
+    }
+
+    s_pad_frame++;
+
+    if (Port_Net_IsActive()) {
+        PADStatus local_in = s_pad_state[0];
+        PADStatus local_out, remote_out;
+        Port_Net_Step(&local_in, &local_out, &remote_out);
+
+        int loc = Port_Net_LocalPlayer();
+        int rem = Port_Net_RemotePlayer();
+
+        status[loc] = local_out;
+        status[loc].err = PAD_ERR_NONE;
+
+        status[rem] = remote_out;
+        status[rem].err = PAD_ERR_NONE;
+
+        for (int i = 0; i < PAD_CHAN_MAX; i++) {
+            if (i != loc && i != rem) {
+                status[i].err = PAD_ERR_NO_CONTROLLER;
+            }
+        }
+        return (PAD_CHAN0_BIT >> loc) | (PAD_CHAN0_BIT >> rem);
+    }
+
+    uint32_t mask = 0;
+    for (int i = 0; i < PAD_CHAN_MAX; i++) {
+        status[i] = s_pad_state[i];
+        if (status[i].err == PAD_ERR_NONE) {
+            mask |= (PAD_CHAN0_BIT >> i);
+        }
+    }
+    return mask ? mask : PAD_CHAN0_BIT;
+}
+
+BOOL PADRecalibrate(u32 mask) {
+    (void)mask;
+    return TRUE;
+}
