+        case GX_TEV_KCSEL_K1_G: *kr = *kg = *kb = state ? state->kcolors[1][1] : 255; break;
+        case GX_TEV_KCSEL_K2_G: *kr = *kg = *kb = state ? state->kcolors[2][1] : 255; break;
+        case GX_TEV_KCSEL_K3_G: *kr = *kg = *kb = state ? state->kcolors[3][1] : 255; break;
+        case GX_TEV_KCSEL_K0_B: *kr = *kg = *kb = state ? state->kcolors[0][2] : 255; break;
+        case GX_TEV_KCSEL_K1_B: *kr = *kg = *kb = state ? state->kcolors[1][2] : 255; break;
+        case GX_TEV_KCSEL_K2_B: *kr = *kg = *kb = state ? state->kcolors[2][2] : 255; break;
+        case GX_TEV_KCSEL_K3_B: *kr = *kg = *kb = state ? state->kcolors[3][2] : 255; break;
+        case GX_TEV_KCSEL_K0_A: *kr = *kg = *kb = state ? state->kcolors[0][3] : 255; break;
