+#ifndef PORT_NET_H
+#define PORT_NET_H
+
+#include <dolphin/types.h>
+#include <dolphin/pad.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MELEE_NET_PORT_DEFAULT 41000
+#define MELEE_NET_MAGIC        0x4D454C50 /* 'MELP' (Melee Pi) */
+#define MELEE_NET_VERSION      1
+
+/* Packet Message Types */
+typedef enum {
+    NET_MSG_BEACON = 0,     /* LAN broadcast discovery beacon */
+    NET_MSG_CONNECT = 1,    /* Client connection request */
+    NET_MSG_ACCEPT = 2,     /* Host connection acceptance (contains seed) */
+    NET_MSG_INPUT = 3,      /* Frame controller input payload */
+    NET_MSG_PING = 4,       /* Latency probe */
+    NET_MSG_PONG = 5,       /* Latency response */
+    NET_MSG_DISCONNECT = 6  /* Clean session termination */
+} MeleeNetMsgType;
+
+/* Wire Packet Structure (Packed, 48 Bytes) */
+typedef struct __attribute__((packed)) {
+    uint32_t magic;          /* MELEE_NET_MAGIC */
+    uint16_t version;        /* MELEE_NET_VERSION */
+    uint16_t msg_type;       /* MeleeNetMsgType */
+    uint32_t sender_id;      /* Random instance identifier */
+    uint32_t frame;          /* Execution frame sequence */
+    uint32_t ack_frame;      /* Highest remote frame confirmed */
+    PADStatus pad_curr;      /* Input for target frame (16 bytes) */
+    PADStatus pad_prev;      /* Redundant input for frame - 1 (16 bytes) */
+    uint32_t rand_seed;      /* RNG synchronization seed */
+    uint32_t checksum;       /* Basic packet integrity checksum */
+} MeleeNetPacket;
+
+/* Public API */
+bool     Port_Net_Init(void);
+bool     Port_Net_IsActive(void);
+bool     Port_Net_IsConnected(void);
+int      Port_Net_LocalPlayer(void);
+int      Port_Net_RemotePlayer(void);
+uint32_t Port_Net_Frame(void);
+void     Port_Net_Poll(void);
+bool     Port_Net_Step(const PADStatus* local_in, PADStatus* local_out, PADStatus* remote_out);
+void     Port_Net_Shutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PORT_NET_H */
