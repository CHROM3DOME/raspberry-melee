+void GXInitTexObj(GXTexObj* obj, const void* data, u16 width, u16 height,
+                  GXTexFmt format, GXTexWrapMode wrapS, GXTexWrapMode wrapT, GXBool mipmap) {
+    if (obj) {
+        obj->dummy[0] = (uint32_t)(uintptr_t)data;
+        obj->dummy[1] = ((uint32_t)width << 16) | height;
+        obj->dummy[2] = (uint32_t)format;
+        obj->dummy[3] = (uint32_t)mipmap;
+        obj->dummy[4] = ((uint32_t)wrapS << 16) | (wrapT & 0xFFFF);
+        obj->dummy[5] = 0;
+    }
+}
+
+void GXInitTexObjCI(GXTexObj* obj, const void* data, u16 width, u16 height,
+                    GXCITexFmt format, GXTexWrapMode wrapS, GXTexWrapMode wrapT, GXBool mipmap,
+                    u32 tlut) {
+    if (obj) {
+        obj->dummy[0] = (uint32_t)(uintptr_t)data;
+        obj->dummy[1] = ((uint32_t)width << 16) | height;
+        obj->dummy[2] = (uint32_t)format;
+        obj->dummy[3] = (uint32_t)mipmap;
+        obj->dummy[4] = ((uint32_t)wrapS << 16) | (wrapT & 0xFFFF);
+        obj->dummy[5] = tlut;
+    }
+}
+
+void GXInitTexObjWrapMode(GXTexObj* obj, GXTexWrapMode s, GXTexWrapMode t) {
