+    s_boot_time_ns = get_time_ns();
+
+#if !defined(_WIN32)
+    void* mapped = mmap((void*)0x80000000, GC_MEM_SIZE,
+                        PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED,
+                        -1, 0);
+    if (mapped != MAP_FAILED) {
+        s_arena_base = (uint8_t*)mapped;
+        OSBaseAddress = (uintptr_t)mapped;
+        fprintf(stderr, "[Melee-OS] Mapped GameCube physical memory at 0x80000000.\n");
+    } else {
+        s_arena_base = (uint8_t*)calloc(1, GC_MEM_SIZE);
+        OSBaseAddress = (uintptr_t)s_arena_base;
+        fprintf(stderr, "[Melee-OS] Allocated GameCube heap at %p (%d MB).\n", s_arena_base, GC_MEM_SIZE / (1024*1024));
+    }
+#else
+    s_arena_base = (uint8_t*)calloc(1, GC_MEM_SIZE);
+    OSBaseAddress = (uintptr_t)s_arena_base;
+    fprintf(stderr, "[Melee-OS] Allocated GameCube heap at %p (%d MB).\n", s_arena_base, GC_MEM_SIZE / (1024*1024));
+#endif
+
+    s_arena_lo = s_arena_base + 0x00340000;
+    s_arena_hi = s_arena_base + (GC_MEM_SIZE - 0x1000);
+
+    /* Hardware clock constants at GameCube low memory */
+    if (OSBaseAddress == 0x80000000) {
+        *(volatile uint32_t*)(0x800000F8) = OS_BUS_CLOCK;
+        *(volatile uint32_t*)(0x800000FC) = OS_CORE_CLOCK;
+    }
+}
+
+void* OSAllocFromArenaLo(uint32_t size, uint32_t align) {
+    uintptr_t addr = (uintptr_t)s_arena_lo;
+    if (align > 0) {
+        addr = (addr + align - 1) & ~(align - 1);
+    }
+    void* ptr = (void*)addr;
+    s_arena_lo = (uint8_t*)addr + size;
+    return ptr;
+}
+
+void* OSAllocFromArenaHi(uint32_t size, uint32_t align) {
+    uintptr_t addr = (uintptr_t)s_arena_hi - size;
+    if (align > 0) {
+        addr &= ~(align - 1);
+    }
+    s_arena_hi = (uint8_t*)addr;
+    return (void*)addr;
