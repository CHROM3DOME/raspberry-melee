+#!/bin/bash
+set -e
+
+BUILD_DIR="build-cross"
+SYSROOT="${SYSROOT:-/opt/rpi-sysroot}"
+
+echo "=================================================================="
+echo " Super Smash Bros. Melee - ARM Cross-Compilation for Pi Zero 2W"
+echo "=================================================================="
+
+mkdir -p "$BUILD_DIR"
+cd "$BUILD_DIR"
+
+cmake .. \
+    -DCMAKE_TOOLCHAIN_FILE=../cmake/armhf-toolchain.cmake \
+    -DCMAKE_SYSROOT="$SYSROOT" \
+    -DTARGET_PI_ARM=1
+
+cmake --build . -j"$(nproc)"
+
+echo "=================================================================="
+echo " Cross-Compilation Successful!"
+echo " Target Binary: $(pwd)/melee_pi"
+file melee_pi
+echo "=================================================================="
