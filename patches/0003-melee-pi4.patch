+        if (!s_joystick && i == 0) {
+            s_joystick = SDL_JoystickOpen(i);
+            if (s_joystick) {
+                fprintf(stderr, "[Melee-Pad] Connected direct Joystick %d: %s (%d buttons, %d axes)\n",
