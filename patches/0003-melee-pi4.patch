+            *kg = state ? state->kcolors[2][1] : 255;
+            *kb = state ? state->kcolors[2][2] : 255;
+            break;
+        case GX_TEV_KCSEL_K3:
+            *kr = state ? state->kcolors[3][0] : 255;
+            *kg = state ? state->kcolors[3][1] : 255;
+            *kb = state ? state->kcolors[3][2] : 255;
+            break;
+        case GX_TEV_KCSEL_K0_R: *kr = *kg = *kb = state ? state->kcolors[0][0] : 255; break;
+        case GX_TEV_KCSEL_K1_R: *kr = *kg = *kb = state ? state->kcolors[1][0] : 255; break;
