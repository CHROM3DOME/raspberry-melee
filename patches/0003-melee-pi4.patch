+static inline void sample_texture_bilinear(const uint32_t* pixels, int w, int h,
+                                           uint8_t wrap_s, uint8_t wrap_t,
+                                           float u, float v,
+                                           uint8_t* out_r, uint8_t* out_g, uint8_t* out_b, uint8_t* out_a) {
+    float u_w;
+    if (wrap_s == GX_CLAMP) {
+        u_w = (u < 0.0f) ? 0.0f : (u > 1.0f ? 1.0f : u);
+    } else if (wrap_s == GX_MIRROR) {
+        float m = u * 0.5f;
+        float mf = m - floorf(m);
+        u_w = (mf > 0.5f) ? (1.0f - (mf - 0.5f) * 2.0f) : (mf * 2.0f);
+    } else {
+        u_w = u - floorf(u);
+    }
+
+    float v_w;
+    if (wrap_t == GX_CLAMP) {
+        v_w = (v < 0.0f) ? 0.0f : (v > 1.0f ? 1.0f : v);
+    } else if (wrap_t == GX_MIRROR) {
+        float m = v * 0.5f;
+        float mf = m - floorf(m);
+        v_w = (mf > 0.5f) ? (1.0f - (mf - 0.5f) * 2.0f) : (mf * 2.0f);
+    } else {
+        v_w = v - floorf(v);
+    }
+
+    float fx = u_w * (float)w - 0.5f;
+    float fy = v_w * (float)h - 0.5f;
+    if (fx < 0.0f) fx = 0.0f;
+    if (fy < 0.0f) fy = 0.0f;
+    int x0 = (int)fx;
+    int y0 = (int)fy;
+    if (x0 >= w) x0 = w - 1;
+    if (y0 >= h) y0 = h - 1;
+
+    int x1 = (wrap_s == GX_REPEAT) ? ((x0 + 1) % w) : ((x0 + 1 < w) ? (x0 + 1) : x0);
+    int y1 = (wrap_t == GX_REPEAT) ? ((y0 + 1) % h) : ((y0 + 1 < h) ? (y0 + 1) : y0);
+
+    int frac_x = (int)((fx - (float)x0) * 256.0f);
+    int frac_y = (int)((fy - (float)y0) * 256.0f);
+    if (frac_x < 0) frac_x = 0; else if (frac_x > 256) frac_x = 256;
+    if (frac_y < 0) frac_y = 0; else if (frac_y > 256) frac_y = 256;
+
+    uint32_t c00 = pixels[y0 * w + x0];
+    uint32_t c10 = pixels[y0 * w + x1];
+    uint32_t c01 = pixels[y1 * w + x0];
+    uint32_t c11 = pixels[y1 * w + x1];
+
+    int inv_x = 256 - frac_x;
+    int inv_y = 256 - frac_y;
+
+    int r0 = (((c00 >> 16) & 0xFF) * inv_x + ((c10 >> 16) & 0xFF) * frac_x) >> 8;
+    int g0 = (((c00 >> 8) & 0xFF) * inv_x + ((c10 >> 8) & 0xFF) * frac_x) >> 8;
+    int b0 = ((c00 & 0xFF) * inv_x + (c10 & 0xFF) * frac_x) >> 8;
+    int a0 = (((c00 >> 24) & 0xFF) * inv_x + ((c10 >> 24) & 0xFF) * frac_x) >> 8;
+
+    int r1 = (((c01 >> 16) & 0xFF) * inv_x + ((c11 >> 16) & 0xFF) * frac_x) >> 8;
+    int g1 = (((c01 >> 8) & 0xFF) * inv_x + ((c11 >> 8) & 0xFF) * frac_x) >> 8;
+    int b1 = ((c01 & 0xFF) * inv_x + (c11 & 0xFF) * frac_x) >> 8;
+    int a1 = (((c01 >> 24) & 0xFF) * inv_x + ((c11 >> 24) & 0xFF) * frac_x) >> 8;
+
+    *out_r = (uint8_t)((r0 * inv_y + r1 * frac_y) >> 8);
+    *out_g = (uint8_t)((g0 * inv_y + g1 * frac_y) >> 8);
+    *out_b = (uint8_t)((b0 * inv_y + b1 * frac_y) >> 8);
+    *out_a = (uint8_t)((a0 * inv_y + a1 * frac_y) >> 8);
+}
+
+static void soft_rasterize_triangle(const SoftVert* p0_in, const SoftVert* p1_in, const SoftVert* p2_in, const RenderDrawState* state) {
+    SoftVert p0 = *p0_in;
+    SoftVert p1 = *p1_in;
+    SoftVert p2 = *p2_in;
+
+    int min_x = (int)floorf(fminf(fminf(p0.x, p1.x), p2.x));
+    int max_x = (int)ceilf(fmaxf(fmaxf(p0.x, p1.x), p2.x));
+    int min_y = (int)floorf(fminf(fminf(p0.y, p1.y), p2.y));
+    int max_y = (int)ceilf(fmaxf(fmaxf(p0.y, p1.y), p2.y));
+
+    float det = (p1.y - p2.y) * (p0.x - p2.x) + (p2.x - p1.x) * (p0.y - p2.y);
+
+    if (p0_in->w <= 0.05f || p1_in->w <= 0.05f || p2_in->w <= 0.05f) return;
+    if (isnan(p0.x) || isnan(p0.y) || isnan(p1.x) || isnan(p1.y) || isnan(p2.x) || isnan(p2.y)) return;
+    if (isinf(p0.x) || isinf(p0.y) || isinf(p1.x) || isinf(p1.y) || isinf(p2.x) || isinf(p2.y)) return;
+    if (fabsf(p0.x) > 3000.0f || fabsf(p0.y) > 3000.0f ||
+        fabsf(p1.x) > 3000.0f || fabsf(p1.y) > 3000.0f ||
+        fabsf(p2.x) > 3000.0f || fabsf(p2.y) > 3000.0f) return;
+
+    if (min_x < 0) min_x = 0;
+    if (max_x > 319) max_x = 319;
+    if (min_y < 0) min_y = 0;
+    if (max_y > 239) max_y = 239;
+    if (min_x > max_x || min_y > max_y) return;
+
+    if (fabsf(det) < 0.0001f) return;
+
+    if (det < 0.0f) {
+        SoftVert tmp = p1; p1 = p2; p2 = tmp;
+        det = -det;
+    }
+    float inv_det = 1.0f / det;
+
+    const uint32_t* stage_tex_pixels[MAX_TEV_STAGES] = {0};
+    int stage_tex_w[MAX_TEV_STAGES] = {0};
+    int stage_tex_h[MAX_TEV_STAGES] = {0};
+    uint8_t stage_tex_wraps[MAX_TEV_STAGES] = {0};
+    uint8_t stage_tex_wrapt[MAX_TEV_STAGES] = {0};
+
+    int num_stages = (state && state->tev_active) ? state->num_tev_stages : 1;
+    if (num_stages <= 0) num_stages = 1;
+    if (num_stages > MAX_TEV_STAGES) num_stages = MAX_TEV_STAGES;
+
+    for (int st = 0; st < num_stages; st++) {
+        uint8_t map_id = (state && state->tev_active) ? state->tev_tex_map[st] : 0;
+        uint32_t tid = (map_id < 8 && state) ? state->tex_maps[map_id] : 0;
+        if (tid == 0 && map_id == 0 && state && state->texture_id > 0) {
+            tid = state->texture_id;
+        }
+        if (state && state->num_tex_gens > 0 && tid > 0 && tid <= (GLuint)s_num_cached_tex) {
+            int tidx = tid - 1;
+            stage_tex_pixels[st] = s_tex_cache[tidx].rgba;
+            stage_tex_w[st] = s_tex_cache[tidx].width;
+            stage_tex_h[st] = s_tex_cache[tidx].height;
+            stage_tex_wraps[st] = s_tex_cache[tidx].wrap_s;
+            stage_tex_wrapt[st] = s_tex_cache[tidx].wrap_t;
+        }
+    }
+
+    #pragma omp parallel for schedule(static)
+    for (int py = min_y; py <= max_y; py++) {
+        float pyf = py + 0.5f;
+        for (int px = min_x; px <= max_x; px++) {
+            float pxf = px + 0.5f;
+            float w0 = ((p1.y - p2.y) * (pxf - p2.x) + (p2.x - p1.x) * (pyf - p2.y)) * inv_det;
+            float w1 = ((p2.y - p0.y) * (pxf - p2.x) + (p0.x - p2.x) * (pyf - p2.y)) * inv_det;
+            float w2 = 1.0f - w0 - w1;
+
+            if (w0 >= -0.0001f && w1 >= -0.0001f && w2 >= -0.0001f) {
+                float depth = w0 * p0.z + w1 * p1.z + w2 * p2.z;
+                if (!state || !state->depth_test || depth <= s_soft_depth[py][px] + 0.005f) {
+                    if (state && !state->color_update) {
+                        if (state->depth_update) {
+                            s_soft_depth[py][px] = depth;
+                        }
+                        continue;
+                    }
+
+                    float inv_w = w0 * p0.inv_w + w1 * p1.inv_w + w2 * p2.inv_w;
+                    float w_persp = (fabsf(inv_w) > 1e-7f) ? (1.0f / inv_w) : 1.0f;
+                    float u = (w0 * p0.u_over_w + w1 * p1.u_over_w + w2 * p2.u_over_w) * w_persp;
+                    float v = (w0 * p0.v_over_w + w1 * p1.v_over_w + w2 * p2.v_over_w) * w_persp;
+
+                    int vr = (int)(w0 * p0.r + w1 * p1.r + w2 * p2.r);
+                    int vg = (int)(w0 * p0.g + w1 * p1.g + w2 * p2.g);
+                    int vb = (int)(w0 * p0.b + w1 * p1.b + w2 * p2.b);
+                    int va = (int)(w0 * p0.a + w1 * p1.a + w2 * p2.a);
+
+                    uint8_t out_r, out_g, out_b, out_a;
+
+                    if (state && state->tev_active) {
+                        uint8_t regs[4][4];
+                        memcpy(regs, state->tev_regs, sizeof(regs));
+                        regs[GX_TEVPREV][0] = (uint8_t)vr;
+                        regs[GX_TEVPREV][1] = (uint8_t)vg;
+                        regs[GX_TEVPREV][2] = (uint8_t)vb;
+                        regs[GX_TEVPREV][3] = (uint8_t)va;
+
+                        int stages = state->num_tev_stages;
+                        if (stages <= 0) stages = 1;
+                        if (stages > MAX_TEV_STAGES) stages = MAX_TEV_STAGES;
+
+                        for (int st = 0; st < stages; st++) {
+                            uint8_t tr = 255, tg = 255, tb = 255, ta = 255;
+                            const uint32_t* cur_tex_pixels = stage_tex_pixels[st];
+                            int cur_tex_w = stage_tex_w[st];
+                            int cur_tex_h = stage_tex_h[st];
+                            if (cur_tex_pixels && cur_tex_w > 0 && cur_tex_h > 0) {
+                                sample_texture_bilinear(cur_tex_pixels, cur_tex_w, cur_tex_h,
+                                                        stage_tex_wraps[st], stage_tex_wrapt[st],
+                                                        u, v, &tr, &tg, &tb, &ta);
+                            }
+
+                            uint8_t cur_tr = tr, cur_tg = tg, cur_tb = tb, cur_ta = ta;
+                            if (state->tev_tex_swap[st] != 0) {
+                                apply_tev_swap(state->tev_tex_swap[st], tr, tg, tb, ta, &cur_tr, &cur_tg, &cur_tb, &cur_ta);
+                            }
+                            uint8_t cur_vr = (uint8_t)vr, cur_vg = (uint8_t)vg, cur_vb = (uint8_t)vb, cur_va = (uint8_t)va;
+                            if (state->tev_ras_swap[st] != 0) {
+                                apply_tev_swap(state->tev_ras_swap[st], cur_vr, cur_vg, cur_vb, cur_va, &cur_vr, &cur_vg, &cur_vb, &cur_va);
+                            }
+
+                            uint8_t a_r, a_g, a_b;
+                            uint8_t b_r, b_g, b_b;
+                            uint8_t c_r, c_g, c_b;
+                            uint8_t d_r, d_g, d_b;
+
+                            evaluate_tev_color_arg(state->tev_c_in[st][0], cur_vr, cur_vg, cur_vb, cur_va, cur_tr, cur_tg, cur_tb, cur_ta, regs, state, st, &a_r, &a_g, &a_b);
+                            evaluate_tev_color_arg(state->tev_c_in[st][1], cur_vr, cur_vg, cur_vb, cur_va, cur_tr, cur_tg, cur_tb, cur_ta, regs, state, st, &b_r, &b_g, &b_b);
+                            evaluate_tev_color_arg(state->tev_c_in[st][2], cur_vr, cur_vg, cur_vb, cur_va, cur_tr, cur_tg, cur_tb, cur_ta, regs, state, st, &c_r, &c_g, &c_b);
+                            evaluate_tev_color_arg(state->tev_c_in[st][3], cur_vr, cur_vg, cur_vb, cur_va, cur_tr, cur_tg, cur_tb, cur_ta, regs, state, st, &d_r, &d_g, &d_b);
+
+                            uint8_t a_a = evaluate_tev_alpha_arg(state->tev_a_in[st][0], cur_va, cur_ta, regs, state, st);
+                            uint8_t b_a = evaluate_tev_alpha_arg(state->tev_a_in[st][1], cur_va, cur_ta, regs, state, st);
+                            uint8_t c_a = evaluate_tev_alpha_arg(state->tev_a_in[st][2], cur_va, cur_ta, regs, state, st);
+                            uint8_t d_a = evaluate_tev_alpha_arg(state->tev_a_in[st][3], cur_va, cur_ta, regs, state, st);
+
+                            int op_c = state->tev_c_op[st];
+                            int op_a = state->tev_a_op[st];
+
+                            int lerp_r = ((255 - c_r) * a_r + c_r * b_r) / 255;
+                            int lerp_g = ((255 - c_g) * a_g + c_g * b_g) / 255;
+                            int lerp_b = ((255 - c_b) * a_b + c_b * b_b) / 255;
+                            int lerp_a = ((255 - c_a) * a_a + c_a * b_a) / 255;
+
+                            int res_r = (op_c == GX_TEV_SUB) ? (d_r - lerp_r) : (d_r + lerp_r);
+                            int res_g = (op_c == GX_TEV_SUB) ? (d_g - lerp_g) : (d_g + lerp_g);
+                            int res_b = (op_c == GX_TEV_SUB) ? (d_b - lerp_b) : (d_b + lerp_b);
+                            int res_a = (op_a == GX_TEV_SUB) ? (d_a - lerp_a) : (d_a + lerp_a);
+
+                            if (state->tev_c_bias[st] == GX_TB_ADDHALF) { res_r += 128; res_g += 128; res_b += 128; }
+                            else if (state->tev_c_bias[st] == GX_TB_SUBHALF) { res_r -= 128; res_g -= 128; res_b -= 128; }
+
+                            if (state->tev_a_bias[st] == GX_TB_ADDHALF) { res_a += 128; }
+                            else if (state->tev_a_bias[st] == GX_TB_SUBHALF) { res_a -= 128; }
+
+                            if (state->tev_c_scale[st] == GX_CS_SCALE_2) { res_r <<= 1; res_g <<= 1; res_b <<= 1; }
+                            else if (state->tev_c_scale[st] == GX_CS_SCALE_4) { res_r <<= 2; res_g <<= 2; res_b <<= 2; }
+                            else if (state->tev_c_scale[st] == GX_CS_DIVIDE_2) { res_r >>= 1; res_g >>= 1; res_b >>= 1; }
+
+                            if (state->tev_a_scale[st] == GX_CS_SCALE_2) { res_a <<= 1; }
+                            else if (state->tev_a_scale[st] == GX_CS_SCALE_4) { res_a <<= 2; }
+                            else if (state->tev_a_scale[st] == GX_CS_DIVIDE_2) { res_a >>= 1; }
+
+                            if (state->tev_c_clamp[st]) {
+                                if (res_r < 0) res_r = 0; else if (res_r > 255) res_r = 255;
+                                if (res_g < 0) res_g = 0; else if (res_g > 255) res_g = 255;
+                                if (res_b < 0) res_b = 0; else if (res_b > 255) res_b = 255;
+                            }
+                            if (state->tev_a_clamp[st]) {
+                                if (res_a < 0) res_a = 0; else if (res_a > 255) res_a = 255;
+                            }
+
+                            uint8_t c_dst = state->tev_c_out[st];
+                            if (c_dst > 3) c_dst = 0;
+                            regs[c_dst][0] = (uint8_t)(res_r < 0 ? 0 : (res_r > 255 ? 255 : res_r));
+                            regs[c_dst][1] = (uint8_t)(res_g < 0 ? 0 : (res_g > 255 ? 255 : res_g));
+                            regs[c_dst][2] = (uint8_t)(res_b < 0 ? 0 : (res_b > 255 ? 255 : res_b));
+
+                            uint8_t a_dst = state->tev_a_out[st];
+                            if (a_dst > 3) a_dst = 0;
+                            regs[a_dst][3] = (uint8_t)(res_a < 0 ? 0 : (res_a > 255 ? 255 : res_a));
+                        }
+                        out_r = regs[GX_TEVPREV][0];
+                        out_g = regs[GX_TEVPREV][1];
+                        out_b = regs[GX_TEVPREV][2];
+                        out_a = regs[GX_TEVPREV][3];
+                    } else {
+                        uint8_t tr = 255, tg = 255, tb = 255, ta = 255;
+                        const uint32_t* cur_tex_pixels = stage_tex_pixels[0];
+                        int cur_tex_w = stage_tex_w[0];
+                        int cur_tex_h = stage_tex_h[0];
+                        if (cur_tex_pixels && cur_tex_w > 0 && cur_tex_h > 0) {
+                            sample_texture_bilinear(cur_tex_pixels, cur_tex_w, cur_tex_h,
+                                                    stage_tex_wraps[0], stage_tex_wrapt[0],
+                                                    u, v, &tr, &tg, &tb, &ta);
+                        }
+                        out_r = (tr * vr) / 255;
+                        out_g = (tg * vg) / 255;
+                        out_b = (tb * vb) / 255;
+                        out_a = (ta * va) / 255;
+                    }
+
+                    if (out_a == 0 && state && state->blend_enable) continue;
+
+                    /* Alpha test compare */
+                    if (state && state->alpha_comp != GX_ALWAYS) {
+                        if (state->alpha_comp == GX_GREATER && out_a <= state->alpha_ref) continue;
+                        if (state->alpha_comp == GX_GEQUAL  && out_a <  state->alpha_ref) continue;
+                        if (state->alpha_comp == GX_NEQUAL  && out_a == state->alpha_ref) continue;
+                        if (state->alpha_comp == GX_EQUAL   && out_a != state->alpha_ref) continue;
+                        if (state->alpha_comp == GX_LESS    && out_a >= state->alpha_ref) continue;
+                        if (state->alpha_comp == GX_LEQUAL  && out_a >  state->alpha_ref) continue;
+                        if (state->alpha_comp == GX_NEVER) continue;
+                    }
+
+                    s_soft_pixels_count++;
+                    if (!state || !state->blend_enable) {
+                        if (!state || state->depth_update) {
+                            s_soft_depth[py][px] = depth;
+                        }
+                        s_soft_fb[py][px] = (0xFF << 24) | (out_r << 16) | (out_g << 8) | out_b;
+                    } else {
+                        if (state && state->depth_update) {
+                            s_soft_depth[py][px] = depth;
+                        }
+                        uint32_t prev = s_soft_fb[py][px];
+                        uint8_t pr = (prev >> 16) & 0xFF;
+                        uint8_t pg = (prev >> 8) & 0xFF;
+                        uint8_t pb = prev & 0xFF;
+
+                        int src_factor = state->blend_src;
+                        int dst_factor = state->blend_dst;
+
+                        int sr, sg, sb;
+                        if (src_factor == GX_BL_ZERO) {
+                            sr = sg = sb = 0;
+                        } else if (src_factor == GX_BL_ONE) {
+                            sr = out_r; sg = out_g; sb = out_b;
+                        } else { /* GX_BL_SRCALPHA */
+                            sr = (out_r * out_a) / 255;
+                            sg = (out_g * out_a) / 255;
+                            sb = (out_b * out_a) / 255;
+                        }
+
+                        int dr, dg, db;
+                        if (dst_factor == GX_BL_ZERO) {
+                            dr = dg = db = 0;
+                        } else if (dst_factor == GX_BL_ONE) {
+                            dr = pr; dg = pg; db = pb;
+                        } else if (dst_factor == GX_BL_SRCALPHA) {
+                            dr = (pr * out_a) / 255;
+                            dg = (pg * out_a) / 255;
+                            db = (pb * out_a) / 255;
+                        } else { /* GX_BL_INVSRCALPHA */
+                            dr = (pr * (255 - out_a)) / 255;
+                            dg = (pg * (255 - out_a)) / 255;
+                            db = (pb * (255 - out_a)) / 255;
+                        }
+
+                        int fr = sr + dr; if (fr > 255) fr = 255;
+                        int fg = sg + dg; if (fg > 255) fg = 255;
+                        int fb = sb + db; if (fb > 255) fb = 255;
+
+                        s_soft_fb[py][px] = (0xFF << 24) | (fr << 16) | (fg << 8) | fb;
+                    }
+                }
+            }
+        }
+    }
+}
