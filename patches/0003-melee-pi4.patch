+
+    const char* env_play = getenv("MELEE_PLAYBACK_INPUT");
+    if (!env_play) env_play = getenv("PORT_PLAYBACK_INPUT");
+    if (env_play && env_play[0] != '\0' && strcmp(env_play, "0") != 0) {
+        if (strcmp(env_play, "1") == 0) {
+            const char* in_file = getenv("PLAYBACK_INPUT_FILE");
+            snprintf(s_playback_path, sizeof(s_playback_path), "%s", in_file ? in_file : "inputs_recorded.txt");
+        } else {
