+
+        double dt_loop_ms = 0.0;
+        float cur_swap_ms = 0.0f;
+
+        int frame_num = -1;
+        for (int i = buf->packet_count - 1; i >= 0; i--) {
+            if (buf->packets[i].type == PKT_SWAP) {
