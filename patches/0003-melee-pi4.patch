+                    fprintf(stderr, "[Melee-RenderThread] Core 1 idle waiting for Core 0 (buf %d, idle %ds)\n",
+                            s_read_idx, c1_idle_sec);
+                    fflush(stderr);
+                }
+            }
+        }
+        if (!s_render_running) {
+            pthread_mutex_unlock(&s_mutex);
+            break;
+        }
+        pthread_mutex_unlock(&s_mutex);
+
+        FrameCmdBuffer* buf = &s_buffers[s_read_idx];
+
+        struct timespec t_render_0, t_render_1;
+        clock_gettime(CLOCK_MONOTONIC, &t_render_0);
+
+        if (s_use_vbo < 0) {
+            const char* env_vbo = getenv("MELEE_USE_VBO");
