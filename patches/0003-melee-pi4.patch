+}
+
+void VIFlush(void) {}
+
+void VIWaitForRetrace(void) {
+    s_retrace_count++;
+    s_current_fb = s_next_fb;
+
+    if (s_pre_retrace_cb) {
+        s_pre_retrace_cb(s_retrace_count);
+    }
+    if (s_post_retrace_cb) {
+        s_post_retrace_cb(s_retrace_count);
+    }
+
+    /* Process pending periodic GameCube alarms (e.g. pad sampling) */
+    pc_os_run_alarms();
+
+    /* 60Hz adaptive frame pacing:
+     * When decoupled dual-core rendering is enabled, Core 1 handles display pacing via SDL_GL_SwapWindow (VSync).
+     * Sleeping on Core 0 causes coarse Linux timer scheduler oversleeps (3-5 ms) that drop framerate below 60 FPS. */
+    if (!Port_RenderThread_IsEnabled()) {
+        static uint64_t s_last_retrace_ns = 0;
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        uint64_t now_ns = (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+
+        if (s_last_retrace_ns != 0) {
+            uint64_t elapsed_ns = now_ns - s_last_retrace_ns;
+            const uint64_t target_ns = 16666667ULL; /* 60.0 Hz */
+            if (elapsed_ns < target_ns) {
+                uint64_t sleep_ns = target_ns - elapsed_ns;
+                if (sleep_ns > 500000ULL) {
+                    usleep((useconds_t)(sleep_ns / 1000ULL));
+                } else {
+                    sched_yield();
+                }
+            }
+        }
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        s_last_retrace_ns = (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+    }
+}
+
