+    (void)coord; (void)line_enable; (void)point_enable;
+}
diff --git a/src/port/port_main.c b/src/port/port_main.c
new file mode 100755
index 0000000..561f3ba
--- /dev/null
+++ b/src/port/port_main.c
@@ -0,0 +1,111 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <signal.h>
+#include <fcntl.h>
+#include <SDL2/SDL.h>
+
+#include "port/port_pad.h"
+#include "port/port_gx.h"
+#include "port/port_os.h"
+#include "port/port_dvd.h"
+#include "port/port_audio.h"
+#include "port/port_discfont.h"
+#include "port/port_watchdog.h"
+
+extern int melee_main(void);
+
+int main(int argc, char** argv) {
+    fprintf(stderr, "================================================================\n");
+#if defined(TARGET_PI4)
+    fprintf(stderr, " Super Smash Bros. Melee - Raspberry Pi 4 Port\n");
+    fprintf(stderr, " BCM2711 Cortex-A72 / VideoCore VI Mesa KMSDRM GLES 2.0\n");
+    fprintf(stderr, " Version: %s (Pi 4 480p Release)\n", pc_app_version());
+#elif defined(TARGET_PI_TIN)
+    fprintf(stderr, " Super Smash Bros. Melee - Pi Tin Handheld Port\n");
+    fprintf(stderr, " BCM2710A1 Cortex-A53 / VideoCore IV GLES 2.0 (SPI LCD DispmanX 10010)\n");
+    fprintf(stderr, " Version: %s (Pi Tin Release)\n", pc_app_version());
+#else
+    fprintf(stderr, " Super Smash Bros. Melee - Raspberry Pi Zero 2W Port\n");
+    fprintf(stderr, " BCM2710A1 Cortex-A53 / VideoCore IV GLES 2.0 (HDMI / DispmanX 10000)\n");
+    fprintf(stderr, " Version: %s (Stock Zero 2W Release)\n", pc_app_version());
+#endif
+    fprintf(stderr, "================================================================\n");
+
+    /* Pillar 2: Freeze EmulationStation immediately upon launch */
+    Port_PAD_FreezeES();
+
+    /* Pillar 3: Multi-Core OpenMP worker thread pinning (Cores 2 & 3) */
+    setenv("GOMP_CPU_AFFINITY", "2 3", 0);
+    setenv("OMP_NUM_THREADS", "2", 0);
+    setenv("OMP_PROC_BIND", "true", 0);
+
+    /* Default environment configuration */
+#if defined(TARGET_PI4)
+    if (!getenv("SDL_VIDEODRIVER")) {
+        if (!getenv("DISPLAY") && !getenv("WAYLAND_DISPLAY")) {
+            setenv("SDL_VIDEODRIVER", "kmsdrm", 0);
+        }
+    }
+#elif defined(TARGET_PI_TIN)
+    int vcfd = open("/dev/vchiq", O_RDWR);
+    if (vcfd >= 0) {
+        close(vcfd);
+        setenv("SDL_VIDEODRIVER", "rpi", 0);
+        setenv("SDL_RPI_VIDEO_LAYER", "10010", 0);
+    } else {
+        setenv("SDL_VIDEODRIVER", "dummy", 0);
+    }
+#else
+    int vcfd = open("/dev/vchiq", O_RDWR);
+    if (vcfd >= 0) {
+        close(vcfd);
+        setenv("SDL_VIDEODRIVER", "rpi", 0);
+        setenv("SDL_RPI_VIDEO_LAYER", "10000", 0);
+    } else {
+        setenv("SDL_VIDEODRIVER", "dummy", 0);
+    }
+#endif
+    setenv("SDL_AUDIODRIVER", "alsa", 0);
+
+    const char* iso_path = NULL;
+    const char* files_path = NULL;
+
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--iso") == 0 && i + 1 < argc) {
+            iso_path = argv[++i];
+        } else if (strcmp(argv[i], "--files") == 0 && i + 1 < argc) {
+            files_path = argv[++i];
+        } else if (strcmp(argv[i], "--scene") == 0 && i + 1 < argc) {
+            setenv("MELEE_BOOT_SCENE", argv[++i], 1);
+        } else if (strstr(argv[i], ".iso") || strstr(argv[i], ".ISO") || strstr(argv[i], ".gcm")) {
+            iso_path = argv[i];
+        }
+    }
+
+    if (iso_path) {
+        Port_DVD_SetISOPath(iso_path);
+    }
+    if (files_path) {
+        Port_DVD_SetSearchPath(files_path);
+    }
+
+    /* Initialize runtime fonts from retail DOL */
+    Port_DiscFont_Init(NULL);
+
+    /* Launch Melee native engine with 30s inactivity watchdog */
+    Port_Watchdog_Init(30, 0);
+    fprintf(stderr, "[Melee-Main] Launching Melee game simulation on Core 0...\n");
+    int rc = melee_main();
+
+    /* Clean exit */
+    Port_Watchdog_Shutdown();
+    Port_GX_Shutdown();
+    Port_Audio_Shutdown();
+    Port_PAD_ResumeES();
+
+    fprintf(stderr, "[Melee-Main] Super Smash Bros. Melee exited cleanly with code %d.\n", rc);
+    return rc;
+}
