+            fprintf(stderr, "[Melee-RenderThread] Vertex streaming mode: %s\n", s_use_vbo ? "Unified Streaming VBO" : "Direct Client Arrays (Zero-Copy)");
+        }
+
+        if (s_debug_gl < 0) {
+            const char* env_dbg = getenv("MELEE_DEBUG_GL");
+            s_debug_gl = env_dbg ? atoi(env_dbg) : 0;
+            if (s_debug_gl) {
+                fprintf(stderr, "[Melee-RenderThread] GL error checking enabled in render thread.\n");
+            }
+        }
+
+        static int s_vbo_mode = -1;
+        if (s_vbo_mode < 0) {
+            const char* env_vm = getenv("MELEE_VBO_MODE");
+            s_vbo_mode = env_vm ? atoi(env_vm) : 0;
+            fprintf(stderr, "[Melee-RenderThread] VBO streaming mode: %d\n", s_vbo_mode);
+        }
+
+        struct timespec tv0, tv1;
+        clock_gettime(CLOCK_MONOTONIC, &tv0);
