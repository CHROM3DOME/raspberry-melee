+    (void)nverts;
+    s_current_prim = prim;
+    s_current_vtx_fmt = vtxfmt;
+    s_imm_tex_attr = GX_VA_TEX0;
+    s_vert_count = 0;
+    s_in_begin = true;
+    memset(&s_current_vtx, 0, sizeof(s_current_vtx));
+    port_gx_get_default_vtx_color(s_current_vtx.col);
+}
