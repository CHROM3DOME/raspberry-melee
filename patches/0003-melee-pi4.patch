+        case GX_TEV_KCSEL_1_8: *kr = *kg = *kb = 32;  break;
+        case GX_TEV_KCSEL_K0:
+            *kr = state ? state->kcolors[0][0] : 255;
+            *kg = state ? state->kcolors[0][1] : 255;
+            *kb = state ? state->kcolors[0][2] : 255;
+            break;
+        case GX_TEV_KCSEL_K1:
+            *kr = state ? state->kcolors[1][0] : 255;
