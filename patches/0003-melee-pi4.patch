+void GXSetProjection(const void* mtx_ptr, GXProjectionType type) {
+    (void)type;
+    const float (*mtx)[4] = (const float (*)[4])mtx_ptr;
+    /* Pre-transpose 4x4 row-major GameCube projection matrix into column-major */
+    for (int r = 0; r < 4; r++) {
+        for (int c = 0; c < 4; c++) {
+            s_proj[c * 4 + r] = mtx[r][c];
+        }
+    }
+    /* Remap GameCube clip depth [-w, 0] to OpenGL clip depth [-w, +w]:
+     * In GameCube GX, near plane is -w, far plane is 0.
+     * In OpenGL, near plane is -w, far plane is +w.
+     * To map [-w, 0] -> [-w, +w]:
+     *   z_gl = 2.0 * z_gc + w
+     * Since s_proj is column-major:
+     *   row 2 is at index (c * 4 + 2)
+     *   row 3 is at index (c * 4 + 3)
+     */
+    for (int c = 0; c < 4; c++) {
+        s_proj[c * 4 + 2] = 2.0f * s_proj[c * 4 + 2] + s_proj[c * 4 + 3];
+    }
+    update_mvp();
+}
