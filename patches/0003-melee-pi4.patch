+void PADControlMotor(u32 chan, u32 cmd) {
+    (void)chan;
+    (void)cmd;
+}
+
+BOOL PADReset(u32 mask) {
+    (void)mask;
+    return TRUE;
+}
+
+void PADClamp(PADStatus* status) {
+    if (!status) return;
+    for (int i = 0; i < PAD_CHAN_MAX; i++) {
+        if (status[i].stickX > 80) status[i].stickX = 80;
+        if (status[i].stickX < -80) status[i].stickX = -80;
+        if (status[i].stickY > 80) status[i].stickY = 80;
+        if (status[i].stickY < -80) status[i].stickY = -80;
+    }
+}
