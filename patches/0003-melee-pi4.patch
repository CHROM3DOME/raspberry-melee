+  r0 = vsetq_lane_f32(vgetq_lane_f32(r0, 3) + a[0][3], r0, 3);
+  r1 = vsetq_lane_f32(vgetq_lane_f32(r1, 3) + a[1][3], r1, 3);
+  r2 = vsetq_lane_f32(vgetq_lane_f32(r2, 3) + a[2][3], r2, 3);
