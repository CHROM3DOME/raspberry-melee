+static void soft_rasterize_batch(const GXVertex* verts, int count, GXPrimitive prim, const RenderDrawState* state) {
+    (void)state;
+    static int s_batch_call_count = 0;
+    if (s_batch_call_count < 10) {
+        fprintf(stderr, "[Melee-GX] soft_rasterize_batch (#%d): count=%d, prim=%d\n",
+                ++s_batch_call_count, count, prim);
+        fflush(stderr);
+    }
+    if (s_frame_num == 2) {
+        fprintf(stderr, "[Batch F2] prim=%d cnt=%d tex0=%u tex1=%u tmap0=%u tmap1=%u cu=%d du=%d dt=%d bl=%d ac=%d ar=%d v0=(%.1f,%.1f,%.1f) c=(%d,%d,%d,%d) tev=%d stg=%d C0=(%d,%d,%d,%d) Cout=%d Aout=%d Kc=%d Ka=%d Cin=(%d,%d,%d,%d) Ain=(%d,%d,%d,%d)\n",
+                prim, count,
+                state ? state->tex_maps[0] : 0,
+                state ? state->tex_maps[1] : 0,
+                state ? state->tev_tex_map[0] : 0,
+                state ? state->tev_tex_map[1] : 0,
+                state ? state->color_update : -1,
+                state ? state->depth_update : -1,
+                state ? state->depth_test : -1,
+                state ? state->blend_enable : -1,
+                state ? state->alpha_comp : -1,
+                state ? state->alpha_ref : -1,
+                verts[0].pos[0], verts[0].pos[1], verts[0].pos[2],
+                verts[0].col[0], verts[0].col[1], verts[0].col[2], verts[0].col[3],
+                state ? state->tev_active : 0,
+                state ? state->num_tev_stages : 0,
+                state ? state->tev_regs[GX_TEVREG0][0] : 0,
+                state ? state->tev_regs[GX_TEVREG0][1] : 0,
+                state ? state->tev_regs[GX_TEVREG0][2] : 0,
+                state ? state->tev_regs[GX_TEVREG0][3] : 0,
+                state ? state->tev_c_out[0] : 0,
+                state ? state->tev_a_out[0] : 0,
+                state ? state->tev_kcsel[0] : 0,
+                state ? state->tev_kasel[0] : 0,
+                state ? state->tev_c_in[0][0] : 0,
+                state ? state->tev_c_in[0][1] : 0,
+                state ? state->tev_c_in[0][2] : 0,
+                state ? state->tev_c_in[0][3] : 0,
+                state ? state->tev_a_in[0][0] : 0,
+                state ? state->tev_a_in[0][1] : 0,
+                state ? state->tev_a_in[0][2] : 0,
+                state ? state->tev_a_in[0][3] : 0);
+        fflush(stderr);
+    }
+    if (count < 3) return;
+    int n = count;
+    if (n > MAX_IMMEDIATE_VERTS) n = MAX_IMMEDIATE_VERTS;
+    s_soft_batches_count++;
+    s_soft_tris_count += (prim == GX_QUADS) ? (n / 4 * 2) : (n / 3);
+    const float* m = s_proj;
+
+    for (int i = 0; i < n; i++) {
+        const GXVertex* v = &verts[i];
+        float x = v->pos[0], y = v->pos[1], z = v->pos[2];
+        float X = x * m[0] + y * m[4] + z * m[8]  + m[12];
+        float Y = x * m[1] + y * m[5] + z * m[9]  + m[13];
+        float Z = x * m[2] + y * m[6] + z * m[10] + m[14];
+        float W = x * m[3] + y * m[7] + z * m[11] + m[15];
+
+        s_transformed_verts[i].w = W;
+        float safe_w = (fabsf(W) > 0.0001f) ? W : 0.0001f;
+        float invW = 1.0f / safe_w;
+        s_transformed_verts[i].inv_w = invW;
+        float vp_x = s_viewport_x * (320.0f / 640.0f);
+        float vp_y = s_viewport_y * (240.0f / 480.0f);
+        float vp_w = (s_viewport_w > 0.0f) ? s_viewport_w * (320.0f / 640.0f) : 320.0f;
+        float vp_h = (s_viewport_h > 0.0f) ? s_viewport_h * (240.0f / 480.0f) : 240.0f;
+        s_transformed_verts[i].x = vp_x + (X * invW * 0.5f + 0.5f) * vp_w;
+        s_transformed_verts[i].y = vp_y + (1.0f - (Y * invW * 0.5f + 0.5f)) * vp_h;
+        s_transformed_verts[i].z = Z * invW;
+        s_transformed_verts[i].r = v->col[0];
+        s_transformed_verts[i].g = v->col[1];
+        s_transformed_verts[i].b = v->col[2];
+        s_transformed_verts[i].a = v->col[3];
+        s_transformed_verts[i].u = v->tex[0];
+        s_transformed_verts[i].v = v->tex[1];
+        s_transformed_verts[i].u_over_w = v->tex[0] * invW;
+        s_transformed_verts[i].v_over_w = v->tex[1] * invW;
+    }
+
+    if (prim == GX_TRIANGLES) {
+        for (int i = 0; i + 2 < n; i += 3) {
+            soft_rasterize_triangle(&s_transformed_verts[i], &s_transformed_verts[i + 1], &s_transformed_verts[i + 2], state);
+        }
+    } else if (prim == GX_TRIANGLESTRIP) {
+        for (int i = 0; i + 2 < n; i++) {
+            if (i & 1) {
+                soft_rasterize_triangle(&s_transformed_verts[i + 1], &s_transformed_verts[i], &s_transformed_verts[i + 2], state);
+            } else {
+                soft_rasterize_triangle(&s_transformed_verts[i], &s_transformed_verts[i + 1], &s_transformed_verts[i + 2], state);
+            }
+        }
+    } else if (prim == GX_TRIANGLEFAN) {
+        for (int i = 1; i + 1 < n; i++) {
+            soft_rasterize_triangle(&s_transformed_verts[0], &s_transformed_verts[i], &s_transformed_verts[i + 1], state);
+        }
+    } else if (prim == GX_QUADS) {
+        for (int i = 0; i + 3 < n; i += 4) {
+            soft_rasterize_triangle(&s_transformed_verts[i], &s_transformed_verts[i + 1], &s_transformed_verts[i + 2], state);
+            soft_rasterize_triangle(&s_transformed_verts[i], &s_transformed_verts[i + 2], &s_transformed_verts[i + 3], state);
+        }
+    }
+}
