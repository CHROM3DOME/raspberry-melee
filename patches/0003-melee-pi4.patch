diff --git a/scripts/adhoc_setup.sh b/scripts/adhoc_setup.sh
new file mode 100755
index 0000000..da2b109
--- /dev/null
+++ b/scripts/adhoc_setup.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+# ==============================================================================
+# Melee Pi Ad-Hoc / Direct Wireless Setup Helper
+# Creates a direct peer-to-peer Wi-Fi hotspot between two Raspberry Pis
+# ==============================================================================
+
+MODE="${1:-status}"
+
+case "$MODE" in
+    host)
+        echo "[Melee-AdHoc] Starting Ad-Hoc Access Point on Pi (Host: 192.168.50.1)..."
+        sudo nmcli dev wifi hotspot ifname wlan0 ssid "MeleePi-AdHoc" password "supersmash" ip4 192.168.50.1/24 2>/dev/null || \
+        sudo create_ap wlan0 eth0 "MeleePi-AdHoc" "supersmash" 2>/dev/null || \
+        echo "Note: If NetworkManager is not installed, standard hostapd / dnsmasq can be used."
+        echo "192.168.50.1" > peer_ip.txt
+        echo "Ad-Hoc Host active."
+        ;;
+    join)
+        echo "[Melee-AdHoc] Connecting to MeleePi-AdHoc hotspot..."
+        sudo nmcli dev wifi connect "MeleePi-AdHoc" password "supersmash" 2>/dev/null || \
+        sudo wpa_passphrase "MeleePi-AdHoc" "supersmash" >> /etc/wpa_supplicant/wpa_supplicant.conf
+        echo "192.168.50.1" > peer_ip.txt
+        echo "Connected to Host at 192.168.50.1."
+        ;;
+    stop)
+        echo "[Melee-AdHoc] Stopping hotspot and restoring standard Wi-Fi..."
+        sudo nmcli con down "Hotspot" 2>/dev/null || true
+        ;;
+    *)
+        echo "Usage: $0 [host|join|stop]"
+        echo "  host : Starts a local Wi-Fi hotspot (SSID: MeleePi-AdHoc) on 192.168.50.1"
+        echo "  join : Connects to the local MeleePi-AdHoc hotspot"
+        echo "  stop : Restores normal Wi-Fi connection"
+        ;;
+esac
