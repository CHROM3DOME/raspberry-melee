+    s_stat_path[sizeof(s_stat_path) - 1] = '\0';
+    char* dot = strrchr(s_stat_path, '.');
+    if (dot) {
+        strcpy(dot, ".stat");
+    } else {
+        strncat(s_stat_path, ".stat", sizeof(s_stat_path) - strlen(s_stat_path) - 1);
+    }
+}
+
+static void save_memcard_to_disk(void);
+
+static void load_memcard_from_disk(void) {
+    resolve_memcard_path();
+    s_file_exists = false;
+    s_file_size = 0;
+    memset(s_memcard_data, 0, sizeof(s_memcard_data));
+    memset(&s_card_stat, 0, sizeof(s_card_stat));
+
+    FILE* f = fopen(s_memcard_path, "rb");
+    if (f) {
+        fseek(f, 0, SEEK_END);
+        long sz = ftell(f);
+        fseek(f, 0, SEEK_SET);
+
+        if (sz >= 0x10000) { /* Minimum valid save size (64KB) */
+            size_t to_read = (sz > (long)sizeof(s_memcard_data)) ? sizeof(s_memcard_data) : (size_t)sz;
+            size_t n = fread(s_memcard_data, 1, to_read, f);
+            if (n >= 0x10000) {
+                bool non_zero = false;
+                for (size_t i = 0; i < 4096; i++) {
+                    if (s_memcard_data[i] != 0) {
+                        non_zero = true;
+                        break;
+                    }
+                }
+                if (non_zero) {
+                    s_file_exists = true;
+                    s_file_size = (uint32_t)n;
+                    fprintf(stderr, "[Melee-Card] Loaded virtual memory card from '%s' (%u bytes).\n",
+                            s_memcard_path, (unsigned)s_file_size);
+                }
+            }
+        }
+        fclose(f);
+    }
+
+    if (s_file_exists) {
+        FILE* sf = fopen(s_stat_path, "rb");
+        bool valid_stat = false;
+        if (sf) {
+            size_t n = fread(&s_card_stat, 1, sizeof(CARDStat), sf);
+            fclose(sf);
+            if (n >= sizeof(CARDStat) && s_card_stat.iconAddr == 0x40) {
+                valid_stat = true;
+                fprintf(stderr, "[Melee-Card] Loaded card stat metadata from '%s'.\n", s_stat_path);
+            }
+        }
+        if (!valid_stat) {
+            /* Canonical Dolphin baselib metadata defaults */
+            fprintf(stderr, "[Melee-Card] Initializing default card stat metadata (iconAddr=0x40).\n");
+            memset(&s_card_stat, 0, sizeof(CARDStat));
+            strncpy(s_card_stat.fileName, s_filename, CARD_FILENAME_MAX - 1);
+            memcpy(s_card_stat.gameName, "GALE", 4);
+            memcpy(s_card_stat.company, "01", 2);
+            s_card_stat.length = s_file_size;
+            s_card_stat.bannerFormat = 2; /* CardBanner_Large */
+            s_card_stat.iconAddr = 0x40;  /* Crucial: Dolphin baselib requires iconAddr == 0x40 */
+            s_card_stat.iconFormat = 1;
+            s_card_stat.iconSpeed = 1;
+            save_memcard_to_disk();
+        }
+    } else {
+        fprintf(stderr, "[Melee-Card] Memory Card Slot A is empty / unformatted ('%s').\n", s_memcard_path);
+    }
+}
+
+static void save_memcard_to_disk(void) {
+    if (s_memcard_path[0] == '\0') return;
+    FILE* f = fopen(s_memcard_path, "wb");
+    if (f) {
+        uint32_t write_sz = s_file_size > 0 ? s_file_size : 0x16000;
+        fwrite(s_memcard_data, 1, write_sz, f);
+        fflush(f);
+        fclose(f);
+        fprintf(stderr, "[Melee-Card] Flushed %u bytes to memory card image '%s'.\n",
+                (unsigned)write_sz, s_memcard_path);
+    } else {
+        fprintf(stderr, "[Melee-Card] ERROR: Could not write memory card file '%s'!\n", s_memcard_path);
+    }
+
+    if (s_stat_path[0] != '\0') {
+        FILE* sf = fopen(s_stat_path, "wb");
+        if (sf) {
+            fwrite(&s_card_stat, 1, sizeof(CARDStat), sf);
+            fflush(sf);
+            fclose(sf);
+        }
+    }
+}
+
+void CARDInit(const char* game, const char* maker) {
+    (void)game;
+    (void)maker;
+    s_card_mounted = true;
+    load_memcard_from_disk();
+    fprintf(stderr, "[Melee-Card] Virtual Memory Card initialized (Slot A, file_exists=%d).\n", s_file_exists);
+}
+
+s32 CARDMount(s32 chan, void* workArea, CARDCallback detachCallback) {
+    (void)workArea;
+    (void)detachCallback;
+    return (chan == 0) ? CARD_RESULT_READY : CARD_RESULT_NOCARD;
+}
+
+s32 CARDMountAsync(s32 chan, void* workArea, CARDCallback detachCb, CARDCallback cb) {
+    (void)workArea;
+    (void)detachCb;
+    s32 res = (chan == 0) ? CARD_RESULT_READY : CARD_RESULT_NOCARD;
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDUnmount(s32 chan) {
+    (void)chan;
+    return CARD_RESULT_READY;
+}
+
+s32 CARDOpen(s32 chan, const char* fileName, CARDFileInfo* fileInfo) {
+    (void)chan;
+    (void)fileName;
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    if (!s_file_exists) {
+        return CARD_RESULT_NOFILE;
+    }
+    if (fileInfo) {
+        fileInfo->chan = chan;
+        fileInfo->fileNo = 0;
+        fileInfo->offset = 0;
+        fileInfo->length = s_file_size;
+        fileInfo->iBlock = 0;
+        return CARD_RESULT_READY;
+    }
+    return CARD_RESULT_FATAL_ERROR;
+}
+
+s32 CARDFastOpen(s32 chan, s32 fileNo, CARDFileInfo* fileInfo) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    if (!s_file_exists || fileNo != 0) {
+        return CARD_RESULT_NOFILE;
+    }
+    if (fileInfo) {
+        fileInfo->chan = chan;
+        fileInfo->fileNo = fileNo;
+        fileInfo->offset = 0;
+        fileInfo->length = s_file_size;
+        fileInfo->iBlock = 0;
+        return CARD_RESULT_READY;
+    }
+    return CARD_RESULT_FATAL_ERROR;
+}
+
+s32 CARDCreate(s32 chan, const char* fileName, u32 size, CARDFileInfo* fileInfo) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    s_file_exists = true;
+    s_file_size = (size > 0 && size <= sizeof(s_memcard_data)) ? size : 0x16000;
+    if (fileName && fileName[0] != '\0') {
+        strncpy(s_filename, fileName, sizeof(s_filename) - 1);
+        s_filename[sizeof(s_filename) - 1] = '\0';
+    }
+    if (fileInfo) {
+        fileInfo->chan = chan;
+        fileInfo->fileNo = 0;
+        fileInfo->offset = 0;
+        fileInfo->length = s_file_size;
+        fileInfo->iBlock = 0;
+    }
+    memset(&s_card_stat, 0, sizeof(CARDStat));
+    strncpy(s_card_stat.fileName, s_filename, CARD_FILENAME_MAX - 1);
+    memcpy(s_card_stat.gameName, "GALE", 4);
+    memcpy(s_card_stat.company, "01", 2);
+    s_card_stat.length = s_file_size;
+    s_card_stat.bannerFormat = 2; /* CardBanner_Large */
+    s_card_stat.iconAddr = 0x40;  /* Crucial: Dolphin baselib requires iconAddr == 0x40 */
+    s_card_stat.iconFormat = 1;
+    s_card_stat.iconSpeed = 1;
+
+    fprintf(stderr, "[Melee-Card] Created save file '%s' (size=%u bytes) in Slot A.\n",
+            s_filename, (unsigned)s_file_size);
+    save_memcard_to_disk();
+    return CARD_RESULT_READY;
+}
+
+s32 CARDCreateAsync(s32 chan, const char* fileName, u32 size, CARDFileInfo* fileInfo, CARDCallback cb) {
+    s32 res = CARDCreate(chan, fileName, size, fileInfo);
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDRead(const CARDFileInfo* fileInfo, void* addr, s32 length, s32 offset) {
+    (void)fileInfo;
+    if (addr && offset >= 0 && offset + length <= (s32)sizeof(s_memcard_data)) {
+        memcpy(addr, s_memcard_data + offset, length);
+        return CARD_RESULT_READY;
+    }
+    return CARD_RESULT_IOERROR;
+}
+
+s32 CARDReadAsync(const CARDFileInfo* fileInfo, void* addr, s32 length, s32 offset, CARDCallback cb) {
+    s32 res = CARDRead(fileInfo, addr, length, offset);
+    if (cb) cb(fileInfo ? fileInfo->chan : 0, res);
+    return res;
+}
+
+s32 CARDWrite(const CARDFileInfo* fileInfo, const void* addr, s32 length, s32 offset) {
+    (void)fileInfo;
+    if (addr && offset >= 0 && offset + length <= (s32)sizeof(s_memcard_data)) {
+        memcpy(s_memcard_data + offset, addr, length);
+        if ((uint32_t)(offset + length) > s_file_size) {
+            s_file_size = (uint32_t)(offset + length);
+            s_card_stat.length = s_file_size;
+        }
+        save_memcard_to_disk();
+        return CARD_RESULT_READY;
+    }
+    return CARD_RESULT_IOERROR;
+}
+
+s32 CARDWriteAsync(const CARDFileInfo* fileInfo, const void* addr, s32 length, s32 offset, CARDCallback cb) {
+    s32 res = CARDWrite(fileInfo, addr, length, offset);
+    if (cb) cb(fileInfo ? fileInfo->chan : 0, res);
+    return res;
+}
+
+s32 CARDClose(CARDFileInfo* fileInfo) {
+    (void)fileInfo;
+    return CARD_RESULT_READY;
+}
+
+s32 CARDCancel(CARDFileInfo* fileInfo) {
+    (void)fileInfo;
+    return CARD_RESULT_READY;
+}
+
+s32 CARDGetStatus(s32 chan, s32 fileNo, CARDStat* stat) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    if (!s_file_exists || fileNo != 0) {
+        return CARD_RESULT_NOFILE;
+    }
+    if (stat) {
+        memcpy(stat, &s_card_stat, sizeof(CARDStat));
+        return CARD_RESULT_READY;
+    }
+    return CARD_RESULT_FATAL_ERROR;
+}
+
+s32 CARDSetStatus(s32 chan, s32 fileNo, const CARDStat* stat) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    if (fileNo != 0) {
+        return CARD_RESULT_NOFILE;
+    }
+    if (stat) {
+        memcpy(&s_card_stat, stat, sizeof(CARDStat));
+        save_memcard_to_disk();
+    }
+    return CARD_RESULT_READY;
+}
+
+s32 CARDSetStatusAsync(s32 chan, s32 fileNo, const CARDStat* stat, CARDCallback cb) {
+    s32 res = CARDSetStatus(chan, fileNo, stat);
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDFreeBlocks(s32 chan, s32* byteNotUsed, s32* filesNotUsed) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    if (byteNotUsed) {
+        *byteNotUsed = s_file_exists ? (s32)(sizeof(s_memcard_data) - s_file_size) : (s32)sizeof(s_memcard_data);
+    }
+    if (filesNotUsed) {
+        *filesNotUsed = s_file_exists ? 63 : 64;
+    }
+    return CARD_RESULT_READY;
+}
+
+int CARDProbe(s32 chan) {
+    return (chan == 0) ? CARD_RESULT_READY : CARD_RESULT_NOCARD;
+}
+
+s32 CARDProbeEx(s32 chan, s32* memSize, s32* sectSize) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    if (memSize) *memSize = 16; /* 16 Mbits = 2MB */
+    if (sectSize) *sectSize = 8192;
+    return CARD_RESULT_READY;
+}
+
+s32 CARDCheckAsync(s32 chan, CARDCallback cb) {
+    s32 res = (chan == 0) ? CARD_RESULT_READY : CARD_RESULT_NOCARD;
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDCheck(s32 chan) {
+    return (chan == 0) ? CARD_RESULT_READY : CARD_RESULT_NOCARD;
+}
+
+s32 CARDCheckEx(s32 chan, s32* xferBytes) {
+    if (xferBytes) *xferBytes = 0;
+    return (chan == 0) ? CARD_RESULT_READY : CARD_RESULT_NOCARD;
+}
+
+s32 CARDDelete(s32 chan, const char* fileName) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    (void)fileName;
+    s_file_exists = false;
+    s_file_size = 0;
+    if (s_memcard_path[0] != '\0') {
+        remove(s_memcard_path);
+    }
+    if (s_stat_path[0] != '\0') {
+        remove(s_stat_path);
+    }
+    memset(s_memcard_data, 0, sizeof(s_memcard_data));
+    memset(&s_card_stat, 0, sizeof(s_card_stat));
+    fprintf(stderr, "[Melee-Card] Deleted save file from Slot A.\n");
+    return CARD_RESULT_READY;
+}
+
+s32 CARDDeleteAsync(s32 chan, const char* fileName, CARDCallback cb) {
+    s32 res = CARDDelete(chan, fileName);
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDFastDelete(s32 chan, s32 fileNo) {
+    (void)fileNo;
+    return CARDDelete(chan, NULL);
+}
+
+s32 CARDFastDeleteAsync(s32 chan, s32 fileNo, CARDCallback cb) {
+    s32 res = CARDFastDelete(chan, fileNo);
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDFormat(s32 chan) {
+    return CARDDelete(chan, NULL);
+}
+
+s32 CARDFormatAsync(s32 chan, CARDCallback cb) {
+    s32 res = CARDFormat(chan);
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDRename(s32 chan, const char* oldName, const char* newName) {
+    if (chan != 0) {
+        return CARD_RESULT_NOCARD;
+    }
+    (void)oldName;
+    if (newName && newName[0] != '\0') {
+        strncpy(s_filename, newName, sizeof(s_filename) - 1);
+        s_filename[sizeof(s_filename) - 1] = '\0';
+        strncpy(s_card_stat.fileName, s_filename, CARD_FILENAME_MAX - 1);
+        save_memcard_to_disk();
+    }
+    return CARD_RESULT_READY;
+}
+
+s32 CARDRenameAsync(s32 chan, const char* oldName, const char* newName, CARDCallback cb) {
+    s32 res = CARDRename(chan, oldName, newName);
+    if (cb) cb(chan, res);
+    return res;
+}
+
+s32 CARDGetXferredBytes(s32 chan) {
+    (void)chan;
+    return 0;
+}
diff --git a/src/port/port_discfont.c b/src/port/port_discfont.c
new file mode 100755
index 0000000..d871704
--- /dev/null
+++ b/src/port/port_discfont.c
@@ -0,0 +1,138 @@
+#include "port/port_discfont.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "sysdolphin/baselib/sislib_font.h"
+
+/* Font storage defined in sysdolphin baselib */
+extern uint8_t HSD_DebugFontAtlas[7168];
+
+static inline uint32_t be32(const uint8_t* p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+static intptr_t find_bytes(const uint8_t* hay, size_t hay_len, const uint8_t* needle, size_t needle_len) {
+    for (size_t i = 0; i + needle_len <= hay_len; i++) {
+        if (memcmp(hay + i, needle, needle_len) == 0) {
+            return (intptr_t)i;
+        }
+    }
+    return -1;
+}
+
+static intptr_t find_debug_font(const uint8_t* dol, size_t len) {
+    static const uint32_t marks[4] = {0x10808000, 0x46808000, 0x7C808000, 0xB3808000};
+    for (size_t i = 0; i + 0x20 + sizeof(HSD_DebugFontAtlas) <= len; i += 4) {
+        if (be32(dol + i) == marks[0] &&
+            be32(dol + i + 8) == marks[1] &&
+            be32(dol + i + 16) == marks[2] &&
+            be32(dol + i + 24) == marks[3])
+        {
+            return (intptr_t)(i + 0x20);
+        }
+    }
+    return -1;
+}
+
+bool Port_DiscFont_Init(const char* dol_path) {
+    const char* cand_paths[] = {
+        (dol_path && dol_path[0]) ? dol_path : "",
+        "orig/GALE01/sys/main.dol",
+        "../melee/orig/GALE01/sys/main.dol",
+                "sys/main.dol",
+        NULL
+    };
+
+    FILE* f = NULL;
+    for (int i = 0; cand_paths[i] != NULL; i++) {
+        if (!cand_paths[i] || !cand_paths[i][0]) continue;
+        f = fopen(cand_paths[i], "rb");
+        if (f) {
+            fprintf(stderr, "[Melee-DiscFont] Reading font atlases from '%s'\n", cand_paths[i]);
+            break;
+        }
+    }
+
+    uint8_t* dol_data = NULL;
+    size_t sz = 0;
+
+    if (!f) {
+        const char* cand_isos[] = {
+            "game.iso",
+            "Super Smash Bros. Melee (USA) (En,Ja) (Rev 2).iso",
+            "melee.iso",
+            NULL
+        };
+        for (int i = 0; cand_isos[i]; i++) {
+            FILE* isof = fopen(cand_isos[i], "rb");
+            if (isof) {
+                uint8_t hdr[0x440];
+                if (fread(hdr, 1, sizeof(hdr), isof) == sizeof(hdr)) {
+                    uint32_t dol_off = be32(hdr + 0x420);
+                    uint32_t fst_off = be32(hdr + 0x424);
+                    if (dol_off > 0 && fst_off > dol_off && (fst_off - dol_off) < 16 * 1024 * 1024) {
+                        sz = (size_t)(fst_off - dol_off);
+                        dol_data = (uint8_t*)malloc(sz);
+                        if (dol_data) {
+                            fseek(isof, dol_off, SEEK_SET);
+                            if (fread(dol_data, 1, sz, isof) == sz) {
+                                fprintf(stderr, "[Melee-DiscFont] Reading font atlases directly from ISO '%s' (main.dol: %zu bytes)\n", cand_isos[i], sz);
+                                fclose(isof);
+                                goto extract_fonts;
+                            }
+                            free(dol_data);
+                            dol_data = NULL;
+                        }
+                    }
+                }
+                fclose(isof);
+            }
+        }
+        fprintf(stderr, "[Melee-DiscFont] Warning: main.dol and ISO not found for font extraction.\n");
+        return false;
+    }
+
+    fseek(f, 0, SEEK_END);
+    sz = (size_t)ftell(f);
+    fseek(f, 0, SEEK_SET);
+
+    dol_data = (uint8_t*)malloc(sz);
+    if (!dol_data) {
+        fclose(f);
+        return false;
+    }
+
+    if (fread(dol_data, 1, sz, f) != sz) {
+        free(dol_data);
+        fclose(f);
+        return false;
+    }
+    fclose(f);
+
+extract_fonts:
+    /* 1. Extract HSD Debug Font Atlas */
+    intptr_t dbg_off = find_debug_font(dol_data, sz);
+    if (dbg_off >= 0) {
+        memcpy(HSD_DebugFontAtlas, dol_data + dbg_off, sizeof(HSD_DebugFontAtlas));
+        fprintf(stderr, "[Melee-DiscFont] Extracted HSD_DebugFontAtlas (7,168 bytes) at offset 0x%lx.\n", (unsigned long)dbg_off);
+    } else {
+        fprintf(stderr, "[Melee-DiscFont] Warning: Debug font table signature not found in DOL.\n");
+    }
+
+    /* 2. Extract SisLib Font Atlas (menu/title font) */
+    static const uint8_t kern_sig[] = {0x09, 0x08, 0x09, 0x0C, 0x09, 0x08, 0x08, 0x08};
+    intptr_t kern_off = find_bytes(dol_data, sz, kern_sig, sizeof(kern_sig));
+    if (kern_off >= 0) {
+        intptr_t sis_off = kern_off + 0x240; /* GALE01 kerning table length is 0x240 */
+        if (sis_off + sizeof(HSD_SisLib_FontAtlas) <= (size_t)sz) {
+            memcpy(HSD_SisLib_FontAtlas, dol_data + sis_off, sizeof(HSD_SisLib_FontAtlas));
+            fprintf(stderr, "[Melee-DiscFont] Extracted HSD_SisLib_FontAtlas (%zu bytes) at offset 0x%lx.\n",
+                    sizeof(HSD_SisLib_FontAtlas), (unsigned long)sis_off);
+        }
+    }
+
+    free(dol_data);
+    return true;
+}
diff --git a/src/port/port_dvd.c b/src/port/port_dvd.c
new file mode 100755
index 0000000..86a67c7
--- /dev/null
+++ b/src/port/port_dvd.c
@@ -0,0 +1,467 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <errno.h>
+
+#include "port/port_dvd.h"
+#include "port/port_os.h"
+#include "port/port_watchdog.h"
+#include "port/port_render_thread.h"
+
+#define MAX_ISO_ENTRIES 8192
+
+typedef struct {
+    char     path[128];
+    uint64_t offset;
+    uint32_t size;
+} IsoEntry;
+
+static IsoEntry s_iso_entries[MAX_ISO_ENTRIES];
+static int      s_num_iso_entries = 0;
+static int      s_iso_fd = -1;
+static char     s_search_path[512] = "";
+static char     s_iso_path[512] = "";
+
+static const char* const k_default_search_paths[] = {
+    "files",
+    "orig/GALE01/files",
+    "../melee/orig/GALE01/files",
+    "assets/files",
+    NULL
+};
+
+void Port_DVD_SetSearchPath(const char* path) {
+    if (path && path[0]) {
+        strncpy(s_search_path, path, sizeof(s_search_path) - 1);
+    }
+}
+
+void Port_DVD_SetISOPath(const char* path) {
+    if (path && path[0]) {
+        strncpy(s_iso_path, path, sizeof(s_iso_path) - 1);
+    }
+}
+
+static inline uint32_t read_be32(const uint8_t* p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static void parse_iso_fst(int fd) {
+    uint8_t header[0x440];
+    if (pread64(fd, header, sizeof(header), 0) != sizeof(header)) {
+        fprintf(stderr, "[Melee-DVD] ERROR: Failed to read ISO header.\n");
+        return;
+    }
+
+    uint32_t fst_offset = read_be32(header + 0x424);
+    uint32_t fst_size   = read_be32(header + 0x428);
+
+    if (fst_offset == 0 || fst_size == 0 || fst_size > 8 * 1024 * 1024) {
+        fprintf(stderr, "[Melee-DVD] ERROR: Invalid FST table in ISO (offset=0x%X size=%u)\n", fst_offset, fst_size);
+        return;
+    }
+
+    uint8_t* fst_data = (uint8_t*)malloc(fst_size);
+    if (!fst_data) {
+        fprintf(stderr, "[Melee-DVD] ERROR: Failed to allocate %u bytes for FST buffer\n", fst_size);
+        return;
+    }
+
+    if (pread64(fd, fst_data, fst_size, (off64_t)fst_offset) != (ssize_t)fst_size) {
+        fprintf(stderr, "[Melee-DVD] ERROR: Failed to read FST table from offset 0x%X\n", fst_offset);
+        free(fst_data);
+        return;
+    }
+
+    uint32_t total_entries = read_be32(fst_data + 8);
+    if (total_entries == 0 || total_entries > 32768) {
+        fprintf(stderr, "[Melee-DVD] ERROR: Implausible total FST entries: %u\n", total_entries);
+        free(fst_data);
+        return;
+    }
+
+    const char* string_table = (const char*)(fst_data + (total_entries * 12));
+    size_t string_table_size = (fst_size > total_entries * 12) ? (fst_size - (total_entries * 12)) : 0;
+
+    struct DirStack {
+        uint32_t next_idx;
+        char path[256];
+    } stack[32];
+    int stack_top = 0;
+    stack[0].next_idx = total_entries;
+    stack[0].path[0] = '\0';
+
+    s_num_iso_entries = 0;
+
+    for (uint32_t i = 1; i < total_entries; i++) {
+        const uint8_t* entry = fst_data + (i * 12);
+        uint8_t is_dir = entry[0];
+        uint32_t name_offset = ((uint32_t)entry[1] << 16) | ((uint32_t)entry[2] << 8) | (uint32_t)entry[3];
+        uint64_t file_offset = (uint64_t)read_be32(entry + 4);
+        uint32_t file_size   = read_be32(entry + 8);
+
+        while (stack_top > 0 && i >= stack[stack_top].next_idx) {
+            stack_top--;
+        }
+
+        const char* name = "";
+        if (name_offset < string_table_size) {
+            name = string_table + name_offset;
+        }
+
+        char full_path[256];
+        if (stack[stack_top].path[0]) {
+            snprintf(full_path, sizeof(full_path), "%s/%s", stack[stack_top].path, name);
+        } else {
+            snprintf(full_path, sizeof(full_path), "%s", name);
+        }
+
+        if (is_dir) {
+            if (stack_top + 1 < 32) {
+                stack_top++;
+                stack[stack_top].next_idx = file_size;
+                strncpy(stack[stack_top].path, full_path, sizeof(stack[stack_top].path) - 1);
+                stack[stack_top].path[sizeof(stack[stack_top].path) - 1] = '\0';
+            }
+        } else {
+            if (s_num_iso_entries < MAX_ISO_ENTRIES) {
+                IsoEntry* e = &s_iso_entries[s_num_iso_entries++];
+                strncpy(e->path, full_path, sizeof(e->path) - 1);
+                e->path[sizeof(e->path) - 1] = '\0';
+                e->offset = file_offset;
+                e->size = file_size;
+            }
+        }
+    }
+
+    free(fst_data);
+    fprintf(stderr, "[Melee-DVD] Successfully indexed %d files from GameCube ISO FST.\n", s_num_iso_entries);
+}
+
+static void scan_loose_files_rec(const char* base_dir, const char* sub_dir) {
+    char full_path[512];
+    if (sub_dir && sub_dir[0]) {
+        snprintf(full_path, sizeof(full_path), "%s/%s", base_dir, sub_dir);
+    } else {
+        snprintf(full_path, sizeof(full_path), "%s", base_dir);
+    }
+
+    DIR* dir = opendir(full_path);
+    if (!dir) return;
+
+    struct dirent* ent;
+    while ((ent = readdir(dir)) != NULL) {
+        if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
+
+        char rel_name[128];
+        if (sub_dir && sub_dir[0]) {
+            snprintf(rel_name, sizeof(rel_name), "%s/%s", sub_dir, ent->d_name);
+        } else {
+            snprintf(rel_name, sizeof(rel_name), "%s", ent->d_name);
+        }
+
+        if (ent->d_type == DT_DIR) {
+            scan_loose_files_rec(base_dir, rel_name);
+        } else if (ent->d_type == DT_REG || ent->d_type == DT_UNKNOWN || ent->d_type == DT_LNK) {
+            if (s_num_iso_entries < MAX_ISO_ENTRIES) {
+                IsoEntry* e = &s_iso_entries[s_num_iso_entries++];
+                strncpy(e->path, rel_name, sizeof(e->path) - 1);
+                e->path[sizeof(e->path) - 1] = '\0';
+                e->offset = 0;
+                char test_path[512];
+                snprintf(test_path, sizeof(test_path), "%s/%s", base_dir, rel_name);
+                struct stat st;
+                if (stat(test_path, &st) == 0) {
+                    e->size = (uint32_t)st.st_size;
+                } else {
+                    e->size = 0;
+                }
+            }
+        }
+    }
+    closedir(dir);
+}
+
+static void init_iso_reader(void) {
+    if (s_iso_fd >= 0) return;
+
+    const char* cand_isos[] = {
+        s_iso_path,
+        "game.iso",
+        "Super Smash Bros. Melee (USA) (En,Ja) (Rev 2).iso",
+        "melee.iso",
+        NULL
+    };
+
+    for (int idx = 0; cand_isos[idx] != NULL; idx++) {
+        if (!cand_isos[idx][0]) continue;
+        int fd = open(cand_isos[idx], O_RDONLY | O_LARGEFILE);
+        if (fd >= 0) {
+            s_iso_fd = fd;
+            fprintf(stderr, "[Melee-DVD] Opened GameCube Melee ISO: '%s'\n", cand_isos[idx]);
+            parse_iso_fst(s_iso_fd);
+            break;
+        }
+    }
+
+    if (s_num_iso_entries == 0) {
+        if (s_search_path[0]) {
+            DIR* d = opendir(s_search_path);
+            if (d) {
+                closedir(d);
+                scan_loose_files_rec(s_search_path, "");
+                fprintf(stderr, "[Melee-DVD] Indexed %d loose files from '%s'.\n", s_num_iso_entries, s_search_path);
+            }
+        }
+        if (s_num_iso_entries == 0) {
+            for (int i = 0; k_default_search_paths[i] != NULL; i++) {
+                DIR* d = opendir(k_default_search_paths[i]);
+                if (d) {
+                    closedir(d);
+                    strncpy(s_search_path, k_default_search_paths[i], sizeof(s_search_path) - 1);
+                    scan_loose_files_rec(k_default_search_paths[i], "");
+                    fprintf(stderr, "[Melee-DVD] Indexed %d loose files from '%s'.\n", s_num_iso_entries, k_default_search_paths[i]);
+                    break;
+                }
+            }
+        }
+    }
+}
+
+void DVDInit(void) {
+    init_iso_reader();
+    fprintf(stderr, "[Melee-DVD] GameCube DVD subsystem initialized (%d files ready).\n", s_num_iso_entries);
+}
+
+static int32_t Port_DVD_ReadEntry(int32_t entrynum, void* addr, int32_t length, int32_t offset) {
+    if (entrynum < 0 || entrynum >= s_num_iso_entries || !addr || length < 0 || offset < 0) {
+        return -1;
+    }
+    Port_Watchdog_Beat();
+    IsoEntry* e = &s_iso_entries[entrynum];
+    if (offset >= (int32_t)e->size) {
+        return 0;
+    }
+    if (offset + length > (int32_t)e->size) {
+        length = (int32_t)e->size - offset;
+    }
+
+    if (s_iso_fd >= 0) {
+        ssize_t n = pread64(s_iso_fd, addr, (size_t)length, (off64_t)(e->offset + (uint64_t)offset));
+        if (n < 0) {
+            fprintf(stderr, "[Melee-DVD] ERROR: ISO pread64 failed on '%s' (off=%llu len=%d): %s\n",
+                    e->path, (unsigned long long)(e->offset + (uint64_t)offset), length, strerror(errno));
+            return -1;
+        }
+        return (int32_t)n;
+    } else {
+        char full_path[512];
+        if (s_search_path[0]) {
+            snprintf(full_path, sizeof(full_path), "%s/%s", s_search_path, e->path);
+        } else {
+            snprintf(full_path, sizeof(full_path), "%s", e->path);
+        }
+        int fd = open(full_path, O_RDONLY);
+        if (fd < 0) {
+            fprintf(stderr, "[Melee-DVD] ERROR: Failed to open '%s'\n", full_path);
+            return -1;
+        }
+        ssize_t n = pread(fd, addr, (size_t)length, (off_t)offset);
+        close(fd);
+        if (n < 0) {
+            fprintf(stderr, "[Melee-DVD] ERROR: pread failed on '%s' (addr=%p off=%d len=%d): %s (errno=%d)\n",
+                    full_path, addr, offset, length, strerror(errno), errno);
+            return -1;
+        }
+        return (int32_t)n;
+    }
+}
+
+s32 DVDConvertPathToEntrynum(const char* path) {
+    if (!path || !path[0]) return -1;
+    const char* p = path;
+    while (*p == '/' || *p == '\\') p++;
+    char norm[256];
+    size_t len = 0;
+    while (*p && len < sizeof(norm) - 1) {
+        norm[len++] = (*p == '\\') ? '/' : *p;
+        p++;
+    }
+    norm[len] = '\0';
+
+    /* 1. Direct match */
+    for (int i = 0; i < s_num_iso_entries; i++) {
+        if (strcasecmp(s_iso_entries[i].path, norm) == 0) {
+            return i;
+        }
+    }
+
+    /* 2. Strip "files/" prefix if present */
+    const char* stripped = norm;
+    if (strncasecmp(stripped, "files/", 6) == 0) {
+        stripped += 6;
+        for (int i = 0; i < s_num_iso_entries; i++) {
+            if (strcasecmp(s_iso_entries[i].path, stripped) == 0) {
+                return i;
+            }
+        }
+    }
+
+    /* 3. Prepend "audio/" or "audio/us/" if missing */
+    if (strncasecmp(stripped, "audio/", 6) != 0) {
+        char alt[256];
+        snprintf(alt, sizeof(alt), "audio/%s", stripped);
+        for (int i = 0; i < s_num_iso_entries; i++) {
+            if (strcasecmp(s_iso_entries[i].path, alt) == 0) {
+                return i;
+            }
+        }
+        snprintf(alt, sizeof(alt), "audio/us/%s", stripped);
+        for (int i = 0; i < s_num_iso_entries; i++) {
+            if (strcasecmp(s_iso_entries[i].path, alt) == 0) {
+                return i;
+            }
+        }
+    }
+
+    /* 4. Match basename */
+    const char* base = strrchr(norm, '/');
+    base = base ? (base + 1) : norm;
+    for (int i = 0; i < s_num_iso_entries; i++) {
+        const char* ebase = strrchr(s_iso_entries[i].path, '/');
+        ebase = ebase ? (ebase + 1) : s_iso_entries[i].path;
+        if (strcasecmp(ebase, base) == 0) {
+            return i;
+        }
+    }
+
+    return -1;
+}
+
+BOOL DVDFastOpen(s32 entrynum, DVDFileInfo* fileInfo) {
+    if (entrynum < 0 || entrynum >= s_num_iso_entries || !fileInfo) return FALSE;
+    memset(fileInfo, 0, sizeof(DVDFileInfo));
+    fileInfo->startAddr = (u32)entrynum;
+    fileInfo->length = s_iso_entries[entrynum].size;
+    fileInfo->cb.userData = (void*)(intptr_t)entrynum;
+    return TRUE;
+}
+
+BOOL DVDOpen(const char* fileName, DVDFileInfo* fileInfo) {
+    if (!fileName || !fileInfo) return FALSE;
+    s32 entrynum = DVDConvertPathToEntrynum(fileName);
+    if (entrynum >= 0) {
+        return DVDFastOpen(entrynum, fileInfo);
+    }
+    fprintf(stderr, "[Melee-DVD] Warning: File not found '%s'\n", fileName);
+    return FALSE;
+}
+
+BOOL DVDClose(DVDFileInfo* fileInfo) {
+    (void)fileInfo;
+    return TRUE;
+}
+
+s32 DVDGetLength(const DVDFileInfo* fileInfo) {
+    return fileInfo ? (s32)fileInfo->length : 0;
+}
+
+s32 DVDReadPrio(DVDFileInfo* fileInfo, void* addr, s32 length, s32 offset, s32 prio) {
+    (void)prio;
+    if (!fileInfo || !addr) return -1;
+    s32 entrynum = (s32)fileInfo->startAddr;
+    return Port_DVD_ReadEntry(entrynum, addr, length, offset);
+}
+
+typedef struct DVDJob {
+    s32          entrynum;
+    void*        addr;
+    s32          length;
+    s32          offset;
+    s32          prio;
+    DVDCallback  cb;
+    DVDFileInfo* fileInfo;
+} DVDJob;
+
+#define MAX_DVD_QUEUE 64
+static DVDJob s_dvd_queue[MAX_DVD_QUEUE];
+static int s_dvd_head = 0;
+static int s_dvd_tail = 0;
+static pthread_mutex_t s_dvd_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  s_dvd_cond  = PTHREAD_COND_INITIALIZER;
+static pthread_t       s_dvd_thread;
+static volatile int    s_dvd_running = 0;
+
+static void* dvd_worker_thread(void* arg) {
+    (void)arg;
+    Port_PinThreadToCore(3);
+    while (s_dvd_running) {
+        pthread_mutex_lock(&s_dvd_mutex);
+        while (s_dvd_head == s_dvd_tail && s_dvd_running) {
+            pthread_cond_wait(&s_dvd_cond, &s_dvd_mutex);
+        }
+        if (!s_dvd_running) {
+            pthread_mutex_unlock(&s_dvd_mutex);
+            break;
+        }
+        DVDJob job = s_dvd_queue[s_dvd_head];
+        s_dvd_head = (s_dvd_head + 1) % MAX_DVD_QUEUE;
+        pthread_mutex_unlock(&s_dvd_mutex);
+
+        s32 res = Port_DVD_ReadEntry(job.entrynum, job.addr, job.length, job.offset);
+        if (job.cb) {
+            job.cb(res, job.fileInfo);
+        }
+    }
+    return NULL;
+}
+
+BOOL DVDReadAsyncPrio(DVDFileInfo* fileInfo, void* addr, s32 length, s32 offset, DVDCallback cb, s32 prio) {
+    if (!fileInfo || !addr) return FALSE;
+    if (!s_dvd_running) {
+        s_dvd_running = 1;
+        pthread_create(&s_dvd_thread, NULL, dvd_worker_thread, NULL);
+    }
+    pthread_mutex_lock(&s_dvd_mutex);
+    int next_tail = (s_dvd_tail + 1) % MAX_DVD_QUEUE;
+    if (next_tail != s_dvd_head) {
+        DVDJob* job = &s_dvd_queue[s_dvd_tail];
+        job->entrynum = (s32)fileInfo->startAddr;
+        job->fileInfo = fileInfo;
+        job->addr = addr;
+        job->length = length;
+        job->offset = offset;
+        job->prio = prio;
+        job->cb = cb;
+        s_dvd_tail = next_tail;
+        pthread_cond_signal(&s_dvd_cond);
+    }
+    pthread_mutex_unlock(&s_dvd_mutex);
+    return TRUE;
+}
+
+static const DVDDiskID s_default_disk_id = {
+    {'G', 'A', 'L', 'E'},
+    {'0', '1'},
+    0, 2, 0, 0, {0}
+};
+
+DVDDiskID* DVDGetCurrentDiskID(void) {
+    return (DVDDiskID*)&s_default_disk_id;
+}
+
+BOOL DVDCheckDisk(void) {
+    return TRUE;
+}
+
+s32 DVDGetDriveStatus(void) {
+    return 0; /* DVD_STATE_READY */
+}
