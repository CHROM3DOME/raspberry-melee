+void AXSetVoiceAddr(AXVPB* p, AXPBADDR* addr) {
+    if (!p || !addr) return;
+    pthread_mutex_lock(&s_audio_mutex);
+
+    uint16_t loopFlag = __builtin_bswap16(addr->loopFlag);
+    uint16_t format = __builtin_bswap16(addr->format);
+    uint32_t loopAddr = __builtin_bswap32(*(const uint32_t*)&addr->loopAddressHi);
+    uint32_t endAddr = __builtin_bswap32(*(const uint32_t*)&addr->endAddressHi);
+    uint32_t currAddr = __builtin_bswap32(*(const uint32_t*)&addr->currentAddressHi);
+
+    p->pb.addr.loopFlag = loopFlag;
+    p->pb.addr.format = format;
+    p->pb.addr.loopAddressHi = (u16)(loopAddr >> 16);
+    p->pb.addr.loopAddressLo = (u16)(loopAddr & 0xFFFF);
+    p->pb.addr.endAddressHi = (u16)(endAddr >> 16);
+    p->pb.addr.endAddressLo = (u16)(endAddr & 0xFFFF);
+    p->pb.addr.currentAddressHi = (u16)(currAddr >> 16);
+    p->pb.addr.currentAddressLo = (u16)(currAddr & 0xFFFF);
+
+    if (p->index < AX_MAX_VOICES) {
+        PortVoice* v = &s_port_voices[p->index];
+        v->loop = (loopFlag != 0);
+        v->format = format;
+        v->loop_nibble = loopAddr;
+        v->end_nibble = endAddr;
+        v->curr_nibble = currAddr;
+    }
+
+    pthread_mutex_unlock(&s_audio_mutex);
+}
